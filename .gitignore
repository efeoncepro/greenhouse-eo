# next.js
# Glob, no una lista de variantes: cada agente/sesión que levanta su propio dev server
# elige un distDir distinto (`.next-task1741`, etc.), y con una lista había que acordarse
# de agregarlo ACÁ y en eslint.config.mjs. Cuando alguien olvidaba el segundo, ESLint
# analizaba build output y tiraba miles de errores en un archivo que nadie escribió.
/.next/
/.next-*/
/.next-build-dir
/.next-build-meta.json
/out/

# production
/build

# misc
.DS_Store
*.pem
service-account*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env
.env.staging-check
.env*.tmp
.env.vercel-*

# claude code local state (settings, lock files)
.claude/settings.json
.claude/scheduled_tasks.lock

# vercel — ignore everything except project.json (canonical scope/project pin)
# `.vercel/project.json` checked-in pins Vercel CLI to canonical project
# `prj_d9v6gihlDq4k1EXazPvzWhSU0qbl` in scope `efeonce-7670142f`.
# Prevents duplicate-project bug class (ISSUE-013 + ISSUE-076).
.vercel/*
!.vercel/project.json
.tmp/

# typescript
*.tsbuildinfo
next-env.d.ts

# local reference-only trees that should stay out of app/runtime tooling
demo-configs/

# icon generated file
src/assets/iconify-icons/generated-icons.js
src/assets/iconify-icons/generated-icons.css

# local agent and task scratch space
.codex/skills/greenhouse-agent/
.codex/skills/greenhouse-portal-ui-implementer/
.codex/skills/greenhouse-vuexy-ui-expert/
/CODEX_TASK_*.md
!docs/tasks/**/CODEX_TASK*.md
# Local generated video projects / HyperFrames pilots. Persist approved outputs
# via canonical asset storage, not git.
/videos/

# AI generation binary outputs are local/workspace artifacts, not source.
# Keep manifests, prompts, scripts and docs in git; publish approved web assets
# to the runtime/CDN or external artifact storage.
/ai-generations/**/*.png
/ai-generations/**/*.jpg
/ai-generations/**/*.jpeg
/ai-generations/**/*.webp
/ai-generations/**/*.gif
/ai-generations/**/*.mp4
/ai-generations/**/*.webm
/ai-generations/**/*.mov
/ai-generations/**/*.m4v
# Legacy AI skill artifacts (not the src/lib/ai/ module which is tracked)


# Python bytecode caches (Cloud Run services with Python)
**/__pycache__/
*.pyc
*.pyo

# Local PDF render scratch (test artifacts, not committed)
/tmp/

# RpA V2 PoC sandbox snapshots (gitignored — never commit demo state)
.poc-snapshots/

# Python virtualenvs (local scratch projects, e.g. videos/) — never commit
.venv/
venv/
**/.venv/
**/venv/

# TASK-1136 — ephemeral embedding/eval artifacts (offline shadow prototype, NOT runtime)
scripts/knowledge/.cache/
.captures/knowledge-eval/

