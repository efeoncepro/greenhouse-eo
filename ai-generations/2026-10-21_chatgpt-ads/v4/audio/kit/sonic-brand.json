  "motif": {
    "name": "Tres puntos que se vuelven uno",
    "key": "La mayor (la tonalidad del motion V1.1)",
    "notes": [
      "E5",
      "E5",
      "E5",
      "A5"
    ],
    "noteNames": "Mi · Mi · Mi → La",
    "midi": [
      76,
      76,
      76,
      81
    ],
    "dotSpacingMs": 140,
    "pauseMs": 370,
    "resolution": "La con el único golpe de la pieza (impacto grave + campana); el acorde de La mayor florece debajo."
  },
  "grammar": [
    {
      "element": "Anillo",
      "means": "la pregunta",
      "sound": "Un acorde abierto de quinta (La–Mi), tenue y sin resolver."
    },
    {
      "element": "Tres ventanas",
      "means": "lo que se piensa",
      "sound": "Tres notas breves en Mi, a 140 ms una de otra, sin golpe."
    },
    {
      "element": "Esfera",
      "means": "la respuesta",
      "sound": "La, 370 ms después, con el único golpe de la pieza."
    },
    {
      "element": "Halo",
      "means": "la luz",
      "sound": "El acorde de La florece y se apaga con una cola corta; nunca un colchón de reverberación."
    }
  ],
  "registers": [
    {
      "key": "fondo",
      "name": "Fondo",
      "bpm": 96,
      "character": "Sereno y minimalista: mazos, campana y colchón.",
      "harmony": "La · Re/La · Fa♯m7 · Mi sus4 — la esfera responde siempre La mientras la armonía cambia: el contexto cambia, la respuesta no.",
      "uses": "Debajo de una locución, webinars, videos explicativos, cierres y aperturas del logo.",
      "origin": "Síntesis propia, determinística, sin muestras ni modelos de terceros."
    },
    {
      "key": "energia",
      "name": "Energía",
      "bpm": 120,
      "character": "Rock: tres golpes apagados de guitarra en Mi y el acorde abierto con bombo, platillo y bajo.",
      "harmony": "La misma armonía; a 120 BPM la pausa son tres semicorcheas (375 ms), la del logo.",
      "uses": "Lanzamientos, piezas de redes con ritmo, arranque de eventos.",
      "origin": "Maqueta propia re-grabada con Stable Audio 2.5 (audio-to-audio, intensidad 0,7) y la esfera propia montada encima."
    }
