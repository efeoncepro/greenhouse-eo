  "voice": {
    "name": "Brian",
    "voiceId": "nPczCjzI2devNBz1zQrb",
    "voiceLabel": "Brian – Deep, Resonant and Comforting (voz de fábrica)",
    "engine": "ElevenLabs v3",
    "text": "Empower your <Línea>.",
    "language": "Inglés, nunca traducido (igual que el eslogan visual).",
    "timing": "La palabra final del eslogan cae con la esfera, como el acento cierra en la gráfica.",
    "pacing": "Pausa «Empower» → «your» igualada a 0,14 s en las cinco líneas, recortando sólo el silencio."
  },
  "usage": [
    {
      "context": "Cierre de un video de marca",
      "piece": "Reveal; con Brian si el video no cierra con locución",
      "register": "fondo",
      "loudness": "−14 LUFS",
      "assets": [
        "motion-reveal-16x9",
        "motion-reveal-brian-16x9"
      ]
    },
    {
      "context": "Inicio de un video o presentación",
      "piece": "Apertura",
      "register": "fondo",
      "loudness": "−14 LUFS",
      "assets": [
        "motion-apertura-16x9"
      ]
    },
    {
      "context": "Reels, cortinillas, cierres de menos de 2 s",
      "piece": "Sting",
      "register": "fondo",
      "loudness": "−14 LUFS",
      "assets": [
        "motion-sting-9x16"
      ]
    },
    {
      "context": "Video con locución, webinar, explicativo",
      "piece": "Pieza larga de fondo, unos 15 dB debajo de la voz",
      "register": "fondo",
      "loudness": "−14 LUFS",
      "assets": [
        "long-fondo"
      ]
    },
    {
      "context": "Lanzamiento, redes con ritmo, arranque de evento",
      "piece": "Pieza larga de energía o cierre de energía",
      "register": "energia",
      "loudness": "−14 LUFS",
      "assets": [
        "long-energia",
        "close-energia"
      ]
    },
    {
      "context": "Pieza de una línea de servicio",
      "piece": "Logo sonoro o etiqueta con el timbre de esa línea",
      "register": "según contexto",
      "loudness": "−14 LUFS",
      "assets": [
        "logo-growth",
        "tag-growth"
      ]
    },
    {
      "context": "Glitch (magazine y podcast)",
      "piece": "No usa este kit: Glitch tiene su diseño sonoro propio, sólo de Glitch (/references/glitch/#sonido)",
      "register": "propio de Glitch",
      "loudness": "—",
      "assets": []
    },
    {
      "context": "Pantalla de recepción",
      "piece": "Sin sonido, como define la línea gráfica",
      "register": "ninguno",
      "loudness": "—",
      "assets": []
    },
    {
      "context": "Piezas de clientes · interfaz de Greenhouse",
      "piece": "No se usa: es la marca Efeonce",
      "register": "ninguno",
      "loudness": "—",
      "assets": []
    }
  ],
  "rules": {
    "always": [
      "La melodía es Mi, Mi, Mi → La, con su pausa. No se cambia ni se acorta.",
      "La línea de servicio cambia sólo el timbre de la esfera.",
      "Un solo golpe por pieza: el de la esfera.",
      "El eslogan va en inglés, nunca traducido, y su palabra final cae con la esfera.",
      "Se nivela por destino: −14 LUFS en video y redes, −16 en podcast, pico en −1 dBFS.",
      "Se usan los archivos del kit (SHA-256 en el JSON), no versiones regeneradas."
    ],
    "never": [
      "Cambiar de registro dentro de una misma pieza.",
      "Poner el registro de energía debajo de una locución.",
      "Comprimir el golpe para que el archivo suene más fuerte.",
      "Usar el sistema en piezas de clientes o en la interfaz de Greenhouse.",
      "Sonorizar la pantalla de recepción.",
      "Otra voz para el eslogan que no sea la de Brian."
    ]
  },
  "spec": {
    "Formato": "WAV 48 kHz, 24 bits (masters) · MP3 224 kbps y MP4 H.264 (web)",
    "Volumen": "−14 LUFS video y redes · −16 LUFS podcast · pico −1 dBFS. Los logos Brand, Voice y Revenue quedan cerca de −15: el golpe toca el techo de pico y no se comprime.",
    "Motion": "Sting, reveal y apertura V1.1 sin tocar la imagen; la esfera sonora cae con el golpe de encaje (sting 0,58 s · reveal 1,87 s · apertura 1,15 s). Se extienden 1 s con el cuadro final para oír la cola.",
