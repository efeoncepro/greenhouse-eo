#!/usr/bin/env python3
"""Prototipo: Efeonce Insights extendido con el módulo Social care (informe live + A4). Cifras de ejemplo."""
import json
import math
import sys
from pathlib import Path

OUT = Path(sys.argv[1])

# Tokens copiados de efeonce-think/src/lib/insights-tokens.ts (orbita, dataRoles, variation)
GROUND, NAVY, PAPER, SURFACE = "#001a33", "#023c70", "#f7f8f6", "#ffffff"
SOFT_DARK, SOFT_LIGHT, HALO = "#cfe4fa", "#6d6777", "#72ded8"
ACC_DARK, ACC_LIGHT = "#36c8bf", "#0e8c82"
D_CUR, D_PREV, D_THIRD, D_GAP = "#023c70", "#1f9e94", "#8da7bf", "#e0745c"
INK = "#020061"
RULE_P = "#dfe4ec"
BETTER, NEUTRAL_BG = "#0d6b3f", "#e9edf3"
TILE = "#10253f"

P = "font-family: 'Poppins', system-ui, sans-serif"
B = "font-family: 'Bricolage Grotesque', system-ui, sans-serif"

LOCKUP_NEG = "/_blob/ea442590e8eb589de204ec7288963c31"
LOGO_NEG = "/_blob/503823171b96284f634ef670092872d3"
LOGO_POS = "/_blob/ad9b07614674548d6a8179314a25daca"
URL_LIGHT = "/_blob/cbdda01a58239fbcb86b97a7fe3a1e35"
SKY_ON_DARK = "/_blob/0a55139651dbb9d1b8fcf43fcd89f7a8"

PERIOD, PRIOR = "mayo 2027", "abril 2027"


def page(title, w, h, bg, body):
    return (
        '<!doctype html>\n<html lang="es">\n<head>\n<meta charset="utf-8">\n'
        f'<title>{title}</title>\n<script src="./support.js"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n'
        '<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800'
        '&amp;family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&amp;display=swap" rel="stylesheet">\n'
        f'<style>\nbody{{margin:0;background:{bg}}}\n</style>\n</helmet>\n'
        f'<div style="position: relative; width: {w}px; height: {h}px; overflow: hidden; background: {bg}">\n'
        f'{body}\n</div>\n</x-dc>\n'
        '<script type="text/x-dc" data-dc-script data-props=\'{"$preview":{"width":' + str(w) + ',"height":' + str(h) + '}}\'>\n'
        'class Component extends DCLogic { renderVals() { return {}; } }\n</script>\n</body>\n</html>\n'
    )


def tri(direction, color, size=9):
    d = "M4.5 0.5 L8.5 7.5 H0.5 Z" if direction == "up" else "M4.5 7.5 L8.5 0.5 H0.5 Z"
    return (f'<svg aria-hidden="true" viewBox="0 0 9 8" width="{size}" height="{size * 8 / 9:.1f}">'
            f'<path d="{d}" fill="{color}" stroke="{color}" stroke-width="1.4" stroke-linejoin="round"></path></svg>')


def pill(direction, text, tone, fs=13):
    if tone == "better":
        bg, fg = "rgba(13, 107, 63, 0.12)", BETTER
    else:
        bg, fg = NEUTRAL_BG, INK
    return (f'<span style="display: inline-flex; align-items: center; gap: 7px; padding: 5px 12px; border-radius: 999px; '
            f'background: {bg}; color: {fg}; {P}; font-size: {fs}px; font-weight: 600">{tri(direction, fg)}{text}</span>')


def fact_mark(kind, color, label_color, source, fs=13):
    dash = ' stroke-dasharray="2.2 2.2"' if kind in ("Estimado", "") else ""
    return (f'<span style="display: inline-flex; align-items: center; gap: 8px; {P}; font-size: {fs}px; color: {label_color}">'
            f'<svg aria-hidden="true" viewBox="0 0 12 12" width="11" height="11"><circle cx="6" cy="6" r="4.2" fill="none" stroke="{color}" stroke-width="2"{dash}></circle></svg>'
            f'<span style="font-weight: 600; color: {color}">{kind}</span><span>{source}</span></span>')


ICONS = {
    "chat": '<path d="M3 5.5h14v8.5H9l-3.5 3V14H3z"></path>',
    "clock": '<circle cx="10" cy="10" r="7"></circle><path d="M10 6v4.2l2.8 1.8"></path>',
    "target": '<circle cx="10" cy="10" r="7"></circle><circle cx="10" cy="10" r="3"></circle>',
    "check": '<circle cx="10" cy="10" r="7"></circle><path d="M6.8 10.2l2.2 2.2 4.2-4.6"></path>',
    "forward": '<path d="M3 10h13"></path><path d="M11.5 5.5L16 10l-4.5 4.5"></path>',
    "cursor": '<path d="M5 3.5l10 5-4.2 1.4L9.4 14z"></path><path d="M11.4 11.4l3.4 3.4"></path>',
    "smile": '<circle cx="10" cy="10" r="7"></circle><path d="M7 11.4c.8 1.3 1.8 1.9 3 1.9s2.2-.6 3-1.9"></path><path d="M7.7 8.1v.2M12.3 8.1v.2"></path>',
}


def icon(name, color, size=18):
    return (f'<svg aria-hidden="true" viewBox="0 0 20 20" width="{size}" height="{size}" fill="none" stroke="{color}" '
            f'stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0">{ICONS[name]}</svg>')


# Cifras de ejemplo, coherentes entre sí (1.284 conversaciones = 655 precio + 311 generales + 318 reclamos)
STATS = [
    ("chat", "Conversaciones", "1.284", "", ("up", "9,2 %", "neutral"), "1.176", False),
    ("clock", "Primera respuesta", "38", "min", ("down", "26,9 %", "better"), "52 min", True),
    ("target", "Dentro del tiempo", "93,4", "%", ("up", "3,3 pp", "better"), "90,1 %", False),
    ("smile", "Satisfacción · CSAT", "86", "%", ("up", "3 pp", "better"), "83 %", False),
    ("forward", "Traspasos tomados", "81", "%", ("up", "5 pp", "better"), "76 %", False),
    ("cursor", "Clics a tarifas", "2.140", "", ("up", "14,7 %", "better"), "1.865", False),
]


def stat_cell(s, big, name_fs, vs_fs, pad, border):
    ico, name, val, unit, (d, txt, tone), prior, lower = s
    unit_html = (f'<span style="font-size: {big * 0.36:.0f}px; font-weight: 600; margin-left: 6px">{unit}</span>' if unit else "")
    lower_html = (f'<div style="margin-top: 8px; {P}; font-size: {max(vs_fs - 3, 9)}px; font-weight: 600; letter-spacing: 0.12em; '
                  f'text-transform: uppercase; color: {SOFT_LIGHT}">↓ Menor es mejor</div>' if lower else "")
    return (
        f'<div style="padding: {pad}; {border}">'
        f'<div style="display: flex; align-items: center; gap: 10px; {P}; font-size: {name_fs}px; font-weight: 600; color: {INK}">{icon(ico, INK, name_fs + 3)}{name}</div>'
        f'<div style="margin-top: 6px; {P}; font-size: {big}px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; color: {NAVY}; font-variant-numeric: tabular-nums">{val}{unit_html}</div>'
        f'<div style="margin-top: 10px">{pill(d, txt, tone, max(vs_fs - 1, 11))}</div>'
        f'<div style="margin-top: 10px; {P}; font-size: {vs_fs}px; color: {INK}">vs <span style="font-weight: 600">{prior}</span> en {PRIOR}</div>'
        f'{lower_html}</div>'
    )


def stat_grid(big, name_fs, vs_fs, pad):
    cells = []
    for i, s in enumerate(STATS):
        b = []
        if i % 3 != 2:
            b.append(f"border-right: 1px solid {RULE_P}")
        if i < 3:
            b.append(f"border-bottom: 1px solid {RULE_P}")
        cells.append(stat_cell(s, big, name_fs, vs_fs, pad, "; ".join(b)))
    return '<div style="display: grid; grid-template-columns: 1fr 1fr 1fr">\n' + "\n".join(cells) + "\n</div>"


TARGETS = [
    ("target", "Dentro del tiempo", "porcentaje", "93,4 %", "meta 90 %", 93.4, 90.0, False),
    ("check", "Nota de calidad", "puntos sobre 100", "94", "meta 90", 94.0, 90.0, False),
    ("clock", "Alertas avisadas a tiempo", "porcentaje", "100 %", "meta 100 %", 100.0, 100.0, False),
    ("chat", "Cobertura de la base", "porcentaje", "91,8 %", "meta 95 %", 91.8, 95.0, True),
]


def bullet_rows(name_w, name_fs, sub_fs, track_h, row_pad):
    rows = []
    for ico, name, unit, got, meta, v, m, gap in TARGETS:
        ratio = v / m
        width = min(ratio * 90, 100)
        color = D_GAP if gap else D_CUR
        pct = f"{round(ratio * 100)} %"
        if gap:
            badge = (f'<span style="display: inline-flex; align-items: center; gap: 7px; padding: 5px 12px; border-radius: 999px; background: rgba(224, 116, 92, 0.16); '
                     f'color: {INK}; {P}; font-size: {sub_fs + 1}px; font-weight: 600">{tri("down", D_GAP)}{pct}</span>')
        elif ratio > 1:
            badge = (f'<span style="display: inline-flex; align-items: center; gap: 7px; padding: 5px 12px; border-radius: 999px; background: {NAVY}; '
                     f'color: #ffffff; {P}; font-size: {sub_fs + 1}px; font-weight: 600">{tri("up", ACC_DARK)}{pct}</span>')
        else:
            badge = (f'<span style="display: inline-flex; align-items: center; gap: 7px; padding: 5px 12px; border-radius: 999px; background: {NEUTRAL_BG}; '
                     f'color: {INK}; {P}; font-size: {sub_fs + 1}px; font-weight: 600">{pct}</span>')
        rows.append(
            f'<div style="display: flex; align-items: center; gap: 20px; padding: {row_pad}px 0; border-top: 1px solid {RULE_P}">'
            f'<div style="width: {name_w}px; flex-shrink: 0"><div style="display: flex; align-items: center; gap: 9px; {P}; font-size: {name_fs}px; font-weight: 600; color: {INK}">{icon(ico, INK, name_fs + 3)}{name}</div>'
            f'<div style="margin-top: 3px; margin-left: {name_fs + 12}px; {P}; font-size: {sub_fs}px; color: {NAVY}">{unit}</div></div>'
            f'<div style="flex: 1"><div style="position: relative; height: {track_h}px; border-radius: {track_h / 2}px; background: {NEUTRAL_BG}">'
            f'<div style="position: absolute; left: 0; top: 0; height: {track_h}px; width: {width:.1f}%; border-radius: {track_h / 2}px; background: {color}"></div>'
            f'<div style="position: absolute; left: 90%; top: -{track_h * 0.6:.0f}px; width: 2px; height: {track_h * 2.2:.0f}px; background: {INK}"></div></div>'
            f'<div style="margin-top: 8px; display: flex; justify-content: space-between; {P}; font-size: {sub_fs}px; color: {INK}"><span><span style="font-weight: 600">{got}</span> logrado</span><span style="margin-right: 4%">{meta}</span></div></div>'
            f'<div style="width: 86px; flex-shrink: 0; text-align: right">{badge}</div></div>')
    return "\n".join(rows)


def legend(items, fs=12):
    return ('<div style="display: flex; gap: 18px; flex-wrap: wrap">' + "".join(
        f'<span style="display: inline-flex; align-items: center; gap: 7px; {P}; font-size: {fs}px; color: {INK}">'
        f'<span style="width: 11px; height: 11px; border-radius: 3px; background: {c}"></span>{t}</span>' for c, t in items) + "</div>")


WEEKS = [("Semana 1", 120, 72, 76), ("Semana 2", 140, 76, 75), ("Semana 3", 235, 85, 82), ("Semana 4", 160, 78, 85)]
assert sum(w[1] for w in WEEKS) == 655 and sum(w[2] for w in WEEKS) == 311 and sum(w[3] for w in WEEKS) == 318


def stacked_svg(w, h):
    base, top, scale = h - 34, 26, (h - 34 - 26) / 420
    bar_w, gap = 78, (w - 60 - 4 * 78) / 3
    parts = [f'<line x1="40" y1="{base}" x2="{w}" y2="{base}" stroke="{RULE_P}" stroke-width="1"></line>']
    for tick in (100, 200, 300, 400):
        y = base - tick * scale
        parts.append(f'<line x1="40" y1="{y:.1f}" x2="{w}" y2="{y:.1f}" stroke="{RULE_P}" stroke-width="1" stroke-dasharray="2 4"></line>')
        parts.append(f'<text x="32" y="{y + 4:.1f}" text-anchor="end" font-family="Poppins, sans-serif" font-size="11" fill="{SOFT_LIGHT}">{tick}</text>')
    for i, (label, a, b, c) in enumerate(WEEKS):
        x = 60 + i * (bar_w + gap)
        y = base
        for value, color in ((a, D_CUR), (b, D_PREV), (c, D_THIRD)):
            hh = value * scale
            y -= hh
            parts.append(f'<rect x="{x:.1f}" y="{y:.1f}" width="{bar_w}" height="{hh - 2:.1f}" rx="4" fill="{color}"></rect>')
        parts.append(f'<text x="{x + bar_w / 2:.1f}" y="{y - 8:.1f}" text-anchor="middle" font-family="Poppins, sans-serif" font-size="14" font-weight="700" fill="{NAVY}">{a + b + c}</text>')
        parts.append(f'<text x="{x + bar_w / 2:.1f}" y="{base + 22}" text-anchor="middle" font-family="Poppins, sans-serif" font-size="12" fill="{INK}">{label}</text>')
    return f'<svg viewBox="0 0 {w} {h}" width="{w}" height="{h}" role="img" aria-label="Conversaciones por semana y tipo">{"".join(parts)}</svg>'


def donut_svg(size):
    r, cx = size * 0.36, size / 2
    circ = 2 * math.pi * r
    parts, offset = [], 0.0
    for value, color in ((258, D_CUR), (37, D_PREV), (23, D_THIRD)):
        length = value / 318 * circ
        parts.append(f'<circle cx="{cx}" cy="{cx}" r="{r:.1f}" fill="none" stroke="{color}" stroke-width="{size * 0.1:.1f}" '
                     f'stroke-dasharray="{length - 3:.1f} {circ - length + 3:.1f}" stroke-dashoffset="{-offset:.1f}" transform="rotate(-90 {cx} {cx})"></circle>')
        offset += length
    parts.append(f'<text x="{cx}" y="{cx + 4}" text-anchor="middle" font-family="Poppins, sans-serif" font-size="{size * 0.17:.0f}" font-weight="700" fill="{NAVY}">318</text>')
    parts.append(f'<text x="{cx}" y="{cx + size * 0.1:.0f}" text-anchor="middle" font-family="Poppins, sans-serif" font-size="{size * 0.048:.0f}" fill="{SOFT_LIGHT}">reclamos derivados</text>')
    return f'<svg viewBox="0 0 {size} {size}" width="{size}" height="{size}" role="img" aria-label="Reclamos derivados por estado">{"".join(parts)}</svg>'


RANK = [
    ("Promoción de mayo: qué fechas de vuelo aplican", 269),
    ("Santiago–Lima: precio final con tasas", 96),
    ("Qué equipaje incluye la tarifa", 88),
    ("Medios de pago y cuotas", 61),
    ("Santiago–Buenos Aires: disponibilidad", 54),
    ("Otros temas", 87),
]
assert sum(v for _, v in RANK) == 655


def rank_rows(fs, bar_h, pad, name_w):
    rows = []
    for i, (name, v) in enumerate(RANK):
        color = D_CUR if i == 0 else (D_THIRD if name == "Otros temas" else D_PREV)
        rows.append(
            f'<div style="display: flex; align-items: center; gap: 16px; padding: {pad}px 0; border-top: 1px solid {RULE_P}">'
            f'<div style="width: 22px; {P}; font-size: {fs - 2}px; font-weight: 600; color: {SOFT_LIGHT}">{i + 1:02d}</div>'
            f'<div style="width: {name_w}px; flex-shrink: 0; {P}; font-size: {fs}px; font-weight: 500; line-height: 1.3; color: {INK}">{name}</div>'
            f'<div style="flex: 1; height: {bar_h}px; border-radius: {bar_h / 2}px; background: {NEUTRAL_BG}"><div style="height: {bar_h}px; width: {v / 269 * 100:.1f}%; border-radius: {bar_h / 2}px; background: {color}"></div></div>'
            f'<div style="width: 78px; text-align: right; {P}; font-size: {fs + 2}px; font-weight: 700; color: {NAVY}; font-variant-numeric: tabular-nums">{v}<span style="font-size: {fs - 3}px; font-weight: 500; color: {SOFT_LIGHT}"> · {round(v / 655 * 100)} %</span></div></div>')
    return "\n".join(rows)


def chip_dark(text, selected=False, new=False):
    if selected:
        st = "background: #ffffff; color: #001a33; border: 1px solid #ffffff"
    else:
        st = f"color: {SOFT_DARK}; border: 1px solid rgba(207, 228, 250, 0.22)"
    tag = (f'<span style="margin-left: 8px; padding: 2px 8px; border-radius: 999px; background: {ACC_LIGHT}; color: #ffffff; font-size: 10px; '
           f'font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase">Nuevo</span>' if new else "")
    return f'<span style="display: inline-flex; align-items: center; padding: 8px 16px; border-radius: 999px; {P}; font-size: 14px; font-weight: 500; {st}">{text}{tag}</span>'


