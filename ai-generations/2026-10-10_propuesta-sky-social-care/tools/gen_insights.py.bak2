ang_end, ang_start = math.radians(336), math.radians(286)
sx, sy = cx + r * math.sin(ang_start), cy - r * math.cos(ang_start)
ex, ey = cx + r * math.sin(ang_end), cy - r * math.cos(ang_end)
orbit = (
    f'<svg aria-hidden="true" viewBox="0 0 1440 960" width="1440" height="960" style="position: absolute; left: 0; top: 0">'
    f'<circle cx="{cx}" cy="{cy}" r="{r}" fill="none" stroke="{HALO}" stroke-opacity="0.2" stroke-width="1.6"></circle>'
    f'<line x1="{cx}" y1="{cy - r - 7}" x2="{cx}" y2="{cy - r + 7}" stroke="{HALO}" stroke-opacity="0.6" stroke-width="1.6"></line>'
    f'<path d="M{sx:.1f} {sy:.1f} A{r} {r} 0 0 1 {ex:.1f} {ey:.1f}" fill="none" stroke="{ACC_DARK}" stroke-width="4" stroke-linecap="round"></path>'
    f'<circle cx="{ex:.1f}" cy="{ey:.1f}" r="10" fill="{ACC_DARK}"></circle></svg>')
hero = (
    f'<div style="position: absolute; left: 0; top: 0; width: 1440px; height: 960px; background: radial-gradient(circle 560px at 1150px 470px, rgba(54, 200, 191, 0.2), rgba(0, 26, 51, 0) 70%)"></div>\n{orbit}\n'
    f'<img src="{LOCKUP_NEG}" alt="Efeonce Insights" style="position: absolute; left: 80px; top: 32px; height: 32px; width: auto">\n'
    f'<div style="position: absolute; right: 80px; top: 30px; display: flex; gap: 10px">'
    f'<span style="display: inline-flex; align-items: center; gap: 9px; padding: 8px 16px; border-radius: 999px; border: 1px solid rgba(207, 228, 250, 0.22); {P}; font-size: 14px; color: {SOFT_DARK}">'
    f'<span style="width: 8px; height: 8px; border-radius: 50%; background: {ACC_DARK}"></span>{PROTO}</span></div>\n'
    f'<div style="position: absolute; left: {cx - 240}px; top: {cy - 118}px; width: 480px; text-align: center">'
    f'<div style="{B}; font-size: 136px; font-weight: 760; letter-spacing: -0.05em; line-height: 1; color: #ffffff">93,4<span style="font-size: 62px; margin-left: 8px">%</span></div>'
    f'<div style="margin-top: 8px; {P}; font-size: 19px; font-weight: 500; color: #ffffff">de las conversaciones, a tiempo</div>'
    f'<div style="margin-top: 12px; display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 999px; border: 1px solid rgba(40, 199, 111, 0.6); {P}; font-size: 14px; font-weight: 600; color: #d0f3ff">'
    f'<svg viewBox="0 0 9 8" width="10" height="9"><path d="M4.5 0.5 L8.5 7.5 H0.5 Z" fill="#28c76f" stroke="#28c76f" stroke-width="1.4" stroke-linejoin="round"></path></svg>3,3 pp sobre abril · objetivo 90 %</div></div>\n'
    f'<div style="position: absolute; left: 80px; top: 208px; width: 690px; display: flex; flex-direction: column">'
    f'<div style="{P}; font-size: 14px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: {SOFT_DARK}">Atención en comentarios&nbsp;&nbsp;·&nbsp;&nbsp;1 al 31 de mayo de 2027</div>'
    f'<div style="margin-top: 22px; {B}; font-size: 62px; letter-spacing: -0.04em; line-height: 1.02; color: #ffffff"><span style="font-weight: 740">Nueve de cada diez respuestas llegaron a tiempo.</span> '
    f'<span style="font-weight: 340; color: {SOFT_DARK}">La fricción está en una promoción.</span></div>'
