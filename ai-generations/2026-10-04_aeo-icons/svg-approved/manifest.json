{
  "schema": "axis.aeo-iconography-export.v1",
  "status": "canonical",
  "catalog": [
    {
      "key": "respuesta-ia",
      "label": "Respuesta de IA",
      "meaning": "Respuesta entregada por el motor.",
      "avoid": "No representa el campo donde se escribe el prompt.",
      "group": "Presencia y evidencia",
      "origin": "new",
      "status": "canonical",
      "voice": "stroke"
    },
    {
      "key": "mencion-marca",
      "label": "Mención de marca",
      "meaning": "La marca aparece nombrada en la respuesta.",
      "avoid": "Una mención no acredita una cita, un enlace ni una recomendación.",
      "group": "Presencia y evidencia",
      "origin": "new",
      "status": "canonical",
      "voice": "stroke"
    },
    {
      "key": "fuente",
      "label": "Fuente",
      "meaning": "Página o documento que respalda información.",
      "avoid": "No implica que el motor haya citado la fuente.",
      "group": "Presencia y evidencia",
      "origin": "new",
      "status": "canonical",
      "voice": "stroke"
    },
    {
      "key": "entidad",
      "label": "Entidad",
      "meaning": "Marca, persona o producto con identidad y relaciones.",
      "avoid": "No representa una red social ni un modelo de IA.",
      "group": "Presencia y evidencia",
      "origin": "new",
      "status": "canonical",
      "voice": "stroke"
    },
    {
      "key": "atribucion",
      "label": "Atribución",
      "meaning": "A quién se reconoce como autor de una idea o información.",
      "avoid": "Aparecer mencionado no demuestra que la autoría se atribuya correctamente.",
      "group": "Presencia y evidencia",
      "origin": "new",
      "status": "canonical",
      "voice": "stroke"
    },
    {
      "key": "recomendacion-ia",
      "label": "Recomendación",
      "meaning": "Una opción elegida o recomendada dentro de la respuesta.",
      "avoid": "No confundir con una mención neutral ni con una garantía de resultado.",
      "group": "Presencia y evidencia",
      "origin": "new",
      "status": "canonical",
      "voice": "stroke"
    },
    {
      "key": "consultas-relacionadas",
      "label": "Consultas relacionadas",
      "meaning": "Una consulta se ramifica en búsquedas relacionadas.",
      "avoid": "La ramificación documentada por Google no describe a todos los motores.",
      "group": "Investigación y cobertura",
      "origin": "new",
      "status": "canonical",
      "voice": "stroke"
    },
    {
      "key": "recuperacion",
      "label": "Recuperación de información",
      "meaning": "Se localiza un pasaje relevante en una fuente.",
      "avoid": "Recuperar información no demuestra que se cite o se recomiende.",
      "group": "Investigación y cobertura",
      "origin": "new",
      "status": "canonical",
      "voice": "stroke"
    },
    {
      "key": "cobertura-preguntas",
      "label": "Cobertura de preguntas",
      "meaning": "Presencia observada dentro de un conjunto definido de preguntas.",
      "avoid": "La figura no codifica un porcentaje: se acompaña del dato y su denominador.",
      "group": "Investigación y cobertura",
      "origin": "new",
      "status": "canonical",
      "voice": "stroke"
    },
    {
      "key": "cobertura-motores",
      "label": "Cobertura de motores",
      "meaning": "Presencia observada en motores o superficies identificados.",
      "avoid": "No suma ni promedia métricas de motores distintos; no sustituye sus isotipos.",
      "group": "Investigación y cobertura",
      "origin": "new",
      "status": "canonical",
      "voice": "stroke"
    },
    {
      "key": "composer",
      "label": "Prompt",
      "meaning": "Consulta escrita en el composer.",
      "avoid": "No es la respuesta del motor.",
      "group": "Herramientas compartidas",
      "origin": "existing",
      "status": "canonical",
      "voice": "stroke"
    },
    {
      "key": "buscador",
      "label": "Búsqueda",
      "meaning": "Búsqueda de información.",
      "avoid": "No representa una plataforma concreta.",
      "group": "Herramientas compartidas",
      "origin": "existing",
      "status": "canonical",
      "voice": "stroke"
    },
    {
      "key": "cita",
      "label": "Cita",
      "meaning": "Referencia a una fuente dentro de la respuesta.",
      "avoid": "Una mención de marca sin referencia no es una cita.",
      "group": "Herramientas compartidas",
      "origin": "existing",
      "status": "canonical",
      "voice": "stroke"
    },
    {
      "key": "contenido",
      "label": "Contenido",
      "meaning": "Producción y optimización de contenido.",
      "avoid": "No garantiza citación.",
      "group": "Herramientas compartidas",
      "origin": "existing",
      "status": "canonical",
      "voice": "stroke"
    },
    {
      "key": "enlace",
      "label": "Enlace",
      "meaning": "Enlaces y referencias.",
      "avoid": "Un enlace no es necesariamente una cita de IA.",
      "group": "Herramientas compartidas",
      "origin": "existing",
      "status": "canonical",
      "voice": "stroke"
    },
    {
      "key": "competencia",
      "label": "Competencia",
      "meaning": "Comparación entre marcas.",
      "avoid": "La comparación necesita un conjunto y una metodología declarados.",
      "group": "Herramientas compartidas",
      "origin": "existing",
      "status": "canonical",
      "voice": "stroke"
    },
    {
      "key": "medicion",
      "label": "Medición",
      "meaning": "Medición y evolución.",
      "avoid": "Ausencia de observaciones no equivale a cero.",
      "group": "Herramientas compartidas",
      "origin": "existing",
      "status": "canonical",
      "voice": "stroke"
    },
    {
      "key": "informe",
      "label": "Informe",
      "meaning": "Diagnóstico y reporte.",
      "avoid": "Un snapshot no es un dato actual.",
      "group": "Herramientas compartidas",
      "origin": "existing",
      "status": "canonical",
      "voice": "stroke"
    }
  ],
