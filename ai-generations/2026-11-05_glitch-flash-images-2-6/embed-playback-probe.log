  await iframe.scrollIntoViewIfNeeded();
  const frame=page.frames().find(f=>f.url().includes('player.vimeo.com/video/'+id));
  await frame.getByRole('button',{name:'Reproducir',exact:true}).first().click();
  await frame.waitForFunction(()=>{const v=document.querySelector('video');return v&&!v.paused&&v.currentTime>1&&v.readyState>=3},{timeout:15000});
  result.push({id,...await frame.locator('video').evaluate(v=>({currentTime:v.currentTime,paused:v.paused,readyState:v.readyState,error:v.error?.message||null,videoWidth:v.videoWidth,videoHeight:v.videoHeight}))});
  await page.screenshot({path:'output/playwright/glitch-images26-review/embedded-playing-'+id+'-1440.png'});
  await frame.locator('video').evaluate(v=>v.pause());
 }
 return result;
})(page);
