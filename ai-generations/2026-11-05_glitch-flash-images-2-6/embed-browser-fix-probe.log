await (async (page) => {
 await page.locator('.entry-content iframe[src*="player.vimeo.com"]').evaluateAll(frames=>frames.forEach(f=>{f.style.aspectRatio=f.width+'/'+f.height;f.style.width='100%';f.style.height='auto'}));
 const metrics=[];
 for(const width of [390,1440]){
  await page.setViewportSize({width,height:900});
  metrics.push(await page.evaluate(()=>({width:innerWidth,scrollWidth:document.documentElement.scrollWidth,embeds:[...document.querySelectorAll('.entry-content iframe[src*="player.vimeo.com"]')].map(f=>{const r=f.getBoundingClientRect();return{w:r.width,h:r.height,ratio:r.width/r.height}})})));
 }
 return metrics;
})(page);
