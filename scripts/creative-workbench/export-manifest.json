      "docs/operations/EFEONCE_ADVERTISING_CTA_COMPOSITOR_V1.md",
      "docs/operations/EFEONCE_ADVERTISING_THREE_VOICES_ACTION_V1.md",
      "docs/operations/GREENHOUSE_MULTIMODAL_CAMPAIGN_PRODUCTION_V1.md",
      "docs/operations/GREENHOUSE_AI_IMAGE_GENERATION_AGENT_SKILL_V1.md",
