{
  "_comentario": "Reglas que el harness NATIVO del workbench debe cumplir. Las decide greenhouse-eo (scripts/creative-workbench/template/gates/) y llegan selladas: el workbench implementa como quiera, pero no puede dejar de cumplir esto. El gate native-policy es un lint de comportamiento, no una frontera de seguridad: la barrera real sigue siendo IAM (el equipo no tiene llaves) y la revisión de PRs. {rand} se reemplaza por un valor aleatorio en cada corrida.",
  "guard": {
    "path": ".claude/hooks/guard.mjs",
    "mustBlockBash": [
      "gcloud secrets versions access latest --secret=workbench-{rand}",
      "gcloud storage rm gs://efeonce-creative-work/{rand}.png",
      "gsutil rm gs://efeonce-creative-canon/{rand}.png",
      "git push --force",
      "git push origin main",
      "git push origin pieza/{rand}:main",
      "cat .env.local",
      "curl https://api.openai.com/v1/images/{rand}",
      "git commit --no-verify -m {rand}"
    ],
    "mustAllowBash": ["git status", "git push -u origin pieza/{rand}-main-banner"],
    "mustBlockEdit": [".workbench/sync.lock.json", "@managed", "@managed"],
    "mustAllowEdit": ["projects/_sonda-{rand}/brief.md"]
  },
  "settings": {
    "path": ".claude/settings.json",
    "requiredDeny": [
      "Read(./.env.local)",
      "Bash(gcloud secrets:*)",
      "Bash(git push --force:*)",
      "Edit(./.workbench/**)",
      "Edit(./gates/**)"
    ],
    "hookMatcherTools": ["Bash", "Edit", "Write"],
    "hookCommand": "^node \"?\\$CLAUDE_PROJECT_DIR/\\.claude/hooks/guard\\.mjs\"?$"
  },
  "providers": {
    "_comentario": "Ningún código ni configuración del workbench llama a un proveedor de IA salvo el broker. Se omiten los engines gestionados y gates/ (son de greenhouse-eo), docs/ y los tests que viven en una carpeta test/.",
    "hosts": [
      "api.openai.com",
      "fal.run",
      "api.fal.ai",
      "higgsfield.ai",
      "generativelanguage.googleapis.com",
      "aiplatform.googleapis.com",
      "api.anthropic.com",
      "openrouter.ai",
      "api.replicate.com"
    ],
    "sdkPackages": [
      "openai",
      "@anthropic-ai/sdk",
      "@fal-ai/client",
      "@fal-ai/serverless-client",
      "@google/genai",
      "@google/generative-ai",
      "@google-cloud/vertexai",
      "@google-cloud/aiplatform",
      "replicate"
    ],
    "allowedIn": ["services/production-broker/**"],
    "skipIn": ["docs/**", "gates/**"],
    "extensions": [".mjs", ".js", ".cjs", ".ts", ".tsx", ".mts", ".cts", ".sh", ".py", ".json", ".yml", ".yaml"]
  }
}
