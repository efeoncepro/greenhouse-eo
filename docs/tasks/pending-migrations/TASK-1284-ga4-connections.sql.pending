-- Up Migration

SET search_path = greenhouse_growth, greenhouse_core, public;

CREATE TABLE greenhouse_growth.ga4_connections (
  connection_id TEXT PRIMARY KEY DEFAULT ('ga4-conn-' || gen_random_uuid()::text),
  organization_id TEXT NOT NULL UNIQUE REFERENCES greenhouse_core.organizations (organization_id) ON DELETE CASCADE,
  property_id TEXT NULL,
  property_name TEXT NULL,
  scopes TEXT[] NOT NULL DEFAULT ARRAY['https://www.googleapis.com/auth/analytics.readonly'],
  status TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('active', 'pending', 'revoked', 'expired')),
  token_secret_ref TEXT NULL,
  connected_by_user_id TEXT NULL,
  connected_at TIMESTAMPTZ NULL,
  last_verified_at TIMESTAMPTZ NULL,
  last_error_code TEXT NULL,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  CONSTRAINT ga4_active_requires_property CHECK (status <> 'active' OR (property_id IS NOT NULL AND token_secret_ref IS NOT NULL))
);

CREATE INDEX ga4_connections_status_idx ON greenhouse_growth.ga4_connections (status);

CREATE TABLE greenhouse_growth.ga4_oauth_states (
  state_id TEXT PRIMARY KEY DEFAULT ('ga4-state-' || gen_random_uuid()::text),
  state_hash TEXT NOT NULL UNIQUE,
  organization_id TEXT NOT NULL REFERENCES greenhouse_core.organizations (organization_id) ON DELETE CASCADE,
  created_by_user_id TEXT NULL,
  expires_at TIMESTAMPTZ NOT NULL,
  consumed_at TIMESTAMPTZ NULL,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX ga4_oauth_states_expires_idx ON greenhouse_growth.ga4_oauth_states (expires_at) WHERE consumed_at IS NULL;

INSERT INTO greenhouse_core.capabilities_registry
  (capability_key, module, allowed_actions, allowed_scopes, description, introduced_at, deprecated_at)
VALUES
  ('growth.ga4.connect', 'growth', ARRAY['execute'], ARRAY['tenant'],
   'Conectar y desconectar una propiedad GA4 de una organización mediante OAuth de solo lectura.', NOW(), NULL)
ON CONFLICT (capability_key) DO UPDATE SET
  module = EXCLUDED.module,
  allowed_actions = EXCLUDED.allowed_actions,
  allowed_scopes = EXCLUDED.allowed_scopes,
  description = EXCLUDED.description,
  deprecated_at = NULL;

DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM information_schema.tables WHERE table_schema = 'greenhouse_growth' AND table_name = 'ga4_connections')
     OR NOT EXISTS (SELECT 1 FROM information_schema.tables WHERE table_schema = 'greenhouse_growth' AND table_name = 'ga4_oauth_states')
     OR NOT EXISTS (SELECT 1 FROM greenhouse_core.capabilities_registry WHERE capability_key = 'growth.ga4.connect' AND deprecated_at IS NULL) THEN
    RAISE EXCEPTION 'GA4 connection migration incomplete';
  END IF;
END $$;

ALTER TABLE greenhouse_growth.ga4_connections OWNER TO greenhouse_ops;
ALTER TABLE greenhouse_growth.ga4_oauth_states OWNER TO greenhouse_ops;

GRANT SELECT, INSERT, UPDATE, DELETE ON greenhouse_growth.ga4_connections TO greenhouse_runtime, greenhouse_app, greenhouse_migrator_user;
GRANT SELECT, INSERT, UPDATE, DELETE ON greenhouse_growth.ga4_oauth_states TO greenhouse_runtime, greenhouse_app, greenhouse_migrator_user;

-- Down Migration

UPDATE greenhouse_core.capabilities_registry SET deprecated_at = NOW() WHERE capability_key = 'growth.ga4.connect';
DROP TABLE IF EXISTS greenhouse_growth.ga4_oauth_states;
DROP TABLE IF EXISTS greenhouse_growth.ga4_connections;
