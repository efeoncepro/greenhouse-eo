-- Post-release additive migration. Activate capture only after source+worker readers are deployed.
-- Up Migration
CREATE TABLE IF NOT EXISTS greenhouse_growth.measurement_conversion (
  event_id UUID PRIMARY KEY,
  source_kind TEXT NOT NULL CHECK (source_kind IN ('form_submission','meeting_booking')),
  source_id TEXT NOT NULL,
  occurred_at TIMESTAMPTZ NOT NULL,
  consent_snapshot_json JSONB NOT NULL,
  encrypted_payload_json JSONB,
  created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
  UNIQUE (source_kind, source_id),
  CHECK ((consent_snapshot_json->>'advertisement') IS NOT DISTINCT FROM 'true'),
  CHECK ((consent_snapshot_json->>'globalPrivacyControl') IS NOT DISTINCT FROM 'false')
);
CREATE TABLE IF NOT EXISTS greenhouse_growth.measurement_delivery (
  event_id UUID NOT NULL REFERENCES greenhouse_growth.measurement_conversion(event_id) ON DELETE CASCADE,
  destination TEXT NOT NULL CHECK (destination IN ('meta','google_upd')),
  state TEXT NOT NULL DEFAULT 'queued' CHECK (state IN ('queued','sending','http_accepted','dead_letter')),
  attempts INTEGER NOT NULL DEFAULT 0 CHECK (attempts BETWEEN 0 AND 5),
  next_attempt_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
  lease_token UUID,
  lease_until TIMESTAMPTZ,
  http_status INTEGER,
  safe_error_class TEXT,
  updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (event_id, destination),
  CHECK ((state = 'sending') = (lease_token IS NOT NULL AND lease_until IS NOT NULL))
);
CREATE INDEX IF NOT EXISTS measurement_delivery_pending_idx
  ON greenhouse_growth.measurement_delivery(next_attempt_at) WHERE state IN ('queued','sending');
CREATE INDEX IF NOT EXISTS measurement_conversion_retention_idx
  ON greenhouse_growth.measurement_conversion(occurred_at);
DO $$ BEGIN
  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'greenhouse_app') THEN
    GRANT SELECT, INSERT, UPDATE, DELETE ON greenhouse_growth.measurement_conversion, greenhouse_growth.measurement_delivery TO greenhouse_app;
  END IF;
END $$;
