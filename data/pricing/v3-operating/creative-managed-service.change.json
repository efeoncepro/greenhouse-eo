        "revision": 1,
        "kind": "pricing",
        "value": {
          "profileId": "ECG-001",
          "tierCode": "historical-tier-3",
          "offerId": "creative-managed-service",
          "engagementCode": "monthly",
          "method": "target_margin",
          "rate": "0.45",
          "basis": "all_costs",
          "minimumMargin": "0.45"
        },
        "source": {
          "reference": "policy:creative-practice-margin-floor-2026-07-13",
