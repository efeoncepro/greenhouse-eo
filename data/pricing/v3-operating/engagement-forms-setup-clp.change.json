{
  "schemaVersion": "pricing-v3-catalog-change/1",
  "changeId": "operating-engagement-forms-setup-clp-2026-10-11",
  "baseDigest": "63b586dec65c9ded2c4b4806f9693a24335dea9245b6ce188f302630c1d7a45d",
  "nextVersion": "operating-review-2026-10-11-v9",
  "actor": "operator-authorized-agent",
  "reason": "Three additions decided on 2026-10-11. (1) The form of the engagement as its own datum: On-Going ratio 1 and On-Demand ratio 1.10 on price, one record per form instead of a second set of pricing policies. (2) Start-up provisions costed instead of the workbook rule of one month of the resource: account onboarding (USD 200, once per person, default) and recruiting (USD 500, optional, only when a person has to be hired); both estimates proposed by the agent and accepted by the CEO; the USD 100 test placeholder stops being selected. (3) CLP to USD at the inverse of the quote FX, so a cost invoiced in CLP can be carried in its own currency. Pricing policies and floors are untouched.",
  "changes": [
    {
      "operation": "add",
      "recordId": "engagement:on_going",
      "effectiveFrom": "2026-10-11",
      "record": {
        "recordId": "engagement:on_going",
        "revision": 1,
        "kind": "engagement_factor",
        "source": {
          "reference": "policy:ceo-engagement-form-2026-10-11",
          "effectiveFrom": "2026-10-11",
          "effectiveUntil": "9999-12-31",
          "status": "confirmed"
        },
        "note": "On-Going engagement: the reference form, no premium (price ratio 1). Commercial-model multiplier of the pricing workbook, kept on 2026-10-11. General record: it applies to every offer without a record of its own.",
        "value": {
          "form": "on_going",
          "priceRatio": "1"
        }
      }
    },
    {
      "operation": "add",
      "recordId": "engagement:on_demand",
      "effectiveFrom": "2026-10-11",
      "record": {
        "recordId": "engagement:on_demand",
        "revision": 1,
        "kind": "engagement_factor",
        "source": {
          "reference": "policy:ceo-engagement-form-2026-10-11",
          "effectiveFrom": "2026-10-11",
          "effectiveUntil": "9999-12-31",
          "status": "confirmed"
        },
        "note": "On-Demand engagement: +10% on the price of every row (price ratio 1.10). It is the commercial-model multiplier of the pricing workbook. On 2026-10-11 the CEO asked whether 10% was right and left any adjustment to the agent, who kept it: it sits at the low end of the 10-15% that agencies discount a retainer against a project rate, and in V3 start-up, coordination and supplier commitments are costed apart instead of hiding in the premium. General record: it applies to every offer without a record of its own.",
        "value": {
          "form": "on_demand",
          "priceRatio": "1.10"
        }
      }
    },
    {
      "operation": "add",
      "recordId": "provision-account-onboarding",
      "effectiveFrom": "2026-10-11",
      "record": {
        "recordId": "provision-account-onboarding",
        "revision": 1,
        "kind": "resource",
        "value": {
          "amount": "200",
          "currency": "USD",
          "resourceId": "provision-account-onboarding",
          "label": "Account onboarding per person (accesses, brief, brand immersion) — estimate, not measured",
          "kind": "setup",
          "unit": "once",
          "scope": "person",
          "covers": [
            "setup"
          ]
        },
        "source": {
          "reference": "policy:ceo-setup-provisions-2026-10-11",
          "effectiveFrom": "2026-10-11",
          "effectiveUntil": "9999-12-31",
          "status": "estimated"
        },
        "note": "Start-up provision charged once for each person who joins an account: accesses, brief and brand immersion. Proposed by the agent and accepted by the CEO on 2026-10-11. Basis: about two days of the lead's time, from the catalog cost of the Creative Operations Lead profile (ECG-001, USD 1,900 a month); the figure is the accepted round amount, not a measurement. Estimated: to be measured on the next two real incorporations and then replaced. It replaces the placeholder trial-setup. The workbook rule of one month of the resource's cost as recruiting and onboarding fee is not carried into the quoter; the protection it sought belongs to the contract terms (minimum term, conversion clause)."
      }
    },
    {
      "operation": "add",
      "recordId": "provision-recruiting",
      "effectiveFrom": "2026-10-11",
      "record": {
        "recordId": "provision-recruiting",
        "revision": 1,
        "kind": "resource",
        "value": {
          "amount": "500",
          "currency": "USD",
          "resourceId": "provision-recruiting",
          "label": "Recruiting of a new hire for the client — estimate, not measured",
          "kind": "setup",
          "unit": "once",
          "scope": "person",
          "covers": [
            "recruiting"
          ]
        },
        "source": {
          "reference": "policy:ceo-setup-provisions-2026-10-11",
          "effectiveFrom": "2026-10-11",
          "effectiveUntil": "9999-12-31",
          "status": "estimated"
        },
        "note": "Start-up provision charged once for each person who has to be hired for that client. Optional: it enters a quote only when the line selects it through choices (requirementId recruiting); it is never applied by default. Proposed by the agent and accepted by the CEO on 2026-10-11. Basis: about one week of selection work. Estimated: to be measured on the next two real incorporations and then replaced. The workbook rule of one month of the resource's cost is not carried into the quoter; the protection it sought belongs to the contract terms (minimum term, conversion clause)."
      }
    },
