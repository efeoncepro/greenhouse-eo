{
  "template": "InsightsFigureWaterfallSlide",
  "figmaNodeId": null,
  "version": "0.1",
  "note": "TASK-1975 — cascada 16:9: del total anterior al actual por aportes con signo (canvas Deck-Cascada).",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "slots": {
    "tabNumber": {
      "selector": "[data-slot='tabNumber']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 2,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Número de capítulo de la pestaña («00» en el resumen)."
    },
    "section": {
      "selector": "[data-slot='section']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 44,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "period": {
      "selector": "[data-slot='period']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "eyebrow": {
      "selector": "[data-slot='eyebrow']",
      "type": "object",
      "required": true,
      "shape": {
        "icon": {
          "type": "string",
          "required": false,
          "resolver": "deck-icon",
          "values": [
            "bars",
            "clicks",
            "impressions",
            "ctr",
            "search",
            "target",
            "link",
            "trend",
            "steps",
            "grid",
            "donut",
            "layers",
            "numbers"
          ]
        },
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 32,
          "maxLines": 1
        }
      },
      "notes": "Antetítulo de la figura con su ícono (escalera, `steps`)."
    },
    "keyFigure": {
      "selector": "[data-slot='keyFigure']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 9,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Cifra principal (`readings[].keyFigure.value`). El hook elige su cuerpo por el largo: 132, 112 o 104 px. En la cascada, sin lectura del plan, el cambio con signo entre los dos totales («+182»)."
    },
    "keyCaption": {
      "selector": "[data-slot='keyCaption']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 96,
        "maxLines": 3,
        "overflow": "reject",
        "allowedTags": [
          "strong"
        ]
      },
      "notes": "Bajada de la cifra (`keyFigure.caption`)."
    },
    "conclusion": {
      "selector": "[data-slot='conclusion']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 90,
        "maxLines": 4,
        "overflow": "reject"
      }
    },
    "figureTitle": {
      "selector": "[data-slot='figureTitle']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 56,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "source": {
      "selector": "[data-slot='source']",
      "type": "object",
      "required": true,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "maxLines": 1
        },
        "text": {
          "type": "string",
          "required": true,
          "maxCharacters": 64,
          "maxLines": 2
        }
      }
    },
    "legend": {
      "selector": "[data-slot='legend']",
      "type": "object",
      "required": true,
      "shape": {
        "prior": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "maxLines": 1
        },
        "added": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "maxLines": 1
        },
        "removed": {
          "type": "string",
          "required": false,
          "maxCharacters": 20,
          "maxLines": 1
        },
        "current": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "maxLines": 1
        }
      },
      "notes": "Rótulo del total anterior y del actual (de los pasos `isTotal` del plan), «Sumó» y —sólo si algún paso resta— «Restó»."
    },
    "waterfallSteps": {
      "selector": "[data-slot='waterfallSteps']",
      "type": "array",
      "required": true,
      "consumer": "validation-only",
      "constraints": {
        "minItems": 3,
        "maxItems": 8
      },
      "item": {
        "type": "object",
        "shape": {
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 48,
            "maxLines": 2
          },
          "value": {
            "type": "string",
            "required": true,
            "maxCharacters": 12,
            "maxLines": 1
          },
          "kind": {
            "type": "enum",
            "required": true,
            "values": [
              "start",
              "add",
              "remove",
              "end"
            ]
          }
        }
      },
      "notes": "Filas de la cascada (las dibuja el hook): el total anterior (`start`), los aportes con signo impreso (`add` «+96», `remove` «−23») y el total actual (`end`). Cada barra sale de su cifra impresa; si el inicial más los pasos no da el final, la figura no se dibuja. Hasta 6 pasos intermedios: una cascada no se pagina. Rótulos de hasta dos líneas.",
      "example": [
        {
          "label": "Julio",
          "value": "1.102",
          "kind": "start"
        },
        {
          "label": "Servicios",
          "value": "+96",
          "kind": "add"
        },
        {
          "label": "Home",
          "value": "−23",
          "kind": "remove"
        },
        {
          "label": "Agosto",
          "value": "1.175",
          "kind": "end"
        }
      ]
    },
    "note": {
      "selector": "[data-slot='note']",
      "type": "object",
      "required": false,
      "shape": {
        "text": {
          "type": "string",
          "required": true,
          "maxCharacters": 96,
          "maxLines": 1
        }
      },
      "notes": "Nota de lectura bajo la figura («El eje empieza en cero…»)."
    },
    "closing": {
      "selector": "[data-slot='closing']",
      "type": "array",
      "required": false,
      "constraints": {
        "minItems": 1,
        "maxItems": 2
      },
      "item": {
        "type": "object",
        "shape": {
          "kind": {
            "type": "string",
            "required": true,
            "resolver": "deck-closing-icon",
            "values": [
              "measure",
              "action"
            ]
          },
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 40,
            "maxLines": 1
          },
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 160,
            "maxLines": 3
          }
        }
      },
      "notes": "Lo que significa / Próximo paso (`readings[].meaning` / `nextStep`)."
    },
    "footerEdition": {
      "selector": "[data-slot='footerEdition']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "«Insights · Informe de <período>»."
    },
    "fixed-urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "agentMayOverride": false,
      "note": "template-owned: el HTML ya lo trae."
    },
    "folio": {
      "selector": "[data-slot='folio']",
      "type": "object",
      "required": true,
      "shape": {
        "page": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        },
        "total": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        }
      },
      "notes": "«NN / total» del plan de láminas de la misma composición."
    }
  }
}
