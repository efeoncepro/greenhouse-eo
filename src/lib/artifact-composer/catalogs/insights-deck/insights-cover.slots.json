{
  "template": "InsightsCoverSlide",
  "figmaNodeId": null,
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "editionId": {
      "selector": "[data-slot='editionId']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 24,
        "maxLines": 1,
        "transform": "uppercase",
        "overflow": "reject"
      }
    },
    "reportTitle": {
      "selector": "[data-slot='reportTitle']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 70,
        "maxLines": 3,
        "overflow": "reject"
      }
    },
    "reportSubtitle": {
      "selector": "[data-slot='reportSubtitle']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 150,
        "maxLines": 3,
        "overflow": "reject"
      }
    },
    "periodLabel": {
      "selector": "[data-slot='periodLabel']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 28,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "versionLabel": {
      "selector": "[data-slot='versionLabel']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 10,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "fixed-urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "agentMayOverride": false,
      "note": "template-owned. El pie de una lámina lleva COMO MÁXIMO la URL bubble: dirección, teléfonos y folio son del informe escrito."
    }
  }
}
