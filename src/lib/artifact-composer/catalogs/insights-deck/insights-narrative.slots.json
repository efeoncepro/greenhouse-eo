{
  "template": "InsightsNarrativeSlide",
  "figmaNodeId": null,
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "chapterLabel": {
      "selector": "[data-slot='chapterLabel']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 40,
        "maxLines": 1,
        "transform": "uppercase",
        "overflow": "reject"
      }
    },
    "assertion": {
      "selector": "[data-slot='assertion']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 120,
        "maxLines": 3,
        "allowedTags": [
          "em"
        ],
        "overflow": "reject"
      }
    },
    "points": {
      "selector": "[data-slot='points']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 4,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 190,
            "maxLines": 3
          }
        }
      },
      "notes": "Máximo 4: una lámina que se proyecta no sostiene más. El resto va al informe A4."
    },
    "fixed-urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "agentMayOverride": false,
      "note": "template-owned. El pie de una lámina lleva COMO MÁXIMO la URL bubble: dirección, teléfonos y folio son del informe escrito."
    }
  }
}
