{
  "template": "InsightsLimitsSlide",
  "figmaNodeId": null,
  "version": "0.1",
  "note": "TASK-1889 — límites del deck con la gramática del plan del deck (sin lámina propia en el canvas).",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "slots": {
    "tabNumber": {
      "selector": "[data-slot='tabNumber']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 2,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Número de capítulo de la pestaña («00» en el resumen)."
    },
    "section": {
      "selector": "[data-slot='section']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 44,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "period": {
      "selector": "[data-slot='period']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "eyebrow": {
      "selector": "[data-slot='eyebrow']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 32,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "heroFigure": {
      "selector": "[data-slot='heroFigure']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 3,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "heroText": {
      "selector": "[data-slot='heroText']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 64,
        "maxLines": 3,
        "overflow": "reject"
      }
    },
    "assertion": {
      "selector": "[data-slot='assertion']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 80,
        "maxLines": 3,
        "overflow": "reject",
        "allowedTags": [
          "em"
        ]
      }
    },
    "limits": {
      "selector": "[data-slot='limits']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 6
      },
      "item": {
        "type": "object",
        "shape": {
          "ordinal": {
            "type": "string",
            "required": false,
            "resolver": "deck-ordinal",
            "consumer": "resolver-only"
          },
          "subject": {
            "type": "string",
            "required": true,
            "maxCharacters": 38,
            "maxLines": 2
          },
          "cause": {
            "type": "string",
            "required": true,
            "maxCharacters": 110,
            "maxLines": 3
          }
        }
      }
    },
    "method": {
      "selector": "[data-slot='method']",
      "type": "object",
      "required": false,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "maxLines": 1
        },
        "text": {
          "type": "string",
          "required": true,
          "maxCharacters": 150,
          "maxLines": 2
        }
      }
    },
    "footerEdition": {
      "selector": "[data-slot='footerEdition']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "«Insights · Informe de <período>»."
    },
    "fixed-urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "agentMayOverride": false,
      "note": "template-owned: el HTML ya lo trae."
    },
    "folio": {
      "selector": "[data-slot='folio']",
      "type": "object",
      "required": true,
      "shape": {
        "page": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        },
        "total": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        }
      },
      "notes": "«NN / total» del plan de láminas de la misma composición."
    }
  }
}
