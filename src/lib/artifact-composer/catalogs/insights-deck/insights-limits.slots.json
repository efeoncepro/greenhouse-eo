{
  "template": "InsightsLimitsSlide",
  "figmaNodeId": null,
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "assertion": {
      "selector": "[data-slot='assertion']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 90,
        "maxLines": 2,
        "allowedTags": [
          "em"
        ],
        "overflow": "reject"
      }
    },
    "limits": {
      "selector": "[data-slot='limits']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 6,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "subject": {
            "type": "string",
            "required": true,
            "maxCharacters": 38,
            "maxLines": 2
          },
          "cause": {
            "type": "string",
            "required": true,
            "maxCharacters": 96,
            "maxLines": 2
          }
        }
      },
      "notes": "Máximo 6 en lámina; el informe A4 admite 14. Cada límite lleva su causa."
    },
    "fixed-urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "agentMayOverride": false,
      "note": "template-owned. El pie de una lámina lleva COMO MÁXIMO la URL bubble: dirección, teléfonos y folio son del informe escrito."
    }
  }
}
