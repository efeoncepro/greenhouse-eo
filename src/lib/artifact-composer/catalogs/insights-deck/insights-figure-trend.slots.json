{
  "template": "InsightsFigureTrendSlide",
  "figmaNodeId": null,
  "version": "0.1",
  "note": "TASK-1889 Slice 4 — tendencia en líneas por rol (canvas Deck-Lineas).",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "slots": {
    "tabNumber": {
      "selector": "[data-slot='tabNumber']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 2,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Número de capítulo de la pestaña («00» en el resumen)."
    },
    "section": {
      "selector": "[data-slot='section']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 44,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "period": {
      "selector": "[data-slot='period']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "eyebrow": {
      "selector": "[data-slot='eyebrow']",
      "type": "object",
      "required": true,
      "shape": {
        "icon": {
          "type": "string",
          "required": false,
          "resolver": "deck-icon",
          "values": [
            "bars",
            "clicks",
            "impressions",
            "ctr",
            "search",
            "target",
            "link",
            "trend"
          ]
        },
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 32,
          "maxLines": 1
        }
      }
    },
    "keyFigure": {
      "selector": "[data-slot='keyFigure']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 9,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Cifra principal (`readings[].keyFigure.value`). El hook elige su cuerpo por el largo: 132, 112 o 104 px."
    },
    "keyCaption": {
      "selector": "[data-slot='keyCaption']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 96,
        "maxLines": 3,
        "overflow": "reject",
        "allowedTags": [
          "strong"
        ]
      },
      "notes": "Bajada de la cifra (`keyFigure.caption`)."
    },
    "conclusion": {
      "selector": "[data-slot='conclusion']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 90,
        "maxLines": 4,
        "overflow": "reject"
      }
    },
    "figureTitle": {
      "selector": "[data-slot='figureTitle']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 56,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "source": {
      "selector": "[data-slot='source']",
      "type": "object",
      "required": true,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "maxLines": 1
        },
        "text": {
          "type": "string",
          "required": true,
          "maxCharacters": 36,
          "maxLines": 1
        }
      }
    },
    "lineLegend": {
      "selector": "[data-slot='lineLegend']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 3
      },
      "item": {
        "type": "object",
        "shape": {
          "role": {
            "type": "string",
            "required": true,
            "resolver": "deck-line-role",
            "values": [
              "primary",
              "reference",
              "detail"
            ]
          },
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 26,
            "maxLines": 1
          }
        }
      }
    },
    "lineSeries": {
      "selector": "[data-slot='lineSeries']",
      "type": "array",
      "required": true,
      "consumer": "validation-only",
      "constraints": {
        "minItems": 1,
        "maxItems": 3
      },
      "item": {
        "type": "object",
        "shape": {
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 40,
            "maxLines": 1
          },
          "role": {
            "type": "enum",
            "required": true,
            "values": [
              "primary",
              "reference",
              "detail"
            ]
          },
          "values": {
            "type": "array",
            "required": true
          },
          "endLabel": {
            "type": "string",
            "required": false,
            "maxCharacters": 10,
            "maxLines": 1
          }
        }
      },
      "example": [
        {
          "label": "Serie",
          "role": "primary",
          "values": [
            "1",
            "2",
            "3"
          ],
          "endLabel": "3"
        }
      ]
    },
    "lineXLabels": {
      "selector": "[data-slot='lineXLabels']",
      "type": "array",
      "required": true,
      "consumer": "validation-only",
      "constraints": {
        "minItems": 2,
        "maxItems": 12
      },
      "item": {
        "type": "object",
        "shape": {
          "index": {
            "type": "number",
            "required": true
          },
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 12,
            "maxLines": 1
          }
        }
      },
      "example": [
        {
          "index": 0,
          "label": "jul"
        },
        {
          "index": 2,
          "label": "sep"
        }
      ]
    },
    "lineAnnotations": {
      "selector": "[data-slot='lineAnnotations']",
      "type": "object",
      "required": false,
      "consumer": "validation-only",
      "shape": {
        "band": {
          "type": "object",
          "required": false
        },
        "startLabel": {
          "type": "string",
          "required": false,
          "maxCharacters": 10,
          "maxLines": 1
        },
        "endDelta": {
          "type": "string",
          "required": false,
          "maxCharacters": 20,
          "maxLines": 1
        },
        "fillBetween": {
          "type": "boolean",
          "required": false
        }
      },
      "example": {
        "startLabel": "1",
        "fillBetween": false
      }
    },
    "note": {
      "selector": "[data-slot='note']",
      "type": "object",
      "required": false,
      "shape": {
        "text": {
          "type": "string",
          "required": true,
          "maxCharacters": 96,
          "maxLines": 1
        }
      },
      "notes": "Nota de lectura bajo la figura."
    },
    "closing": {
      "selector": "[data-slot='closing']",
      "type": "array",
      "required": false,
      "constraints": {
        "minItems": 1,
        "maxItems": 2
      },
      "item": {
        "type": "object",
        "shape": {
          "kind": {
            "type": "string",
            "required": true,
            "resolver": "deck-closing-icon",
            "values": [
              "measure",
              "action"
            ]
          },
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 40,
            "maxLines": 1
          },
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 160,
            "maxLines": 3
          }
        }
      },
      "notes": "Lo que significa / Próximo paso (`readings[].meaning` / `nextStep`)."
    },
    "footerEdition": {
      "selector": "[data-slot='footerEdition']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "«Insights · Informe de <período>»."
    },
    "fixed-urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "agentMayOverride": false,
      "note": "template-owned: el HTML ya lo trae."
    },
    "folio": {
      "selector": "[data-slot='folio']",
      "type": "object",
      "required": true,
      "shape": {
        "page": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        },
        "total": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        }
      },
      "notes": "«NN / total» del plan de láminas de la misma composición."
    }
  }
}
