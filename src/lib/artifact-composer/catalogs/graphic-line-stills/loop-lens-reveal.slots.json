{
  "template": "LoopLensReveal",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 214
        },
        "questionPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-question-px=40px"
        },
        "questionLineHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-question-lh=1.2"
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 352
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 170
        },
        "answerLineHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-lh=0.92"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-tracking=-0.035em"
        },
        "answerNudge": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-nudge=-0.0706em"
        },
        "lensCx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lens-cx=1150px"
        },
        "lensCy": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lens-cy=420px"
        },
        "lensR": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lens-r=350px"
        },
        "photoX": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-photo-x=637px"
        },
        "photoY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-photo-y=-137px"
        }
      }
    },
    "photo": {
      "selector": "[data-slot='photo']",
      "type": "object",
      "required": true,
      "shape": {
        "lensSrc": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt"
        }
      }
    },
    "orbit": {
      "selector": "[data-slot='orbit']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 52
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 12
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "resolver": "gl-answer",
          "example": "sí"
        }
      }
    },
    "selection": {
      "selector": "[data-slot='selection']",
      "type": "object",
      "required": false,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "consumer": "validation-only"
        },
        "anchor": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only"
        },
        "participantKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "consumer": "validation-only"
        },
        "scale": {
          "type": "number",
          "required": false,
          "consumer": "validation-only"
        }
      }
    }
  }
}
