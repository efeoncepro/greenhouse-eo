{
  "template": "CamineroLens",
  "version": "0.1",
  "viewport": {
    "width": 3000,
    "height": 1000
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 90
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 200
        },
        "questionPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-question-px=110px"
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 348
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 330
        },
        "answerLineHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-lh=1"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-tracking=-0.035em"
        },
        "answerNudge": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-nudge=0em"
        },
        "signatureWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-signature-width=500px"
        },
        "signatureMargin": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-signature-margin=90px"
        },
        "lensCx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lens-cx=2100px"
        },
        "lensCy": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lens-cy=500px"
        },
        "lensR": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lens-r=400px"
        },
        "lensGray": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lens-gray=1"
        },
        "lensContrast": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lens-contrast=1.1"
        },
        "lensBrightness": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lens-brightness=0.5"
        },
        "lensVeil": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lens-veil=0.8"
        },
        "lensInsideX": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lens-inside-x=-525px"
        },
        "lensInsideY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lens-inside-y=-125px"
        }
      }
    },
    "photo": {
      "selector": "[data-slot='photo']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "lensSrc": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt"
        }
      }
    },
    "orbit": {
      "selector": "[data-slot='orbit']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 48
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 12
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "resolver": "gl-answer",
          "example": "sí"
        }
      }
    },
    "logo": {
      "selector": "[data-slot='logo']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/efeonce-logo-negative.svg"
    }
  }
}
