{
  "template": "HeroMobileNative360",
  "version": "0.1",
  "viewport": {
    "width": 360,
    "height": 780
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 23
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 114
        },
        "questionPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-question-px=17px"
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 147
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 85
        },
        "answerLineHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-lh=0.9"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-tracking=-0.055em"
        },
        "answerNudge": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-nudge=0.04em"
        },
        "ctaTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cta-top=667px"
        },
        "ctaPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cta-px=18px"
        },
        "ctaPadY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cta-pad-y=18px"
        },
        "ctaPadX": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cta-pad-x=29px"
        },
        "ctaRadius": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cta-radius=14px"
        },
        "descriptorPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-descriptor-px=14px"
        },
        "descriptorLineHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-descriptor-lh=1.4"
        },
        "descriptorWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-descriptor-width=344px"
        },
        "statusHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-status-height=47px"
        },
        "navHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-nav-height=55px"
        },
        "navPadX": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-nav-pad-x=23px"
        },
        "navLogoWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-nav-logo-width=105px"
        },
        "photoX": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-photo-x=-88px"
        }
      }
    },
    "photo": {
      "selector": "[data-slot='photo']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt"
        }
      }
    },
    "logo": {
      "selector": "[data-slot='logo']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/efeonce-logo-negative.svg"
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 48
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 12
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "resolver": "gl-answer",
          "example": "sí"
        }
      }
    },
    "cta": {
      "selector": "[data-slot='cta']",
      "type": "object",
      "required": true,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 28
        },
        "descriptor": {
          "type": "string",
          "required": true,
          "maxCharacters": 90
        }
      }
    },
    "selection": {
      "selector": "[data-slot='selection']",
      "type": "object",
      "required": false,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "consumer": "validation-only"
        },
        "anchor": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only"
        },
        "participantKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "consumer": "validation-only"
        },
        "scale": {
          "type": "number",
          "required": false,
          "consumer": "validation-only"
        }
      }
    }
  }
}
