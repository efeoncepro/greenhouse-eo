{
  "template": "HeroUniformTablet",
  "version": "0.1",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 96
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 176
        },
        "questionPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-question-px=32px"
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 230
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 176
        },
        "answerLineHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-lh=0.9"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-tracking=-0.05em"
        },
        "answerNudge": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-nudge=-0.0455em"
        },
        "ctaTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cta-top=612px"
        },
        "ctaPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cta-px=22px"
        },
        "ctaPadY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cta-pad-y=22px"
        },
        "ctaPadX": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cta-pad-x=40px"
        },
        "ctaRadius": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cta-radius=14px"
        },
        "descriptorPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-descriptor-px=19px"
        },
        "descriptorLineHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-descriptor-lh=1.45"
        },
        "descriptorWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-descriptor-width=330px"
        },
        "navHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-nav-height=84px"
        },
        "navPadX": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-nav-pad-x=56px"
        },
        "navLogoWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-nav-logo-width=150px"
        },
        "navLinkPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-nav-link-px=16px"
        }
      }
    },
    "photo": {
      "selector": "[data-slot='photo']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt",
          "example": "Una estratega de Efeonce con la chaqueta del equipo acerca a cámara una tableta con la curva que sube"
        }
      }
    },
    "logo": {
      "selector": "[data-slot='logo']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/efeonce-logo-negative.svg"
    },
    "nav": {
      "selector": "[data-slot='nav']",
      "type": "object",
      "required": false,
      "shape": {
        "links": {
          "type": "array",
          "required": true,
          "constraints": {
            "minItems": 1,
            "maxItems": 5,
            "overflow": "reject"
          },
          "item": {
            "type": "string",
            "maxCharacters": 16
          },
          "example": [
            "Servicios",
            "Casos",
            "Insights",
            "Nosotros"
          ]
        },
        "action": {
          "type": "string",
          "required": true,
          "maxCharacters": 18,
          "example": "Conversemos"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 48,
          "example": "¿Tu marketing ya mide lo que vende?"
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 12,
          "example": "Ahora"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "resolver": "gl-answer",
          "example": "sí"
        }
      }
    },
    "cta": {
      "selector": "[data-slot='cta']",
      "type": "object",
      "required": true,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 28,
          "example": "Agenda un diagnóstico"
        },
        "descriptor": {
          "type": "string",
          "required": true,
          "maxCharacters": 90,
          "example": "Revisamos contigo qué mide hoy tu marketing."
        }
      }
    },
    "selection": {
      "selector": "[data-slot='selection']",
      "type": "object",
      "required": false,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "consumer": "validation-only",
          "example": "Growth"
        },
        "anchor": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "bottom-end"
        },
        "participantKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "role"
        },
        "scale": {
          "type": "number",
          "required": false,
          "consumer": "validation-only",
          "example": 1.5
        }
      }
    }
  }
}
