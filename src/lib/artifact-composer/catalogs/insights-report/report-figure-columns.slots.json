{
  "template": "ReportFigureColumnsPage",
  "figmaNodeId": null,
  "version": "0.1",
  "note": "TASK-1889 Slice 4 — columnas agrupadas sobre un eje compartido (canvas Premium-Agrupadas).",
  "viewport": {
    "width": 794,
    "height": 1123
  },
  "slots": {
    "clientName": {
      "selector": "[data-slot='clientName']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 40,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Nombre del cliente en la cabecera. Sin cliente, la caja queda vacía y la página no se mueve; nunca un nombre inventado. El logo llega con la portada sellada de TASK-1888."
    },
    "chapterTab": {
      "selector": "[data-slot='chapterTab']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 2,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Número del capítulo en el canto («01»). Sin capítulo, la pestaña no se dibuja."
    },
    "runningSection": {
      "selector": "[data-slot='runningSection']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 32,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Sección de la página («Resumen ejecutivo»)."
    },
    "runningPeriod": {
      "selector": "[data-slot='runningPeriod']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Período y comparación («Agosto 2026 · contra julio 2026»)."
    },
    "eyebrow": {
      "selector": "[data-slot='eyebrow']",
      "type": "object",
      "required": true,
      "shape": {
        "icon": {
          "type": "string",
          "required": false,
          "resolver": "report-icon",
          "values": [
            "bars",
            "clicks",
            "impressions",
            "ctr",
            "search",
            "target",
            "link",
            "trend"
          ]
        },
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 32,
          "maxLines": 1
        }
      },
      "notes": "Antetítulo de la figura con su ícono."
    },
    "keyFigure": {
      "selector": "[data-slot='keyFigure']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 12,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Cifra principal de la figura: `readings[].keyFigure.value` del plan (formateador canónico). Nunca calculada en la plantilla."
    },
    "keyCaption": {
      "selector": "[data-slot='keyCaption']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 110,
        "maxLines": 3,
        "overflow": "reject",
        "allowedTags": [
          "strong"
        ]
      },
      "notes": "Bajada de la cifra: `keyFigure.caption` del plan."
    },
    "conclusion": {
      "selector": "[data-slot='conclusion']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 96,
        "maxLines": 3,
        "overflow": "reject"
      },
      "notes": "Conclusión de la página: `readings[].conclusion` o la afirmación del plan que cita la figura."
    },
    "lead": {
      "selector": "[data-slot='lead']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 170,
        "maxLines": 3,
        "overflow": "reject"
      }
    },
    "figureTitle": {
      "selector": "[data-slot='figureTitle']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 56,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Título de la figura (`chart.title`)."
    },
    "legend": {
      "selector": "[data-slot='legend']",
      "type": "object",
      "required": true,
      "shape": {
        "current": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "maxLines": 1
        },
        "prior": {
          "type": "string",
          "required": false,
          "maxCharacters": 24,
          "maxLines": 1
        },
        "opportunity": {
          "type": "string",
          "required": false,
          "maxCharacters": 24,
          "maxLines": 1
        }
      },
      "notes": "Período, anterior y —si el plan declara oportunidad— su rótulo."
    },
    "columnGroups": {
      "selector": "[data-slot='columnGroups']",
      "type": "array",
      "required": true,
      "consumer": "validation-only",
      "constraints": {
        "minItems": 2,
        "maxItems": 6
      },
      "item": {
        "type": "object",
        "shape": {
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 16,
            "maxLines": 1
          },
          "current": {
            "type": "string",
            "required": true,
            "maxCharacters": 10,
            "maxLines": 1
          },
          "prior": {
            "type": "string",
            "required": false,
            "maxCharacters": 10,
            "maxLines": 1
          },
          "delta": {
            "type": "string",
            "required": false,
            "maxCharacters": 8,
            "maxLines": 1
          },
          "direction": {
            "type": "enum",
            "required": false,
            "values": [
              "up",
              "down",
              "flat"
            ]
          }
        }
      },
      "notes": "Grupos de la figura (lo dibuja el hook). La columna sale de la cifra impresa; o todos los grupos traen el anterior o ninguno.",
      "example": [
        {
          "label": "A",
          "current": "9",
          "prior": "6",
          "delta": "+3",
          "direction": "up"
        },
        {
          "label": "B",
          "current": "17",
          "prior": "15",
          "delta": "+2",
          "direction": "up"
        }
      ]
    },
    "columnBand": {
      "selector": "[data-slot='columnBand']",
      "type": "object",
      "required": false,
      "consumer": "validation-only",
      "shape": {
        "from": {
          "type": "number",
          "required": true
        },
        "to": {
          "type": "number",
          "required": true
        },
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 32,
          "maxLines": 1
        }
      },
      "notes": "Franja resaltada sobre grupos contiguos («Primera página de Google»). Sólo si el plan la declara.",
      "example": {
        "from": 0,
        "to": 0,
        "label": "Franja"
      }
    },
    "columnOpportunity": {
      "selector": "[data-slot='columnOpportunity']",
      "type": "object",
      "required": false,
      "consumer": "validation-only",
      "shape": {
        "group": {
          "type": "number",
          "required": true
        },
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "maxLines": 1
        }
      },
      "notes": "Grupo marcado como oportunidad (borde discontinuo). Nunca se distingue sólo por color: lleva rótulo.",
      "example": {
        "group": 1,
        "label": "A un paso"
      }
    },
    "note": {
      "selector": "[data-slot='note']",
      "type": "object",
      "required": false,
      "shape": {
        "text": {
          "type": "string",
          "required": true,
          "maxCharacters": 120,
          "maxLines": 1
        }
      },
      "notes": "Nota de lectura bajo la figura. Sin nota del plan, no se dibuja."
    },
    "provenance": {
      "selector": "[data-slot='provenance']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 3
      },
      "item": {
        "type": "object",
        "shape": {
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 16,
            "maxLines": 1
          },
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 96,
            "maxLines": 2
          }
        }
      },
      "notes": "Unidad, fuente y cobertura de la figura."
    },
    "closing": {
      "selector": "[data-slot='closing']",
      "type": "array",
      "required": false,
      "constraints": {
        "minItems": 1,
        "maxItems": 2
      },
      "item": {
        "type": "object",
        "shape": {
          "kind": {
            "type": "string",
            "required": true,
            "resolver": "report-closing-icon",
            "values": [
              "measure",
              "action"
            ]
          },
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 40,
            "maxLines": 1
          },
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 190,
            "maxLines": 4
          },
          "signature": {
            "type": "string",
            "required": false,
            "maxCharacters": 40,
            "maxLines": 1
          }
        }
      },
      "notes": "Lo que significa / Próximo paso: `readings[].meaning` y `nextStep` del plan. Sin próximo paso, el panel lleva una sola columna."
    },
    "footerEdition": {
      "selector": "[data-slot='footerEdition']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "«Insights · Informe de <período>»."
    },
    "footerContact": {
      "selector": "[data-slot='footerContact']",
      "type": "object",
      "required": true,
      "shape": {
        "address": {
          "type": "string",
          "required": true,
          "maxCharacters": 72,
          "maxLines": 1
        },
        "phone": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "maxLines": 1
        }
      },
      "notes": "Desde EFEONCE_CONTACT (dirección de presentación y teléfono de Chile)."
    },
    "fixed-urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "agentMayOverride": false,
      "note": "template-owned: el HTML ya lo trae."
    },
    "folio": {
      "selector": "[data-slot='folio']",
      "type": "object",
      "required": true,
      "shape": {
        "page": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        },
        "total": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        }
      },
      "notes": "«NN / total»: ambos del plan de páginas de la misma composición (paginateFlow), nunca un número fijo."
    }
  }
}
