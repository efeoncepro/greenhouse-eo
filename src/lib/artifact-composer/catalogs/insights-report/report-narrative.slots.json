{
  "template": "ReportNarrativePage",
  "figmaNodeId": null,
  "version": "0.1",
  "note": "TASK-1889 — capítulo narrado A4 con la anatomía de «Nuestra lectura»: capitular, columna lateral útil (frase clave + páginas del capítulo con folio) y cierre navy opcional. Sin página propia en el canvas.",
  "viewport": {
    "width": 794,
    "height": 1123
  },
  "slots": {
    "clientName": {
      "selector": "[data-slot='clientName']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 40,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Nombre del cliente en la cabecera. Sin cliente, la caja queda vacía y la página no se mueve; nunca un nombre inventado. El logo llega con la portada sellada de TASK-1888."
    },
    "runningSection": {
      "selector": "[data-slot='runningSection']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 44,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Sección de la página («Resumen ejecutivo»)."
    },
    "runningPeriod": {
      "selector": "[data-slot='runningPeriod']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Período y comparación («Agosto 2026 · contra julio 2026»)."
    },
    "eyebrow": {
      "selector": "[data-slot='eyebrow']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 40,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "assertion": {
      "selector": "[data-slot='assertion']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 130,
        "maxLines": 3,
        "overflow": "reject"
      }
    },
    "lead": {
      "selector": "[data-slot='lead']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 260,
        "maxLines": 4,
        "overflow": "reject"
      }
    },
    "paragraphs": {
      "selector": "[data-slot='paragraphs']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 6,
        "maxCharactersPerItem": 420
      },
      "item": {
        "type": "rich-string",
        "allowedTags": [
          "strong"
        ]
      }
    },
    "pullQuote": {
      "selector": "[data-slot='pullQuote']",
      "type": "object",
      "required": false,
      "shape": {
        "text": {
          "type": "string",
          "required": true,
          "maxCharacters": 90,
          "maxLines": 4
        },
        "source": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "maxLines": 1
        }
      }
    },
    "evidence": {
      "selector": "[data-slot='evidence']",
      "type": "object",
      "required": false,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 32,
          "maxLines": 1
        },
        "items": {
          "type": "array",
          "required": true,
          "constraints": {
            "minItems": 1,
            "maxItems": 8
          },
          "item": {
            "type": "object",
            "shape": {
              "folio": {
                "type": "string",
                "required": true,
                "maxCharacters": 8,
                "maxLines": 1
              },
              "text": {
                "type": "string",
                "required": true,
                "maxCharacters": 48,
                "maxLines": 2
              }
            }
          }
        }
      },
      "notes": "Páginas que respaldan la lectura, con folio real (plan de páginas de la misma composición)."
    },
    "closing": {
      "selector": "[data-slot='closing']",
      "type": "array",
      "required": false,
      "constraints": {
        "minItems": 1,
        "maxItems": 2
      },
      "item": {
        "type": "object",
        "shape": {
          "kind": {
            "type": "string",
            "required": true,
            "resolver": "report-closing-icon",
            "values": [
              "measure",
              "action"
            ]
          },
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 40,
            "maxLines": 1
          },
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 240,
            "maxLines": 4
          },
          "signature": {
            "type": "string",
            "required": false,
            "maxCharacters": 40,
            "maxLines": 1
          }
        }
      },
      "notes": "Decisión (resumen) o lectura del plan. Sin ella, la página compone sin panel."
    },
    "footerEdition": {
      "selector": "[data-slot='footerEdition']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "«Insights · Informe de <período>»."
    },
    "footerContact": {
      "selector": "[data-slot='footerContact']",
      "type": "object",
      "required": true,
      "shape": {
        "address": {
          "type": "string",
          "required": true,
          "maxCharacters": 72,
          "maxLines": 1
        },
        "phone": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "maxLines": 1
        }
      },
      "notes": "Desde EFEONCE_CONTACT (dirección de presentación y teléfono de Chile)."
    },
    "fixed-urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "agentMayOverride": false,
      "note": "template-owned: el HTML ya lo trae."
    },
    "folio": {
      "selector": "[data-slot='folio']",
      "type": "object",
      "required": true,
      "shape": {
        "page": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        },
        "total": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        }
      },
      "notes": "«NN / total»: ambos del plan de páginas de la misma composición (paginateFlow), nunca un número fijo."
    }
  }
}
