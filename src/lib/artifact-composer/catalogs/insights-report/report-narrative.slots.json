{
  "template": "ReportNarrativePage",
  "figmaNodeId": null,
  "version": "0.1",
  "viewport": {
    "width": 794,
    "height": 1123
  },
  "slots": {
    "runningChapter": {
      "selector": "[data-slot='runningChapter']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 40,
        "maxLines": 1,
        "transform": "uppercase",
        "overflow": "reject"
      }
    },
    "runningPeriod": {
      "selector": "[data-slot='runningPeriod']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 32,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "assertion": {
      "selector": "[data-slot='assertion']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 130,
        "maxLines": 3,
        "allowedTags": [
          "em"
        ],
        "overflow": "reject"
      }
    },
    "lead": {
      "selector": "[data-slot='lead']",
      "type": "rich-string",
      "required": false,
      "constraints": {
        "maxCharacters": 260,
        "maxLines": 4,
        "allowedTags": [
          "b"
        ],
        "overflow": "reject"
      }
    },
    "paragraphs": {
      "selector": "[data-slot='paragraphs']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 7,
        "maxCharactersPerItem": 420,
        "overflow": "reject"
      },
      "item": {
        "type": "rich-string",
        "allowedTags": [
          "b"
        ]
      },
      "notes": "El TECHO de 7 párrafos es del molde: más no cabe en el alto útil y el reparto entre páginas lo hace paginateFlow() antes de imprimir."
    },
    "fixed-urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "agentMayOverride": false,
      "note": "template-owned: el HTML ya lo trae."
    },
    "fixed-contactDetails": {
      "selector": "[data-slot='contactDetails']",
      "type": "fixed-contact-set",
      "required": true,
      "agentMayOverride": false,
      "value": {
        "chilePhone": "+56 9 3732 3064",
        "address": "Dr. Manuel Barros Borgoño 71 OF 1105, Providencia, Chile"
      },
      "note": "Dueño del valor: back-cover-full.slots.json de deck-axis. Pie completo en CADA página, incluida la portada."
    },
    "pageFolio": {
      "selector": "[data-slot='pageFolio']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 8,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Asignado por el plan de páginas ANTES de imprimir."
    }
  }
}
