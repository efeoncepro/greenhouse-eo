{
  "template": "ReportLimitsPage",
  "figmaNodeId": null,
  "version": "0.1",
  "viewport": {
    "width": 794,
    "height": 1123
  },
  "slots": {
    "runningChapter": {
      "selector": "[data-slot='runningChapter']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 40,
        "maxLines": 1,
        "transform": "uppercase",
        "overflow": "reject"
      }
    },
    "runningPeriod": {
      "selector": "[data-slot='runningPeriod']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 32,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "assertion": {
      "selector": "[data-slot='assertion']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 90,
        "maxLines": 2,
        "allowedTags": [
          "em"
        ],
        "overflow": "reject"
      }
    },
    "limits": {
      "selector": "[data-slot='limits']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 14,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "subject": {
            "type": "string",
            "required": true,
            "maxCharacters": 38,
            "maxLines": 2
          },
          "cause": {
            "type": "string",
            "required": true,
            "maxCharacters": 110,
            "maxLines": 3
          }
        }
      },
      "notes": "Cada límite lleva su CAUSA: «sin datos» a secas no le sirve a nadie para decidir qué conectar."
    },
    "methodology": {
      "selector": "[data-slot='methodology']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 8,
        "maxCharactersPerItem": 180,
        "overflow": "reject"
      },
      "item": {
        "type": "string"
      }
    },
    "fixed-urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "agentMayOverride": false,
      "note": "template-owned: el HTML ya lo trae."
    },
    "fixed-contactDetails": {
      "selector": "[data-slot='contactDetails']",
      "type": "fixed-contact-set",
      "required": true,
      "agentMayOverride": false,
      "value": {
        "chilePhone": "+56 9 3732 3064",
        "address": "Dr. Manuel Barros Borgoño 71 OF 1105, Providencia, Chile"
      },
      "note": "Dueño del valor: back-cover-full.slots.json de deck-axis. Pie completo en CADA página, incluida la portada."
    },
    "pageFolio": {
      "selector": "[data-slot='pageFolio']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 8,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Asignado por el plan de páginas ANTES de imprimir."
    }
  }
}
