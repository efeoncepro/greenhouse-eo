{
  "template": "ReportTablePage",
  "figmaNodeId": null,
  "version": "0.1",
  "viewport": {
    "width": 794,
    "height": 1123
  },
  "slots": {
    "runningChapter": {
      "selector": "[data-slot='runningChapter']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 40,
        "maxLines": 1,
        "transform": "uppercase",
        "overflow": "reject"
      }
    },
    "runningPeriod": {
      "selector": "[data-slot='runningPeriod']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 32,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "tableTitle": {
      "selector": "[data-slot='tableTitle']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 60,
        "maxLines": 2,
        "overflow": "reject"
      }
    },
    "continuationLabel": {
      "selector": "[data-slot='continuationLabel']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 34,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Sólo en páginas que continúan una tabla. Una tabla que sigue sin decirlo obliga a retroceder."
    },
    "tableColumns": {
      "selector": "[data-slot='tableColumns']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 2,
        "maxItems": 3,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 22,
            "maxLines": 2
          }
        }
      },
      "notes": "Entre 2 y 3 columnas. Un catálogo cerrado no estira una plantilla para cualquier ancho: si hace falta otra forma de tabla, es un gap del catálogo y se diseña su plantilla."
    },
    "tableRows": {
      "selector": "[data-slot='tableRows']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 26,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "entity": {
            "type": "string",
            "required": true,
            "maxCharacters": 44,
            "maxLines": 2
          },
          "valueA": {
            "type": "string",
            "required": true,
            "maxCharacters": 14,
            "maxLines": 1
          },
          "valueB": {
            "type": "string",
            "required": false,
            "maxCharacters": 14,
            "maxLines": 1
          }
        }
      },
      "notes": "El TECHO DE FILAS es del molde, no una preferencia: más de 26 no caben en el alto útil, y el reparto entre páginas lo hace paginateFlow() antes de imprimir. Una celda sin dato se escribe «—», nunca 0."
    },
    "tableSource": {
      "selector": "[data-slot='tableSource']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 110,
        "maxLines": 2,
        "overflow": "reject"
      }
    },
    "fixed-urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "agentMayOverride": false,
      "note": "template-owned: el HTML ya lo trae."
    },
    "fixed-contactDetails": {
      "selector": "[data-slot='contactDetails']",
      "type": "fixed-contact-set",
      "required": true,
      "agentMayOverride": false,
      "value": {
        "chilePhone": "+56 9 3732 3064",
        "address": "Dr. Manuel Barros Borgoño 71 OF 1105, Providencia, Chile"
      },
      "note": "Dueño del valor: back-cover-full.slots.json de deck-axis. Pie completo en CADA página, incluida la portada."
    },
    "pageFolio": {
      "selector": "[data-slot='pageFolio']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 8,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Asignado por el plan de páginas ANTES de imprimir."
    }
  }
}
