{
  "template": "ReportTablePage",
  "figmaNodeId": null,
  "version": "0.1",
  "note": "TASK-1889 — tabla de respaldo A4: cifra protagonista, ranking, barra desde el dato y procedencia. Sin página propia en el canvas.",
  "viewport": {
    "width": 794,
    "height": 1123
  },
  "slots": {
    "clientName": {
      "selector": "[data-slot='clientName']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 40,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Nombre del cliente en la cabecera. Sin cliente, la caja queda vacía y la página no se mueve; nunca un nombre inventado. El logo llega con la portada sellada de TASK-1888."
    },
    "runningSection": {
      "selector": "[data-slot='runningSection']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 32,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Sección de la página («Resumen ejecutivo»)."
    },
    "runningPeriod": {
      "selector": "[data-slot='runningPeriod']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Período y comparación («Agosto 2026 · contra julio 2026»)."
    },
    "eyebrow": {
      "selector": "[data-slot='eyebrow']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 32,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "heroFigure": {
      "selector": "[data-slot='heroFigure']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 12,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Valor de la fila más alta de la tabla completa (lo calcula el mapper del dato)."
    },
    "heroText": {
      "selector": "[data-slot='heroText']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 110,
        "maxLines": 3,
        "overflow": "reject",
        "allowedTags": [
          "strong"
        ]
      },
      "notes": "Qué es la cifra: columna y fila («impresiones en <strong>/precios</strong>, la fila más alta de la tabla»)."
    },
    "tableTitle": {
      "selector": "[data-slot='tableTitle']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 80,
        "maxLines": 3,
        "overflow": "reject"
      }
    },
    "lead": {
      "selector": "[data-slot='lead']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 140,
        "maxLines": 2,
        "overflow": "reject"
      }
    },
    "continuationLabel": {
      "selector": "[data-slot='continuationLabel']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "boardTitle": {
      "selector": "[data-slot='boardTitle']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "legend": {
      "selector": "[data-slot='legend']",
      "type": "object",
      "required": true,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "maxLines": 1
        }
      }
    },
    "tableColumns": {
      "selector": "[data-slot='tableColumns']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 3,
        "maxItems": 4
      },
      "item": {
        "type": "object",
        "shape": {
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 24,
            "maxLines": 1
          }
        }
      }
    },
    "tableRows": {
      "selector": "[data-slot='tableRows']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 16
      },
      "item": {
        "type": "object",
        "shape": {
          "rank": {
            "type": "string",
            "required": false,
            "resolver": "report-table-rank",
            "consumer": "resolver-only"
          },
          "entity": {
            "type": "string",
            "required": true,
            "maxCharacters": 48,
            "maxLines": 1
          },
          "bar": {
            "type": "string",
            "required": false,
            "resolver": "report-table-bar",
            "consumer": "resolver-only"
          },
          "valueA": {
            "type": "string",
            "required": true,
            "maxCharacters": 16,
            "maxLines": 1
          },
          "valueB": {
            "type": "string",
            "required": false,
            "maxCharacters": 16,
            "maxLines": 1
          }
        }
      }
    },
    "barScaleMax": {
      "selector": "[data-slot='barScaleMax']",
      "type": "string",
      "required": false,
      "consumer": "validation-only",
      "constraints": {
        "maxCharacters": 24,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Máximo de la primera columna de valor en la tabla COMPLETA: la escala de la barra no cambia entre páginas."
    },
    "rankOffset": {
      "selector": "[data-slot='rankOffset']",
      "type": "string",
      "required": false,
      "consumer": "validation-only",
      "constraints": {
        "maxCharacters": 4,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Filas de la tabla ya mostradas en páginas anteriores: el ranking continúa."
    },
    "source": {
      "selector": "[data-slot='source']",
      "type": "object",
      "required": true,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "maxLines": 1
        },
        "text": {
          "type": "string",
          "required": true,
          "maxCharacters": 90,
          "maxLines": 2
        }
      }
    },
    "coverage": {
      "selector": "[data-slot='coverage']",
      "type": "object",
      "required": false,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "maxLines": 1
        },
        "text": {
          "type": "string",
          "required": true,
          "maxCharacters": 90,
          "maxLines": 2
        }
      }
    },
    "closing": {
      "selector": "[data-slot='closing']",
      "type": "array",
      "required": false,
      "constraints": {
        "minItems": 1,
        "maxItems": 2
      },
      "item": {
        "type": "object",
        "shape": {
          "kind": {
            "type": "string",
            "required": true,
            "resolver": "report-closing-icon",
            "values": [
              "measure",
              "action"
            ]
          },
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 40,
            "maxLines": 1
          },
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 220,
            "maxLines": 4
          },
          "signature": {
            "type": "string",
            "required": false,
            "maxCharacters": 40,
            "maxLines": 1
          }
        }
      },
      "notes": "Lo que significa / Próximo paso de la tabla, cuando el plan trae la lectura. Sin ella, la página compone sin panel."
    },
    "footerEdition": {
      "selector": "[data-slot='footerEdition']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "«Insights · Informe de <período>»."
    },
    "footerContact": {
      "selector": "[data-slot='footerContact']",
      "type": "object",
      "required": true,
      "shape": {
        "address": {
          "type": "string",
          "required": true,
          "maxCharacters": 72,
          "maxLines": 1
        },
        "phone": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "maxLines": 1
        }
      },
      "notes": "Desde EFEONCE_CONTACT (dirección de presentación y teléfono de Chile)."
    },
    "fixed-urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "agentMayOverride": false,
      "note": "template-owned: el HTML ya lo trae."
    },
    "folio": {
      "selector": "[data-slot='folio']",
      "type": "object",
      "required": true,
      "shape": {
        "page": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        },
        "total": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        }
      },
      "notes": "«NN / total»: ambos del plan de páginas de la misma composición (paginateFlow), nunca un número fijo."
    }
  }
}
