{
  "template": "ReportFigureTargetsPage",
  "figmaNodeId": null,
  "version": "0.1",
  "note": "TASK-1889 Slice 4 — resultado contra la meta (bullet, canvas Premium-Metas).",
  "viewport": {
    "width": 794,
    "height": 1123
  },
  "slots": {
    "clientName": {
      "selector": "[data-slot='clientName']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 40,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Nombre del cliente en la cabecera. Sin cliente, la caja queda vacía y la página no se mueve; nunca un nombre inventado. El logo llega con la portada sellada de TASK-1888."
    },
    "chapterTab": {
      "selector": "[data-slot='chapterTab']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 2,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Número del capítulo en el canto («01»). Sin capítulo, la pestaña no se dibuja."
    },
    "runningSection": {
      "selector": "[data-slot='runningSection']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 32,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Sección de la página («Resumen ejecutivo»)."
    },
    "runningPeriod": {
      "selector": "[data-slot='runningPeriod']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Período y comparación («Agosto 2026 · contra julio 2026»)."
    },
    "eyebrow": {
      "selector": "[data-slot='eyebrow']",
      "type": "object",
      "required": true,
      "shape": {
        "icon": {
          "type": "string",
          "required": false,
          "resolver": "report-icon",
          "values": [
            "bars",
            "clicks",
            "impressions",
            "ctr",
            "search",
            "target",
            "link",
            "trend"
          ]
        },
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 32,
          "maxLines": 1
        }
      },
      "notes": "Antetítulo de la figura con su ícono."
    },
    "keyFigure": {
      "selector": "[data-slot='keyFigure']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 12,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Cifra principal de la figura: `readings[].keyFigure.value` del plan (formateador canónico). Nunca calculada en la plantilla."
    },
    "keyCaption": {
      "selector": "[data-slot='keyCaption']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 110,
        "maxLines": 3,
        "overflow": "reject",
        "allowedTags": [
          "strong"
        ]
      },
      "notes": "Bajada de la cifra: `keyFigure.caption` del plan."
    },
    "conclusion": {
      "selector": "[data-slot='conclusion']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 96,
        "maxLines": 3,
        "overflow": "reject"
      },
      "notes": "Conclusión de la página: `readings[].conclusion` o la afirmación del plan que cita la figura."
    },
    "lead": {
      "selector": "[data-slot='lead']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 170,
        "maxLines": 3,
        "overflow": "reject"
      }
    },
    "figureTitle": {
      "selector": "[data-slot='figureTitle']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 56,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Título de la figura (`chart.title`)."
    },
    "legend": {
      "selector": "[data-slot='legend']",
      "type": "object",
      "required": true,
      "shape": {
        "achieved": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "maxLines": 1
        },
        "target": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "maxLines": 1
        },
        "gap": {
          "type": "string",
          "required": false,
          "maxCharacters": 24,
          "maxLines": 1
        }
      },
      "notes": "«Mayor brecha» sólo si alguna fila no alcanzó su meta."
    },
    "bulletDirection": {
      "selector": "[data-slot='bulletDirection']",
      "type": "enum",
      "required": true,
      "consumer": "validation-only",
      "values": [
        "higher_is_better",
        "lower_is_better"
      ],
      "notes": "Dirección de las metas (`data.direction` del ChartSpec bullet): decide si se alcanzó y cuál es la mayor brecha."
    },
    "bulletRows": {
      "selector": "[data-slot='bulletRows']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 6
      },
      "item": {
        "type": "object",
        "shape": {
          "icon": {
            "type": "string",
            "required": false,
            "resolver": "report-icon",
            "values": [
              "bars",
              "clicks",
              "impressions",
              "ctr",
              "search",
              "target",
              "link",
              "trend"
            ]
          },
          "name": {
            "type": "string",
            "required": true,
            "maxCharacters": 30,
            "maxLines": 2
          },
          "unit": {
            "type": "string",
            "required": true,
            "maxCharacters": 20,
            "maxLines": 1
          },
          "bar": {
            "type": "string",
            "required": false,
            "resolver": "report-bullet-row",
            "consumer": "resolver-only"
          },
          "value": {
            "type": "string",
            "required": true,
            "maxCharacters": 14,
            "maxLines": 1,
            "example": "9"
          },
          "achievedLabel": {
            "type": "string",
            "required": true,
            "maxCharacters": 12,
            "maxLines": 1
          },
          "targetLabel": {
            "type": "string",
            "required": true,
            "maxCharacters": 12,
            "maxLines": 1
          },
          "target": {
            "type": "string",
            "required": true,
            "maxCharacters": 14,
            "maxLines": 1,
            "example": "10"
          },
          "pct": {
            "type": "string",
            "required": true,
            "maxCharacters": 8,
            "maxLines": 1,
            "example": "90 %"
          }
        }
      },
      "notes": "Un indicador por fila, en su escala. La geometría sale de `value` y `target` impresos; `pct` es el porcentaje de la meta del formateador canónico."
    },
    "note": {
      "selector": "[data-slot='note']",
      "type": "object",
      "required": false,
      "shape": {
        "text": {
          "type": "string",
          "required": true,
          "maxCharacters": 120,
          "maxLines": 1
        }
      },
      "notes": "Nota de lectura bajo la figura. Sin nota del plan, no se dibuja."
    },
    "provenance": {
      "selector": "[data-slot='provenance']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 3
      },
      "item": {
        "type": "object",
        "shape": {
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 16,
            "maxLines": 1
          },
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 96,
            "maxLines": 2
          }
        }
      },
      "notes": "Unidad, fuente y cobertura de la figura."
    },
    "closing": {
      "selector": "[data-slot='closing']",
      "type": "array",
      "required": false,
      "constraints": {
        "minItems": 1,
        "maxItems": 2
      },
      "item": {
        "type": "object",
        "shape": {
          "kind": {
            "type": "string",
            "required": true,
            "resolver": "report-closing-icon",
            "values": [
              "measure",
              "action"
            ]
          },
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 40,
            "maxLines": 1
          },
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 190,
            "maxLines": 4
          },
          "signature": {
            "type": "string",
            "required": false,
            "maxCharacters": 40,
            "maxLines": 1
          }
        }
      },
      "notes": "Lo que significa / Próximo paso: `readings[].meaning` y `nextStep` del plan. Sin próximo paso, el panel lleva una sola columna."
    },
    "footerEdition": {
      "selector": "[data-slot='footerEdition']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "«Insights · Informe de <período>»."
    },
    "footerContact": {
      "selector": "[data-slot='footerContact']",
      "type": "object",
      "required": true,
      "shape": {
        "address": {
          "type": "string",
          "required": true,
          "maxCharacters": 72,
          "maxLines": 1
        },
        "phone": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "maxLines": 1
        }
      },
      "notes": "Desde EFEONCE_CONTACT (dirección de presentación y teléfono de Chile)."
    },
    "fixed-urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "agentMayOverride": false,
      "note": "template-owned: el HTML ya lo trae."
    },
    "folio": {
      "selector": "[data-slot='folio']",
      "type": "object",
      "required": true,
      "shape": {
        "page": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        },
        "total": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        }
      },
      "notes": "«NN / total»: ambos del plan de páginas de la misma composición (paginateFlow), nunca un número fijo."
    }
  }
}
