{
  "template": "ReportFigureWaterfallPage",
  "figmaNodeId": null,
  "version": "0.1",
  "note": "TASK-1975 — cascada: del total anterior al actual por aportes con signo (canvas Premium-Cascada).",
  "viewport": {
    "width": 794,
    "height": 1123
  },
  "slots": {
    "clientName": {
      "selector": "[data-slot='clientName']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 40,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Nombre del cliente en la cabecera. Sin cliente, la caja queda vacía y la página no se mueve; nunca un nombre inventado. El logo llega con la portada sellada de TASK-1888."
    },
    "chapterTab": {
      "selector": "[data-slot='chapterTab']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 2,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Número del capítulo en el canto («01»). Sin capítulo, la pestaña no se dibuja."
    },
    "runningSection": {
      "selector": "[data-slot='runningSection']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 44,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Sección de la página («Resumen ejecutivo»)."
    },
    "runningPeriod": {
      "selector": "[data-slot='runningPeriod']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Período y comparación («Agosto 2026 · contra julio 2026»)."
    },
    "eyebrow": {
      "selector": "[data-slot='eyebrow']",
      "type": "object",
      "required": true,
      "shape": {
        "icon": {
          "type": "string",
          "required": false,
          "resolver": "report-icon",
          "values": [
            "bars",
            "clicks",
            "impressions",
            "ctr",
            "search",
            "target",
            "link",
            "trend",
            "steps",
            "grid",
            "donut",
            "layers",
            "numbers"
          ]
        },
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 32,
          "maxLines": 1
        }
      },
      "notes": "Antetítulo de la figura con su ícono (escalera, `steps`)."
    },
    "keyFigure": {
      "selector": "[data-slot='keyFigure']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 12,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Cifra principal de la figura: `readings[].keyFigure.value` del plan (formateador canónico). Nunca calculada en la plantilla. En la cascada, sin lectura del plan, el cambio con signo entre los dos totales («+182»)."
    },
    "keyCaption": {
      "selector": "[data-slot='keyCaption']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 110,
        "maxLines": 3,
        "overflow": "reject",
        "allowedTags": [
          "strong"
        ]
      },
      "notes": "Bajada de la cifra: `keyFigure.caption` del plan."
    },
    "conclusion": {
      "selector": "[data-slot='conclusion']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 96,
        "maxLines": 3,
        "overflow": "reject"
      },
      "notes": "Conclusión de la página: `readings[].conclusion` o la afirmación del plan que cita la figura."
    },
    "lead": {
      "selector": "[data-slot='lead']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 170,
        "maxLines": 3,
        "overflow": "reject"
      }
    },
    "figureTitle": {
      "selector": "[data-slot='figureTitle']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 56,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Título de la figura (`chart.title`)."
    },
    "legend": {
      "selector": "[data-slot='legend']",
      "type": "object",
      "required": true,
      "shape": {
        "prior": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "maxLines": 1
        },
        "added": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "maxLines": 1
        },
        "removed": {
          "type": "string",
          "required": false,
          "maxCharacters": 24,
          "maxLines": 1
        },
        "current": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "maxLines": 1
        }
      },
      "notes": "Rótulo del total anterior y del actual (de los pasos `isTotal` del plan), «Sumó» y —sólo si algún paso resta— «Restó»."
    },
    "waterfallSteps": {
      "selector": "[data-slot='waterfallSteps']",
      "type": "array",
      "required": true,
      "consumer": "validation-only",
      "constraints": {
        "minItems": 3,
        "maxItems": 10
      },
      "item": {
        "type": "object",
        "shape": {
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 48,
            "maxLines": 2
          },
          "value": {
            "type": "string",
            "required": true,
            "maxCharacters": 12,
            "maxLines": 1
          },
          "kind": {
            "type": "enum",
            "required": true,
            "values": [
              "start",
              "add",
              "remove",
              "end"
            ]
          }
        }
      },
      "notes": "Filas de la cascada (las dibuja el hook): el total anterior (`start`), los aportes con signo impreso (`add` «+96», `remove` «−23») y el total actual (`end`). Cada barra sale de su cifra impresa; si el inicial más los pasos no da el final, la figura no se dibuja. Hasta 8 pasos intermedios: una cascada no se pagina. Rótulos de hasta dos líneas.",
      "example": [
        {
          "label": "Julio",
          "value": "1.102",
          "kind": "start"
        },
        {
          "label": "Servicios",
          "value": "+96",
          "kind": "add"
        },
        {
          "label": "Home",
          "value": "−23",
          "kind": "remove"
        },
        {
          "label": "Agosto",
          "value": "1.175",
          "kind": "end"
        }
      ]
    },
    "note": {
      "selector": "[data-slot='note']",
      "type": "object",
      "required": false,
      "shape": {
        "text": {
          "type": "string",
          "required": true,
          "maxCharacters": 120,
          "maxLines": 1
        }
      },
      "notes": "Nota de lectura bajo la figura («El eje empieza en cero…»)."
    },
    "provenance": {
      "selector": "[data-slot='provenance']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 3
      },
      "item": {
        "type": "object",
        "shape": {
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 16,
            "maxLines": 1
          },
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 96,
            "maxLines": 2
          }
        }
      },
      "notes": "Unidad, fuente y cobertura de la figura."
    },
    "closing": {
      "selector": "[data-slot='closing']",
      "type": "array",
      "required": false,
      "constraints": {
        "minItems": 1,
        "maxItems": 2
      },
      "item": {
        "type": "object",
        "shape": {
          "kind": {
            "type": "string",
            "required": true,
            "resolver": "report-closing-icon",
            "values": [
              "measure",
              "action"
            ]
          },
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 40,
            "maxLines": 1
          },
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 190,
            "maxLines": 4
          },
          "signature": {
            "type": "string",
            "required": false,
            "maxCharacters": 40,
            "maxLines": 1
          }
        }
      },
      "notes": "Lo que significa / Próximo paso: `readings[].meaning` y `nextStep` del plan. Sin próximo paso, el panel lleva una sola columna."
    },
    "footerEdition": {
      "selector": "[data-slot='footerEdition']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "«Insights · Informe de <período>»."
    },
    "footerContact": {
      "selector": "[data-slot='footerContact']",
      "type": "object",
      "required": true,
      "shape": {
        "address": {
          "type": "string",
          "required": true,
          "maxCharacters": 72,
          "maxLines": 1
        },
        "phone": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "maxLines": 1
        }
      },
      "notes": "Desde EFEONCE_CONTACT (dirección de presentación y teléfono de Chile)."
    },
    "fixed-urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "agentMayOverride": false,
      "note": "template-owned: el HTML ya lo trae."
    },
    "folio": {
      "selector": "[data-slot='folio']",
      "type": "object",
      "required": true,
      "shape": {
        "page": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        },
        "total": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        }
      },
      "notes": "«NN / total»: ambos del plan de páginas de la misma composición (paginateFlow), nunca un número fijo."
    }
  }
}
