{
  "template": "ReportFigureDonutPage",
  "figmaNodeId": null,
  "version": "0.1",
  "note": "TASK-1975 — dona de 2 o 3 partes de un mismo total (canvas Premium-Donut).",
  "viewport": {
    "width": 794,
    "height": 1123
  },
  "slots": {
    "clientName": {
      "selector": "[data-slot='clientName']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 40,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Nombre del cliente en la cabecera. Sin cliente, la caja queda vacía y la página no se mueve; nunca un nombre inventado. El logo llega con la portada sellada de TASK-1888."
    },
    "chapterTab": {
      "selector": "[data-slot='chapterTab']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 2,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Número del capítulo en el canto («01»). Sin capítulo, la pestaña no se dibuja."
    },
    "runningSection": {
      "selector": "[data-slot='runningSection']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 44,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Sección de la página («Resumen ejecutivo»)."
    },
    "runningPeriod": {
      "selector": "[data-slot='runningPeriod']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Período y comparación («Agosto 2026 · contra julio 2026»)."
    },
    "eyebrow": {
      "selector": "[data-slot='eyebrow']",
      "type": "object",
      "required": true,
      "shape": {
        "icon": {
          "type": "string",
          "required": false,
          "resolver": "report-icon",
          "values": [
            "bars",
            "clicks",
            "impressions",
            "ctr",
            "search",
            "target",
            "link",
            "trend",
            "steps",
            "grid",
            "donut",
            "layers",
            "numbers"
          ]
        },
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 32,
          "maxLines": 1
        }
      },
      "notes": "Antetítulo de la figura con su ícono."
    },
    "keyFigure": {
      "selector": "[data-slot='keyFigure']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 12,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Cifra principal de la figura: `readings[].keyFigure.value` del plan (formateador canónico). Nunca calculada en la plantilla."
    },
    "keyCaption": {
      "selector": "[data-slot='keyCaption']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 110,
        "maxLines": 3,
        "overflow": "reject",
        "allowedTags": [
          "strong"
        ]
      },
      "notes": "Bajada de la cifra: `keyFigure.caption` del plan."
    },
    "conclusion": {
      "selector": "[data-slot='conclusion']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 96,
        "maxLines": 3,
        "overflow": "reject"
      },
      "notes": "Conclusión de la página: `readings[].conclusion` o la afirmación del plan que cita la figura."
    },
    "lead": {
      "selector": "[data-slot='lead']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 170,
        "maxLines": 3,
        "overflow": "reject"
      }
    },
    "figureTitle": {
      "selector": "[data-slot='figureTitle']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 56,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Título de la figura (`chart.title`)."
    },
    "donutChannels": {
      "selector": "[data-slot='donutChannels']",
      "type": "object",
      "required": false,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "maxLines": 1
        },
        "channels": {
          "type": "array",
          "required": true,
          "constraints": {
            "minItems": 1,
            "maxItems": 6
          },
          "item": {
            "type": "object",
            "shape": {
              "name": {
                "type": "string",
                "required": true,
                "maxCharacters": 20,
                "maxLines": 1
              },
              "channelId": {
                "type": "string",
                "required": false,
                "resolver": "report-channel-isotype"
              }
            }
          }
        }
      },
      "notes": "Opcional: «Motores medidos» + un disco blanco por canal (isotipo de `insights-shared/channels.ts`, archivo del catálogo). Canal sin isotipo conocido: sólo el nombre. El mapper de TASK-1975 todavía no la emite; sin canales, la fila no se dibuja."
    },
    "donutParts": {
      "selector": "[data-slot='donutParts']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 2,
        "maxItems": 3
      },
      "item": {
        "type": "object",
        "shape": {
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 40,
            "maxLines": 2
          },
          "count": {
            "type": "string",
            "required": true,
            "maxCharacters": 8,
            "maxLines": 1
          },
          "share": {
            "type": "string",
            "required": true,
            "maxCharacters": 6,
            "maxLines": 1
          },
          "tag": {
            "type": "string",
            "required": false,
            "maxCharacters": 16,
            "maxLines": 1
          },
          "role": {
            "type": "enum",
            "required": false,
            "consumer": "validation-only",
            "values": [
              "opportunity",
              "absence"
            ]
          },
          "icon": {
            "type": "enum",
            "required": false,
            "consumer": "validation-only",
            "values": [
              "link",
              "quote",
              "eye-off"
            ]
          },
          "channel": {
            "type": "string",
            "required": false,
            "resolver": "report-stat-channel",
            "notes": "TASK-1996: plataforma de la parte (asistente o motor) → su isotipo oficial (AXIS_PLATFORM_ASSETS). Reemplaza al ícono; sin isotipo conocido se quita el disco y queda el nombre."
          }
        }
      },
      "notes": "Una fila por parte, en el orden del anillo: cuenta impresa (formateador canónico) y participación por restos mayores (suma 100). El anillo sale de la CUENTA y la participación se verifica contra ella; 1 parte o más de 3 no se dibujan (falla cerrado). `role` (opcional): «opportunity» pinta la parte en el tono de oportunidad; «absence», en rayado. `tag` (opcional, independiente del rol): la marca de la fila («Oportunidad»), la pinta el motor; sin `tag`, sin marca. Sin rol, el tono va por orden: actual → oportunidad → anterior (saltando los que un rol ocupa). `icon` (opcional): ícono de trazo de la fila. Los dos los lee el hook.",
      "example": [
        {
          "label": "Parte A",
          "count": "19",
          "share": "38 %"
        },
        {
          "label": "Parte B",
          "count": "31",
          "share": "62 %"
        }
      ]
    },
    "donutCenter": {
      "selector": "[data-slot='donutCenter']",
      "type": "object",
      "required": true,
      "consumer": "validation-only",
      "shape": {
        "value": {
          "type": "string",
          "required": true,
          "maxCharacters": 8,
          "maxLines": 1
        },
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 32,
          "maxLines": 2
        }
      },
      "notes": "Centro del anillo (lo dibuja el hook): si el total ya tiene tarjeta de cifra, la participación de la parte principal y su nombre; si no, el total de las partes y «en total». El rótulo parte en a lo más dos líneas o falla cerrado.",
      "example": {
        "value": "50",
        "label": "en total"
      }
    },
    "note": {
      "selector": "[data-slot='note']",
      "type": "object",
      "required": false,
      "shape": {
        "text": {
          "type": "string",
          "required": true,
          "maxCharacters": 120,
          "maxLines": 1
        }
      },
      "notes": "Nota de lectura bajo la figura. Sin nota del plan, no se dibuja."
    },
    "provenance": {
      "selector": "[data-slot='provenance']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 3
      },
      "item": {
        "type": "object",
        "shape": {
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 16,
            "maxLines": 1
          },
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 96,
            "maxLines": 2
          }
        }
      },
      "notes": "Unidad, fuente y cobertura de la figura."
    },
    "closing": {
      "selector": "[data-slot='closing']",
      "type": "array",
      "required": false,
      "constraints": {
        "minItems": 1,
        "maxItems": 2
      },
      "item": {
        "type": "object",
        "shape": {
          "kind": {
            "type": "string",
            "required": true,
            "resolver": "report-closing-icon",
            "values": [
              "measure",
              "action"
            ]
          },
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 40,
            "maxLines": 1
          },
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 190,
            "maxLines": 4
          },
          "signature": {
            "type": "string",
            "required": false,
            "maxCharacters": 40,
            "maxLines": 1
          }
        }
      },
      "notes": "Lo que significa / Próximo paso: `readings[].meaning` y `nextStep` del plan. Sin próximo paso, el panel lleva una sola columna."
    },
    "footerEdition": {
      "selector": "[data-slot='footerEdition']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "«Insights · Informe de <período>»."
    },
    "footerContact": {
      "selector": "[data-slot='footerContact']",
      "type": "object",
      "required": true,
      "shape": {
        "address": {
          "type": "string",
          "required": true,
          "maxCharacters": 72,
          "maxLines": 1
        },
        "phone": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "maxLines": 1
        }
      },
      "notes": "Desde EFEONCE_CONTACT (dirección de presentación y teléfono de Chile)."
    },
    "fixed-urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "agentMayOverride": false,
      "note": "template-owned: el HTML ya lo trae."
    },
    "folio": {
      "selector": "[data-slot='folio']",
      "type": "object",
      "required": true,
      "shape": {
        "page": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        },
        "total": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        }
      },
      "notes": "«NN / total»: ambos del plan de páginas de la misma composición (paginateFlow), nunca un número fijo."
    }
  }
}
