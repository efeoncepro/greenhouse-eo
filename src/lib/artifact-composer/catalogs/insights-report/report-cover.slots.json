{
  "template": "ReportCoverPage",
  "figmaNodeId": null,
  "version": "0.1",
  "viewport": {
    "width": 794,
    "height": 1123
  },
  "slots": {
    "editionId": {
      "selector": "[data-slot='editionId']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 20,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Identificador público de la edición. Sin él el informe no se puede citar."
    },
    "clientName": {
      "selector": "[data-slot='clientName']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 2,
        "overflow": "reject"
      }
    },
    "reportTitle": {
      "selector": "[data-slot='reportTitle']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 64,
        "maxLines": 3,
        "overflow": "reject"
      }
    },
    "reportSubtitle": {
      "selector": "[data-slot='reportSubtitle']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 150,
        "maxLines": 3,
        "overflow": "reject"
      }
    },
    "periodLabel": {
      "selector": "[data-slot='periodLabel']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 28,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "versionLabel": {
      "selector": "[data-slot='versionLabel']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 10,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "issuedLabel": {
      "selector": "[data-slot='issuedLabel']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 16,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "fixed-urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "agentMayOverride": false,
      "note": "template-owned: el HTML ya lo trae."
    },
    "fixed-contactDetails": {
      "selector": "[data-slot='contactDetails']",
      "type": "fixed-contact-set",
      "required": true,
      "agentMayOverride": false,
      "value": {
        "chilePhone": "+56 9 3732 3064",
        "address": "Dr. Manuel Barros Borgoño 71 OF 1105, Providencia, Chile"
      },
      "note": "Dueño del valor: back-cover-full.slots.json de deck-axis. Pie completo en CADA página, incluida la portada."
    },
    "pageFolio": {
      "selector": "[data-slot='pageFolio']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 8,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Asignado por el plan de páginas ANTES de imprimir."
    }
  }
}
