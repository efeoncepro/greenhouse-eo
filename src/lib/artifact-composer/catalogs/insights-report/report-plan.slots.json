{
  "template": "ReportPlanPage",
  "figmaNodeId": null,
  "version": "0.1",
  "note": "TASK-1889 — plan de acción del canvas aprobado (página `Premium-Plan`).",
  "viewport": {
    "width": 794,
    "height": 1123
  },
  "slots": {
    "clientName": {
      "selector": "[data-slot='clientName']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 40,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Nombre del cliente en la cabecera. Sin cliente, la caja queda vacía y la página no se mueve; nunca un nombre inventado. El logo llega con la portada sellada de TASK-1888."
    },
    "runningSection": {
      "selector": "[data-slot='runningSection']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 44,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Sección de la página («Resumen ejecutivo»)."
    },
    "runningPeriod": {
      "selector": "[data-slot='runningPeriod']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Período y comparación («Agosto 2026 · contra julio 2026»)."
    },
    "eyebrow": {
      "selector": "[data-slot='eyebrow']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 32,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "heroFigure": {
      "selector": "[data-slot='heroFigure']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 3,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Cuántas acciones trae el plan (se cuenta, no se escribe)."
    },
    "heroText": {
      "selector": "[data-slot='heroText']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 64,
        "maxLines": 2,
        "overflow": "reject"
      }
    },
    "title": {
      "selector": "[data-slot='title']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 80,
        "maxLines": 2,
        "overflow": "reject"
      }
    },
    "lead": {
      "selector": "[data-slot='lead']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 140,
        "maxLines": 2,
        "overflow": "reject"
      }
    },
    "columns": {
      "selector": "[data-slot='columns']",
      "type": "object",
      "required": true,
      "shape": {
        "number": {
          "type": "string",
          "required": true,
          "maxCharacters": 2,
          "maxLines": 1
        },
        "action": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "maxLines": 1
        },
        "metric": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "maxLines": 1
        },
        "weeks": {
          "type": "array",
          "required": true,
          "constraints": {
            "minItems": 4,
            "maxItems": 4
          },
          "item": {
            "type": "string"
          }
        }
      },
      "notes": "Encabezados de la tabla del plan, desde el copy."
    },
    "actions": {
      "selector": "[data-slot='actions']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 5
      },
      "item": {
        "type": "object",
        "shape": {
          "number": {
            "type": "string",
            "required": false,
            "resolver": "report-number",
            "consumer": "resolver-only"
          },
          "title": {
            "type": "string",
            "required": true,
            "maxCharacters": 60,
            "maxLines": 2
          },
          "detail": {
            "type": "string",
            "required": true,
            "maxCharacters": 120,
            "maxLines": 2
          },
          "evidence": {
            "type": "string",
            "required": true,
            "maxCharacters": 20,
            "maxLines": 1
          },
          "impactLabel": {
            "type": "string",
            "required": false,
            "maxCharacters": 12,
            "maxLines": 1
          },
          "impact": {
            "type": "string",
            "required": false,
            "resolver": "report-impact-dots",
            "values": [
              "1",
              "2",
              "3"
            ]
          },
          "effortLabel": {
            "type": "string",
            "required": false,
            "maxCharacters": 12,
            "maxLines": 1
          },
          "effort": {
            "type": "string",
            "required": false,
            "resolver": "report-effort-dots",
            "values": [
              "1",
              "2",
              "3"
            ]
          },
          "metric": {
            "type": "string",
            "required": true,
            "maxCharacters": 36,
            "maxLines": 2
          },
          "metricNote": {
            "type": "string",
            "required": false,
            "maxCharacters": 32,
            "maxLines": 1
          },
          "weeks": {
            "type": "string",
            "required": false,
            "resolver": "report-week-span",
            "values": [
              "1-2",
              "1",
              "1-3",
              "1-4",
              "2",
              "2-3",
              "2-4",
              "3",
              "3-4",
              "4"
            ]
          }
        }
      },
      "notes": "Acciones ordenadas por impacto. `weeks` = «N» o «N-M» sobre 4 semanas."
    },
    "closing": {
      "selector": "[data-slot='closing']",
      "type": "array",
      "required": false,
      "constraints": {
        "minItems": 1,
        "maxItems": 2
      },
      "item": {
        "type": "object",
        "shape": {
          "kind": {
            "type": "string",
            "required": true,
            "resolver": "report-closing-icon",
            "values": [
              "measure",
              "action"
            ]
          },
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 40,
            "maxLines": 1
          },
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 200,
            "maxLines": 3
          },
          "signature": {
            "type": "string",
            "required": false,
            "maxCharacters": 40,
            "maxLines": 1
          }
        }
      },
      "notes": "Panel de cierre. Un plan v1 no lo trae: la página compone sin él."
    },
    "footerEdition": {
      "selector": "[data-slot='footerEdition']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "«Insights · Informe de <período>»."
    },
    "footerContact": {
      "selector": "[data-slot='footerContact']",
      "type": "object",
      "required": true,
      "shape": {
        "address": {
          "type": "string",
          "required": true,
          "maxCharacters": 72,
          "maxLines": 1
        },
        "phone": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "maxLines": 1
        }
      },
      "notes": "Desde EFEONCE_CONTACT (dirección de presentación y teléfono de Chile)."
    },
    "fixed-urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "agentMayOverride": false,
      "note": "template-owned: el HTML ya lo trae."
    },
    "folio": {
      "selector": "[data-slot='folio']",
      "type": "object",
      "required": true,
      "shape": {
        "page": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        },
        "total": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        }
      },
      "notes": "«NN / total»: ambos del plan de páginas de la misma composición (paginateFlow), nunca un número fijo."
    }
  }
}
