{
  "template": "ReportReadingPage",
  "figmaNodeId": null,
  "version": "0.1",
  "note": "TASK-1889 — «Nuestra lectura» del canvas aprobado (página `Premium-Lectura`).",
  "viewport": {
    "width": 794,
    "height": 1123
  },
  "slots": {
    "clientName": {
      "selector": "[data-slot='clientName']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 40,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Nombre del cliente en la cabecera. Sin cliente, la caja queda vacía y la página no se mueve; nunca un nombre inventado. El logo llega con la portada sellada de TASK-1888."
    },
    "runningSection": {
      "selector": "[data-slot='runningSection']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 44,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Sección de la página («Resumen ejecutivo»)."
    },
    "runningPeriod": {
      "selector": "[data-slot='runningPeriod']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "Período y comparación («Agosto 2026 · contra julio 2026»)."
    },
    "eyebrow": {
      "selector": "[data-slot='eyebrow']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 32,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "thesis": {
      "selector": "[data-slot='thesis']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 120,
        "maxLines": 3,
        "overflow": "reject"
      }
    },
    "opening": {
      "selector": "[data-slot='opening']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 420,
        "maxLines": 7,
        "overflow": "reject",
        "allowedTags": [
          "strong"
        ]
      },
      "notes": "Párrafo de apertura; su primera letra es la capitular (tipografía, no dato)."
    },
    "blocks": {
      "selector": "[data-slot='blocks']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 3
      },
      "item": {
        "type": "object",
        "shape": {
          "heading": {
            "type": "string",
            "required": true,
            "maxCharacters": 48,
            "maxLines": 1
          },
          "text": {
            "type": "rich-string",
            "required": true,
            "maxCharacters": 420,
            "maxLines": 7,
            "allowedTags": [
              "strong"
            ]
          }
        }
      },
      "notes": "Qué muestran los datos · dónde está la brecha · qué cambia."
    },
    "pullQuote": {
      "selector": "[data-slot='pullQuote']",
      "type": "object",
      "required": false,
      "shape": {
        "text": {
          "type": "string",
          "required": true,
          "maxCharacters": 90,
          "maxLines": 4
        },
        "source": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "maxLines": 1
        }
      }
    },
    "evidenceLabel": {
      "selector": "[data-slot='evidenceLabel']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 24,
        "maxLines": 1,
        "overflow": "reject"
      }
    },
    "evidence": {
      "selector": "[data-slot='evidence']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 8
      },
      "item": {
        "type": "object",
        "shape": {
          "folio": {
            "type": "string",
            "required": true,
            "maxCharacters": 8,
            "maxLines": 1
          },
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 48,
            "maxLines": 2
          }
        }
      },
      "notes": "Cada cifra citada en la lectura, con el folio de la página que la prueba."
    },
    "footerEdition": {
      "selector": "[data-slot='footerEdition']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "notes": "«Insights · Informe de <período>»."
    },
    "footerContact": {
      "selector": "[data-slot='footerContact']",
      "type": "object",
      "required": true,
      "shape": {
        "address": {
          "type": "string",
          "required": true,
          "maxCharacters": 72,
          "maxLines": 1
        },
        "phone": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "maxLines": 1
        }
      },
      "notes": "Desde EFEONCE_CONTACT (dirección de presentación y teléfono de Chile)."
    },
    "fixed-urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "agentMayOverride": false,
      "note": "template-owned: el HTML ya lo trae."
    },
    "folio": {
      "selector": "[data-slot='folio']",
      "type": "object",
      "required": true,
      "shape": {
        "page": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        },
        "total": {
          "type": "string",
          "required": true,
          "maxCharacters": 3,
          "maxLines": 1
        }
      },
      "notes": "«NN / total»: ambos del plan de páginas de la misma composición (paginateFlow), nunca un número fijo."
    }
  }
}
