{
  "template": "OverlayDropReel",
  "version": "0.1",
  "viewport": {
    "width": 1080,
    "height": 1920
  },
  "render": {
    "background": "transparent"
  },
  "slots": {
    "pov": {
      "selector": "[data-slot='pov']",
      "type": "object",
      "required": true,
      "shape": {
        "entry": {
          "type": "string",
          "required": true,
          "maxCharacters": 32,
          "example": "Esto no es un feature."
        },
        "punchLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 18,
          "example": "Es un"
        },
        "punchLast": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "example": "aviso"
        }
      }
    }
  }
}
