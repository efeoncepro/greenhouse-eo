{
  "template": "OverlayDropVlog",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "render": {
    "background": "transparent"
  },
  "slots": {
    "pov": {
      "selector": "[data-slot='pov']",
      "type": "object",
      "required": true,
      "shape": {
        "entry": {
          "type": "string",
          "required": true,
          "maxCharacters": 32,
          "example": "Esto no es un feature."
        },
        "punchLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "example": "Es un"
        },
        "punchLast": {
          "type": "string",
          "required": true,
          "maxCharacters": 10,
          "example": "aviso"
        }
      }
    },
    "about": {
      "selector": "[data-slot='about']",
      "type": "object",
      "required": true,
      "shape": {
        "number": {
          "type": "string",
          "required": true,
          "maxCharacters": 1,
          "example": "2"
        },
        "text": {
          "type": "string",
          "required": true,
          "maxCharacters": 64,
          "example": "La segunda noticia, corta"
        }
      }
    }
  }
}
