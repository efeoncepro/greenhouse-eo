{
  "template": "OverlayCtaVlog",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "render": {
    "background": "transparent"
  },
  "slots": {
    "nextEdition": {
      "selector": "[data-slot='nextEdition']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 4,
        "overflow": "reject"
      },
      "example": "18"
    },
    "invite": {
      "selector": "[data-slot='invite']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 40,
        "overflow": "reject",
        "maxLines": 1
      },
      "example": "Las otras noticias, en el blog de"
    }
  }
}
