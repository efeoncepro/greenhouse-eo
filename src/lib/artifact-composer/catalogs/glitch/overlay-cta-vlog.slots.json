{
  "template": "OverlayCtaVlog",
  "version": "0.2",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "render": {
    "background": "transparent"
  },
  "slots": {
    "closingLine": {
      "selector": "[data-slot='closingLine']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 32,
        "overflow": "reject",
        "maxLines": 1
      },
      "example": "el #18 sale el lunes."
    },
    "invite": {
      "selector": "[data-slot='invite']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 40,
        "overflow": "reject",
        "maxLines": 1
      },
      "example": "Las otras noticias, en el blog de"
    }
  }
}
