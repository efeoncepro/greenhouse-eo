{
  "template": "BlogNewsBanner",
  "version": "0.1",
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "slots": {
    "photo": {
      "selector": "[data-slot='photo']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gx-photo-ref",
          "example": "asset-ref:photo:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 240,
          "resolver": "gx-alt",
          "example": "Foto de la noticia, en duotono navy."
        }
      }
    },
    "credit": {
      "selector": "[data-slot='credit']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 90,
        "overflow": "reject",
        "maxLines": 1
      },
      "example": "Foto: Glitch (imagen sintética de ejemplo)"
    },
    "newsNumber": {
      "selector": "[data-slot='newsNumber']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 1,
        "overflow": "reject"
      },
      "example": "3"
    },
    "section": {
      "selector": "[data-slot='section']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 16,
        "overflow": "reject"
      },
      "example": "Marketing"
    },
    "edition": {
      "selector": "[data-slot='edition']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 4,
        "overflow": "reject"
      },
      "example": "17"
    },
    "bytes": {
      "selector": "[data-gx-bytes]",
      "type": "string",
      "required": false,
      "consumer": "validation-only",
      "example": "[]"
    },
    "photoLicense": {
      "selector": "[data-gx-root]",
      "type": "string",
      "required": true,
      "consumer": "validation-only",
      "example": "generated:glitch-probe"
    },
    "faces": {
      "selector": "[data-gx-root]",
      "type": "string",
      "required": true,
      "consumer": "validation-only",
      "example": "[]"
    }
  }
}
