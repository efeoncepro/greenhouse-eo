{
  "template": "OverlayHeaderReel",
  "version": "0.1",
  "viewport": {
    "width": 1080,
    "height": 1920
  },
  "render": {
    "background": "transparent",
    "minInkTileRatio": 0.005
  },
  "slots": {
    "progress": {
      "selector": "[data-slot='progress']",
      "type": "object",
      "required": true,
      "shape": {
        "step": {
          "type": "string",
          "required": true,
          "resolver": "gx-progress-3",
          "example": "2"
        },
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 5,
          "example": "2 / 3"
        }
      }
    }
  }
}
