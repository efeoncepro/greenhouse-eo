{
  "template": "BlogSquarePhoto",
  "version": "0.1",
  "viewport": {
    "width": 1080,
    "height": 1080
  },
  "slots": {
    "photo": {
      "selector": "[data-slot='photo']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gx-photo-ref",
          "example": "asset-ref:photo:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 240,
          "resolver": "gx-alt",
          "example": "Foto de la noticia de portada, en duotono navy."
        }
      }
    },
    "credit": {
      "selector": "[data-slot='credit']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 90,
        "maxLines": 1,
        "overflow": "reject"
      },
      "example": "Foto: Glitch (imagen sintética de ejemplo)"
    },
    "edition": {
      "selector": "[data-slot='edition']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 4,
        "overflow": "reject"
      },
      "example": "17"
    },
    "outlet": {
      "selector": "[data-slot='outlet']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "maxLines": 1,
        "overflow": "reject"
      },
      "example": "Medio · 28 sep"
    },
    "headline": {
      "selector": "[data-slot='headline']",
      "type": "object",
      "required": true,
      "shape": {
        "entry": {
          "type": "string",
          "required": true,
          "maxCharacters": 28,
          "example": "Te responden antes"
        },
        "punchLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 30,
          "example": "del"
        },
        "punchLast": {
          "type": "string",
          "required": true,
          "maxCharacters": 14,
          "example": "clic."
        }
      }
    },
    "bytes": {
      "selector": "[data-gx-bytes]",
      "type": "string",
      "required": false,
      "consumer": "validation-only",
      "example": "[]"
    },
    "previousCoverTemplate": {
      "selector": "[data-gx-root]",
      "type": "enum",
      "required": true,
      "consumer": "validation-only",
      "values": {
        "A": "Portada A",
        "B": "Portada B",
        "C": "Portada C",
        "none": "Primera edición compuesta"
      },
      "example": "C"
    },
    "photoLicense": {
      "selector": "[data-gx-root]",
      "type": "string",
      "required": true,
      "consumer": "validation-only",
      "example": "generated:glitch-probe"
    },
    "faces": {
      "selector": "[data-gx-root]",
      "type": "string",
      "required": true,
      "consumer": "validation-only",
      "example": "[]"
    }
  }
}
