{
  "template": "OverlayNewsVlog",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "render": {
    "background": "transparent"
  },
  "slots": {
    "section": {
      "selector": "[data-slot='section']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 16,
        "overflow": "reject",
        "maxLines": 1
      },
      "example": "Marketing"
    },
    "headline": {
      "selector": "[data-slot='headline']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 110,
        "overflow": "reject",
        "maxLines": 2
      },
      "example": "El titular de la noticia, tal como lo cuentan los medios"
    },
    "source": {
      "selector": "[data-slot='source']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 40,
        "overflow": "reject",
        "maxLines": 1
      },
      "example": "Medio"
    }
  }
}
