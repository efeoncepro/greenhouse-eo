{
  "template": "OverlayLowerThirdReel",
  "version": "0.1",
  "viewport": {
    "width": 1080,
    "height": 1920
  },
  "render": {
    "background": "transparent",
    "minInkTileRatio": 0.005
  },
  "slots": {
    "person": {
      "selector": "[data-slot='person']",
      "type": "object",
      "required": true,
      "shape": {
        "kind": {
          "type": "string",
          "required": true,
          "resolver": "gx-person-kind",
          "example": "host"
        },
        "tag": {
          "type": "string",
          "required": true,
          "maxCharacters": 28,
          "example": "AL AIRE · GLITCH #17"
        },
        "name": {
          "type": "string",
          "required": true,
          "maxCharacters": 28,
          "example": "Julio Reyes"
        },
        "role": {
          "type": "string",
          "required": true,
          "maxCharacters": 56,
          "example": "Managing & GTM Director · Efeonce"
        }
      }
    }
  }
}
