{
  "template": "ReelCover",
  "version": "0.1",
  "viewport": {
    "width": 1080,
    "height": 1920
  },
  "slots": {
    "host": {
      "selector": "[data-slot='host']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gx-photo-ref",
          "example": "asset-ref:photo:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 240,
          "resolver": "gx-alt",
          "example": "El host de Glitch, con un gesto fuerte."
        }
      }
    },
    "edition": {
      "selector": "[data-slot='edition']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 4,
        "overflow": "reject"
      },
      "example": "17"
    },
    "headline": {
      "selector": "[data-slot='headline']",
      "type": "object",
      "required": true,
      "shape": {
        "entry": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "example": "3 noticias."
        },
        "punchLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 18,
          "example": "Un solo"
        },
        "punchLast": {
          "type": "string",
          "required": true,
          "maxCharacters": 10,
          "example": "aviso"
        }
      }
    },
    "bytes": {
      "selector": "[data-gx-bytes]",
      "type": "string",
      "required": false,
      "consumer": "validation-only",
      "example": "[]"
    },
    "photoLicense": {
      "selector": "[data-gx-root]",
      "type": "string",
      "required": true,
      "consumer": "validation-only",
      "example": "owned:glitch-host-probe"
    },
    "faces": {
      "selector": "[data-gx-root]",
      "type": "string",
      "required": true,
      "consumer": "validation-only",
      "example": "[]"
    }
  }
}
