{
  "template": "BlogSquareMosaic",
  "version": "0.1",
  "viewport": {
    "width": 1080,
    "height": 1080
  },
  "slots": {
    "edition": {
      "selector": "[data-slot='edition']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 4,
        "overflow": "reject"
      },
      "example": "17"
    },
    "headline": {
      "selector": "[data-slot='headline']",
      "type": "object",
      "required": true,
      "shape": {
        "entry": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "example": "Ocho noticias."
        },
        "punchLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 48,
          "example": "Un mismo aviso: el search ya no es"
        },
        "punchLast": {
          "type": "string",
          "required": true,
          "maxCharacters": 14,
          "example": "tuyo."
        }
      }
    },
    "card1": {
      "selector": "[data-slot='card1']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gx-photo-ref",
          "example": "asset-ref:photo:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 240,
          "resolver": "gx-alt",
          "example": "Foto de la noticia, en duotono navy."
        },
        "section": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "example": "Marketing"
        },
        "pov": {
          "type": "string",
          "required": true,
          "maxCharacters": 48,
          "example": "El funnel ahora lo recorre un agente."
        }
      }
    },
    "card2": {
      "selector": "[data-slot='card2']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gx-photo-ref",
          "example": "asset-ref:photo:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 240,
          "resolver": "gx-alt",
          "example": "Foto de la noticia, en duotono navy."
        },
        "section": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "example": "Marketing"
        },
        "pov": {
          "type": "string",
          "required": true,
          "maxCharacters": 48,
          "example": "El funnel ahora lo recorre un agente."
        }
      }
    },
    "card3": {
      "selector": "[data-slot='card3']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gx-photo-ref",
          "example": "asset-ref:photo:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 240,
          "resolver": "gx-alt",
          "example": "Foto de la noticia, en duotono navy."
        },
        "section": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "example": "Marketing"
        },
        "pov": {
          "type": "string",
          "required": true,
          "maxCharacters": 48,
          "example": "El funnel ahora lo recorre un agente."
        }
      }
    },
    "card4": {
      "selector": "[data-slot='card4']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gx-photo-ref",
          "example": "asset-ref:photo:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 240,
          "resolver": "gx-alt",
          "example": "Foto de la noticia, en duotono navy."
        },
        "section": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "example": "Marketing"
        },
        "pov": {
          "type": "string",
          "required": true,
          "maxCharacters": 48,
          "example": "El funnel ahora lo recorre un agente."
        }
      }
    },
    "credit": {
      "selector": "[data-slot='credit']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 140,
        "overflow": "reject",
        "maxLines": 1
      },
      "example": "Fotos: Glitch (imágenes sintéticas de ejemplo)"
    },
    "bytes": {
      "selector": "[data-gx-bytes]",
      "type": "string",
      "required": false,
      "consumer": "validation-only",
      "example": "[]"
    },
    "previousCoverTemplate": {
      "selector": "[data-gx-root]",
      "type": "enum",
      "required": true,
      "consumer": "validation-only",
      "values": {
        "A": "Portada A",
        "B": "Portada B",
        "C": "Portada C",
        "none": "Primera edición compuesta"
      },
      "example": "B"
    },
    "photoLicense": {
      "selector": "[data-gx-root]",
      "type": "string",
      "required": true,
      "consumer": "validation-only",
      "example": "generated:glitch-probe"
    },
    "faces": {
      "selector": "[data-gx-root]",
      "type": "string",
      "required": true,
      "consumer": "validation-only",
      "example": "[]"
    }
  }
}
