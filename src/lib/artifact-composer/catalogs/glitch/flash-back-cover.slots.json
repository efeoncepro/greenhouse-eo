{
  "template": "FlashBackCover",
  "version": "0.1",
  "viewport": {
    "width": 1080,
    "height": 1350
  },
  "slots": {
    "headline": {
      "selector": "[data-slot='headline']",
      "type": "object",
      "required": true,
      "shape": {
        "entry": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "example": "El micrófono"
        },
        "punch": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "example": "se cierra"
        }
      }
    },
    "closingLine": {
      "selector": "[data-slot='closingLine']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 40,
        "maxLines": 2,
        "allowedTags": [
          "br"
        ],
        "overflow": "reject"
      },
      "example": "léelo completo<br>en nuestro blog."
    },
    "note": {
      "selector": "[data-slot='note']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 80,
        "maxLines": 2,
        "allowedTags": [
          "br"
        ],
        "overflow": "reject"
      },
      "example": "Cada lunes en tu correo, gratis.<br>El enlace, en el primer comentario."
    }
  }
}
