{
  "template": "InteriorLens",
  "version": "0.1",
  "viewport": {
    "width": 1080,
    "height": 1350
  },
  "slots": {
    "edition": {
      "selector": "[data-slot='edition']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 4,
        "overflow": "reject"
      },
      "example": "17"
    },
    "photo": {
      "selector": "[data-slot='photo']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gx-photo-ref",
          "example": "asset-ref:photo:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 240,
          "resolver": "gx-alt",
          "example": "Foto de la noticia, en duotono navy."
        }
      }
    },
    "credit": {
      "selector": "[data-slot='credit']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 90,
        "overflow": "reject",
        "maxLines": 1
      },
      "example": "Foto: Glitch (imagen sintética de ejemplo)"
    },
    "newsNumber": {
      "selector": "[data-slot='newsNumber']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 1,
        "overflow": "reject"
      },
      "example": "3"
    },
    "outlet": {
      "selector": "[data-slot='outlet']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 48,
        "overflow": "reject",
        "maxLines": 1
      },
      "example": "Medio · 30 sep"
    },
    "section": {
      "selector": "[data-slot='section']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 16,
        "overflow": "reject"
      },
      "example": "Marketing"
    },
    "headline": {
      "selector": "[data-slot='headline']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 90,
        "overflow": "reject",
        "maxLines": 3
      },
      "example": "Un modelo nuevo lee planillas completas sin copiar y pegar"
    },
    "pov": {
      "selector": "[data-slot='pov']",
      "type": "object",
      "required": true,
      "shape": {
        "entry": {
          "type": "string",
          "required": true,
          "maxCharacters": 34,
          "example": "Todos miraron al que hablaba."
        },
        "punch": {
          "type": "string",
          "required": true,
          "maxCharacters": 30,
          "example": "Nosotros, al detalle."
        }
      }
    },
    "why": {
      "selector": "[data-slot='why']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 160,
        "overflow": "reject",
        "maxLines": 2
      },
      "example": "El porqué en dos líneas: qué cambia para una marca y qué conviene hacer esta semana."
    },
    "progress": {
      "selector": "[data-slot='progress']",
      "type": "object",
      "required": true,
      "shape": {
        "step": {
          "type": "string",
          "required": true,
          "resolver": "gx-progress",
          "example": "3"
        },
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 6,
          "example": "3 / 8"
        }
      }
    },
    "bytes": {
      "selector": "[data-gx-bytes]",
      "type": "string",
      "required": false,
      "consumer": "validation-only",
      "example": "[]"
    },
    "lens": {
      "selector": "[data-slot='lens']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gx-photo-ref",
          "example": "asset-ref:photo:probe"
        },
        "x": {
          "type": "string",
          "required": true,
          "resolver": "gx-lens-x",
          "example": "930"
        },
        "y": {
          "type": "string",
          "required": true,
          "resolver": "gx-lens-y",
          "example": "493"
        }
      }
    }
  }
}
