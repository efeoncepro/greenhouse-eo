{
  "template": "BackCoverFull",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "partnerBadge": {
      "selector": "[data-slot='partnerBadge']",
      "type": "asset",
      "required": false,
      "audience": "client_facing",
      "resolver": "partner-badge-asset",
      "agentInput": "assetId",
      "agentMayOverridePresentation": false,
      "constraints": {
        "allowedKinds": ["brand-badge"],
        "fit": "contain",
        "noHumanPortrait": true,
        "overflow": "reject"
      },
      "note": "Credencial opcional de partner; se muestra solo cuando el deck la declara. Clave cerrada a través del resolver `partner-badge-asset` (mismo trato que un logo de cliente: una acreditación que no se tiene no se puede presentar). Sin declararla, el renderer BORRA el nodo y la contraportada queda idéntica a la de siempre — por eso NO hace falta una segunda contraportada. La plantilla la ubica arriba a la derecha sin competir con la firma de Efeonce."
    },
    "efeonceLogo": {
      "selector": "[data-slot='efeonceLogo']",
      "type": "fixed-asset",
      "required": true,
      "resolver": "efeonce-negative-logo",
      "agentMayOverride": false,
      "note": "template-owned: el HTML ya lo trae; el plan no lo declara."
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "resolver": "efeonce-url-bubble-luminosity",
      "agentMayOverride": false,
      "note": "template-owned: el HTML ya lo trae; el plan no lo declara."
    },
    "socialLinks": {
      "selector": "[data-slot='socialLinks']",
      "type": "fixed-social-set",
      "required": true,
      "resolver": "efeonce-social-set",
      "agentMayOverride": false
    },
    "contactDetails": {
      "selector": "[data-slot='contactDetails']",
      "type": "fixed-contact-set",
      "required": true,
      "resolver": "efeonce-contact-set",
      "agentMayOverride": false,
      "value": {
        "email": "sales@efeoncepro.com",
        "chilePhone": "+56 9 3732 3064",
        "usPhone": "+1 (239) 235-2073",
        "address": "Dr. Manuel Barros Borgoño 71 OF 1105, Providencia, Chile"
      }
    }
  },
  "presentation": {
    "allForegroundElements": "mix-blend-mode: luminosity",
    "background": "canonical Efeonce back-cover gradient"
  }
}
