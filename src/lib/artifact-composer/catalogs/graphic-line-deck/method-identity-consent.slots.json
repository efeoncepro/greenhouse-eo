          "top": "--gl-mic-source-top=580px"
        },
        {
          "kicker": "Fuente",
          "name": "App",
          "top": "--gl-mic-source-top=690px"
        }
      ]
    },
    "profile": {
      "selector": "[data-slot='profile']",
      "type": "object",
      "required": true,
      "shape": {
        "icon": {
          "type": "string",
          "required": true,
          "resolver": "gl-file-ref",
          "example": "asset-ref:file:probe"
        },
        "kicker": {
          "type": "string",
          "required": true,
          "maxCharacters": 22,
          "example": "Perfil unificado"
        },
        "title": {
          "type": "string",
          "required": true,
          "maxCharacters": 22,
          "example": "Una persona, 5 fuentes"
        }
      }
    },
    "channels": {
      "selector": "[data-slot='channels']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 4,
        "maxItems": 4,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "channel": {
            "type": "string",
            "required": true,
            "maxCharacters": 14,
            "example": "Email"
          },
          "purpose": {
            "type": "string",
            "required": true,
            "maxCharacters": 18,
            "example": "Marketing"
          },
          "mark": {
            "type": "string",
            "required": true,
            "maxCharacters": 1,
            "example": "✓"
          },
          "state": {
            "type": "string",
            "required": true,
            "resolver": "gl-state",
            "example": "yes"
          }
        }
      },
      "example": [
        {
          "channel": "Email",
          "purpose": "Marketing",
          "mark": "✓",
          "state": "yes"
        },
        {
          "channel": "WhatsApp",
          "purpose": "Servicio",
          "mark": "✓",
          "state": "yes"
        },
        {
          "channel": "SMS",
          "purpose": "Marketing",
          "mark": "—",
          "state": "no"
        },
        {
          "channel": "Llamada",
          "purpose": "Ventas",
          "mark": "✓",
          "state": "yes"
        }
      ]
    },
    "activations": {
      "selector": "[data-slot='activations']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 3,
        "maxItems": 3,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "icon": {
            "type": "string",
            "required": true,
            "resolver": "gl-file-ref",
            "example": "asset-ref:file:probe"
          },
          "title": {
            "type": "string",
            "required": true,
            "maxCharacters": 31,
            "example": "Journey"
          },
          "detail": {
            "type": "string",
            "required": true,
            "maxCharacters": 21,
            "example": "Sólo con email ✓"
          },
          "role": {
            "type": "string",
            "required": true,
            "resolver": "gl-item-role",
            "example": "lead"
          },
          "top": {
            "type": "string",
            "required": true,
            "resolver": "gl-css",
            "example": "--gl-mic-act-top=250px"
          }
        }
      },
      "example": [
        {
          "icon": "asset-ref:file:probe",
          "title": "Journey",
          "detail": "Sólo con email ✓",
          "role": "lead",
          "top": "--gl-mic-act-top=250px"
        },
        {
          "icon": "asset-ref:file:probe",
          "title": "Agente de servicio",
          "detail": "Por WhatsApp ✓",
          "role": "rest",
          "top": "--gl-mic-act-top=400px"
        },
        {
          "icon": "asset-ref:file:probe",
          "title": "Siguiente acción",
          "detail": "Llamada del ejecutivo",
          "role": "rest",
          "top": "--gl-mic-act-top=710px"
        }
      ]
    },
    "selection": {
      "selector": "[data-slot='selection']",
      "type": "object",
      "required": false,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "consumer": "validation-only",
          "example": "Cliente"
        },
        "anchor": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "bottom-end"
        },
        "participantKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "role"
        },
        "scale": {
          "type": "number",
          "required": false,
          "consumer": "validation-only",
          "example": 1
        },
        "targetKind": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "object"
        },
        "variant": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "eight-handles"
        },
        "padding": {
          "type": "string",
          "required": false,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "compact"
        },
        "overlay": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "none"
        }
      }
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-source.svg"
    }
  }
}
