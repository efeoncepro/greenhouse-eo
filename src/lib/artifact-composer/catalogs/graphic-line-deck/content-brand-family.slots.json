{
  "template": "ContentBrandFamily",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "engine"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 324
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 390
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 124
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-leading=0.95"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-tracking=-0.035em"
        },
        "answerInset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-inset=0px"
        },
        "questionWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-question-width=640px"
        },
        "bodyTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyTop",
          "example": 666
        },
        "bodyPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyPx",
          "example": 28
        },
        "bodyWidth": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyWidth",
          "example": 640
        },
        "lumWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lum-width=160px"
        },
        "lumBottom": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lum-bottom=62px"
        },
        "svBg": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-bg-color=#091951"
        },
        "svSoft": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-soft-color=#cfe4fa"
        },
        "svHalo": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-halo-color=#72ded8"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 28,
          "example": "¿Qué hay dentro?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "resolver": "gl-answer",
          "example": "piezas"
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 20,
          "example": "Cuatro"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 169,
        "maxLines": 4,
        "overflow": "reject"
      },
      "example": "SV360 es SEO y AEO en un solo sistema: una capacidad, un proceso, un entregable y una edición mensual, todo firmado por <strong>Efeonce</strong>."
    },
    "productMark": {
      "selector": "[data-slot='productMark']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-file-ref",
          "example": "asset-ref:file:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "resolver": "gl-alt",
          "maxCharacters": 40,
          "example": "SV360 · Search Visibility 360"
        },
        "left": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-pmk-left=140px"
        },
        "top": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-pmk-top=250px"
        },
        "height": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-pmk-height=44px"
        }
      }
    },
    "family": {
      "selector": "[data-slot='family']",
      "type": "object",
      "required": true,
      "shape": {
        "kicker": {
          "type": "string",
          "required": true,
          "maxCharacters": 71,
          "example": "El producto · SEO + AEO"
        },
        "lockup": {
          "type": "string",
          "required": true,
          "resolver": "gl-file-ref",
          "example": "asset-ref:file:probe"
        },
        "lockupAlt": {
          "type": "string",
          "required": true,
          "resolver": "gl-alt",
          "maxCharacters": 60,
          "example": "Efeonce | Search Visibility 360"
        }
      }
    },
    "pieces": {
      "selector": "[data-slot='pieces']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 4,
        "maxItems": 4,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "mark": {
            "type": "string",
            "required": true,
            "resolver": "gl-file-ref",
            "example": "asset-ref:file:probe"
          },
          "markAlt": {
            "type": "string",
            "required": true,
            "resolver": "gl-alt",
            "maxCharacters": 40,
            "example": "Efeonce | AEO"
          },
          "role": {
            "type": "string",
            "required": true,
            "maxCharacters": 25,
            "example": "Capacidad"
          },
          "description": {
            "type": "string",
            "required": true,
            "maxCharacters": 74,
            "example": "Que la IA te encuentre, te entienda y te recomiende."
          }
        }
      }
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-source.svg"
    }
  }
}
