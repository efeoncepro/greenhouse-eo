{
  "template": "ContentDayProgress",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 110
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 196
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 330
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 176
        },
        "bodyTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyTop",
          "example": 690
        },
        "bodyPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyPx",
          "example": 26
        },
        "bodyWidth": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyWidth",
          "example": 380
        },
        "questionWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-question-width=470px"
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-answer-leading=0.9"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-answer-tracking=-0.05em"
        },
        "answerInset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-answer-inset=-8px"
        },
        "answerShadowY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-answer-shadow-y=10px"
        },
        "answerShadowBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-answer-shadow-blur=60px"
        },
        "answerShadowOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-answer-shadow-opacity=35%"
        },
        "perspective": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-perspective=1600px"
        },
        "originX": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-origin-x=1200px"
        },
        "originY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-origin-y=480px"
        },
        "deepY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-deep-y=50px"
        },
        "deepBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-deep-blur=110px"
        },
        "deepColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-cd-deep-color=#000610"
        },
        "deepOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-deep-opacity=75%"
        },
        "deepEdge": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-deep-edge=16%"
        },
        "deepHaloBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-deep-halo-blur=90px"
        },
        "deepHaloOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-deep-halo-opacity=22%"
        },
        "haloColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-cd-halo-color=#72ded8"
        },
        "reflectGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-reflect-gap=14px"
        },
        "reflectFrom": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-reflect-from=72%"
        },
        "reflectOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-reflect-opacity=16%"
        },
        "docFill": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-cd-doc-color=#ffffff"
        },
        "docInk": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-cd-doc-ink-color=#0b1f33"
        },
        "docMuted": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-cd-doc-muted-color=#5f6b7a"
        },
        "docRule": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-cd-doc-rule-color=#e3e8ee"
        },
        "docChip": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-cd-doc-chip-color=#f5f7fa"
        },
        "docShadowColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-cd-doc-shadow-color=#000610"
        },
        "docShadowY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-doc-shadow-y=50px"
        },
        "docShadowBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-doc-shadow-blur=110px"
        },
        "docShadowOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-doc-shadow-opacity=75%"
        },
        "docHaloBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-doc-halo-blur=90px"
        },
        "docHaloOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-doc-halo-opacity=22%"
        },
        "docEdgeOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cd-doc-edge-opacity=16%"
        },
        "planLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cdp-plan-left=650px"
        },
        "planTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cdp-plan-top=200px"
        },
        "planWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cdp-plan-width=540px"
        },
        "planRadius": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cdp-plan-radius=22px"
        },
        "planRotateY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cdp-plan-rotate-y=22deg"
        },
        "planRotateX": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cdp-plan-rotate-x=6deg"
        },
        "planOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cdp-plan-opacity=0.96"
        },
        "reviewLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cdp-review-left=1070px"
        },
        "reviewTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cdp-review-top=170px"
        },
        "reviewWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cdp-review-width=720px"
        },
        "reviewRadius": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cdp-review-radius=24px"
        },
        "reviewRotateY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cdp-review-rotate-y=-13deg"
        },
        "reviewRotateX": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cdp-review-rotate-x=6deg"
        },
        "pieceWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cdp-piece-width=340px"
        },
        "pieceHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cdp-piece-height=425px"
        },
        "pinLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cdp-pin-left=206px"
        },
        "pinTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cdp-pin-top=84px"
        },
        "pinSize": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cdp-pin-size=38px"
        },
        "accentColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-cdp-accent-color=#36c8bf"
        }
      }
    },
    "stage": {
      "selector": "[data-slot='stage']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "platform": {
      "selector": "[data-slot='platform']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "beam": {
      "selector": "[data-slot='beam']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "plan": {
      "selector": "[data-slot='plan']",
      "type": "object",
      "required": true,
      "shape": {
        "tool": {
          "type": "string",
          "required": true,
          "resolver": "gl-file-ref",
          "example": "asset-ref:file:probe"
        },
        "kicker": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "example": "En Notion"
        },
        "title": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "example": "Plan de la campaña"
        },
        "meta": {
          "type": "string",
          "required": true,
          "maxCharacters": 14,
          "example": "Semana 3 de 6"
        }
      }
    },
    "columns": {
      "selector": "[data-slot='columns']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 3,
        "maxItems": 3,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "name": {
            "type": "string",
            "required": true,
            "maxCharacters": 16
          },
          "cards": {
            "type": "array",
            "required": true,
            "item": {
              "type": "object",
              "shape": {
                "role": {
                  "type": "string",
                  "required": true,
                  "resolver": "gl-item-role"
                },
                "title": {
                  "type": "string",
                  "required": true,
                  "maxCharacters": 24
                },
                "tag": {
                  "type": "string",
                  "required": true,
                  "maxCharacters": 24
                }
              }
            }
          }
        }
      },
      "example": [
        {
          "name": "En curso",
          "cards": [
            {
              "role": "rest",
              "title": "Guion del video",
              "tag": "Producción"
            },
            {
              "role": "rest",
              "title": "Adaptaciones a redes",
              "tag": "Contenido"
            }
          ]
        },
        {
          "name": "En revisión",
          "cards": [
            {
              "role": "lead",
              "title": "Key visual",
              "tag": "Esperando tu visto bueno"
            }
          ]
        },
        {
          "name": "Listo",
          "cards": [
            {
              "role": "rest",
              "title": "Brief aprobado",
              "tag": "Estrategia"
            },
            {
              "role": "rest",
              "title": "Moodboard",
              "tag": "Dirección de arte"
            }
          ]
        }
      ]
    },
    "review": {
      "selector": "[data-slot='review']",
      "type": "object",
      "required": true,
      "shape": {
        "tool": {
          "type": "string",
          "required": true,
          "resolver": "gl-file-ref",
          "example": "asset-ref:file:probe"
        },
        "kicker": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "example": "En Frame.io"
        },
        "title": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "example": "Key visual"
        }
      }
    },
    "versions": {
      "selector": "[data-slot='versions']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 3,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "role": {
            "type": "string",
            "required": true,
            "resolver": "gl-item-role"
          },
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 4
          }
        }
      },
      "example": [
        {
          "role": "rest",
          "label": "v1"
        },
        {
          "role": "lead",
          "label": "v2"
        }
      ]
    },
    "piece": {
      "selector": "[data-slot='piece']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt",
          "example": "Descripción de la imagen"
        },
        "pin": {
          "type": "string",
          "required": true,
          "maxCharacters": 2,
          "example": "1"
        }
      }
    },
    "comments": {
      "selector": "[data-slot='comments']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 2,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "role": {
            "type": "string",
            "required": true,
            "resolver": "gl-item-role"
          },
          "mark": {
            "type": "string",
            "required": false,
            "maxCharacters": 2
          },
          "author": {
            "type": "string",
            "required": true,
            "maxCharacters": 16
          },
          "version": {
            "type": "string",
            "required": true,
            "maxCharacters": 8
          },
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 32
          }
        }
      },
      "example": [
        {
          "role": "rest",
          "mark": "1",
          "author": "Tú",
          "version": "· v1",
          "text": "¿Podemos subir el logo?"
        },
        {
          "role": "lead",
          "author": "Efeonce",
          "version": "· v2",
          "text": "Listo, quedó en la v2."
        }
      ]
    },
    "secondary": {
      "selector": "[data-slot='secondary']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 16,
        "maxLines": 1,
        "overflow": "reject"
      },
      "example": "Comentar"
    },
    "cta": {
      "selector": "[data-slot='cta']",
      "type": "object",
      "required": true,
      "shape": {
        "text": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "example": "Aprobar"
        },
        "cursorScale": {
          "type": "number",
          "required": true,
          "consumer": "validation-only",
          "example": 1
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 26,
          "example": "Tu día a día con Efeonce"
        },
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 28,
          "example": "¿Cómo avanza tu proyecto?"
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 18,
          "example": "A la"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "resolver": "gl-answer",
          "example": "vista"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 100,
        "maxLines": 5,
        "overflow": "reject"
      },
      "example": "Sigues el plan en Notion y apruebas cada pieza en Frame.io, comentando <strong>sobre</strong> la imagen."
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-baked-dark.svg"
    }
  }
}
