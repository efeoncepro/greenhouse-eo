{
  "template": "SectionSplit",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "layout": {
          "type": "string",
          "required": true,
          "resolver": "gl-split-layout",
          "example": "corner-top"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 600
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 670
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 120
        },
        "numberTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-number-top=260px"
        },
        "labelTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-label-top=450px"
        },
        "numberPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-number-px=190px"
        },
        "numberWeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-number-wght=300"
        },
        "labelPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-label-px=24px"
        },
        "panelWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-panel-width=960px"
        },
        "panelRadius": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-panel-radius=300px"
        },
        "photoLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-photo-left=660px"
        },
        "photoWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-photo-width=1260px"
        },
        "panelLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-panel-left=0px"
        },
        "columnWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-column-width=820px"
        }
      }
    },
    "indicator": {
      "selector": "[data-slot='indicator']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "photo": {
      "selector": "[data-slot='photo']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt",
          "example": "Una mujer sentada a una mesa oscura mira hacia la ventana, con la mano sobre un cuaderno azul"
        }
      }
    },
    "progress": {
      "selector": "[data-slot='progress']",
      "type": "object",
      "required": true,
      "shape": {
        "number": {
          "type": "string",
          "required": true,
          "maxCharacters": 2,
          "example": "02"
        },
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "example": "Sección 2 de 5"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 34,
          "example": "¿Quién decide el corte?"
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 12,
          "example": ""
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "resolver": "gl-answer",
          "example": "El dato"
        }
      }
    }
  }
}
