    },
    "stage": {
      "selector": "[data-slot='stage']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "platform": {
      "selector": "[data-slot='platform']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 51,
          "example": "El contexto"
        },
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 43,
          "example": "¿Dónde busca tu cliente?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 9,
          "resolver": "gl-answer",
          "example": "En la IA"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 161,
        "maxLines": 6,
        "overflow": "reject"
      },
      "example": "SEO te hacía competir por el ranking. AEO te hace competir por la <strong>recomendación</strong>: antes de que exista un clic."
    },
    "figures": {
      "selector": "[data-slot='figures']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 3,
        "maxItems": 3,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "role": {
            "type": "string",
            "required": true,
            "resolver": "gl-item-role"
          },
          "size": {
            "type": "string",
            "required": true,
            "resolver": "gl-figure-size"
          },
          "left": {
            "type": "string",
            "required": true,
            "resolver": "gl-css"
          },
          "top": {
            "type": "string",
            "required": true,
            "resolver": "gl-css"
          },
          "width": {
            "type": "string",
            "required": true,
            "resolver": "gl-css"
          },
          "height": {
            "type": "string",
            "required": true,
            "resolver": "gl-css"
          },
          "rotate": {
            "type": "string",
            "required": true,
            "resolver": "gl-css"
          },
          "z": {
            "type": "string",
            "required": true,
            "resolver": "gl-css"
          },
          "value": {
            "type": "string",
            "required": true,
            "maxCharacters": 9
          },
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 59
          },
          "detail": {
            "type": "string",
            "required": true,
            "maxCharacters": 124
          },
          "year": {
            "type": "string",
            "required": true,
            "maxCharacters": 4
          },
          "logo": {
            "type": "array",
            "required": false,
            "item": {
              "type": "object",
              "shape": {
                "src": {
                  "type": "string",
                  "required": true,
                  "resolver": "gl-file-ref"
                },
                "alt": {
                  "type": "string",
                  "required": true,
                  "maxCharacters": 80,
                  "resolver": "gl-alt"
                }
              }
            }
          },
          "wordmark": {
            "type": "string",
            "required": false,
            "maxCharacters": 20
          }
        }
      },
      "example": [
        {
          "role": "rest",
          "size": "large",
          "left": "--gl-am-left=840px",
          "top": "--gl-am-top=250px",
          "width": "--gl-am-width=300px",
          "height": "--gl-am-height=540px",
          "rotate": "--gl-am-rotate=16deg",
          "z": "--gl-am-z=2",
          "value": "−27%",
          "label": "El tráfico que llegaba solo ya no está garantizado.",
          "detail": "El tráfico orgánico de clientes HubSpot cayó 27% interanual.",
          "year": "2026",
          "logo": [
            {
              "src": "asset-ref:file:probe",
              "alt": "HubSpot"
            }
          ]
        },
        {
          "role": "lead",
          "size": "large",
          "left": "--gl-am-left=1135px",
          "top": "--gl-am-top=190px",
          "width": "--gl-am-width=370px",
          "height": "--gl-am-height=600px",
          "rotate": "--gl-am-rotate=0deg",
          "z": "--gl-am-z=5",
          "value": "50%",
          "label": "Tu comprador ya le pregunta a la IA qué elegir.",
          "detail": "Uno de cada dos consumidores ya usa búsqueda con IA, y la mayoría la prefiere para decidir compras.",
          "year": "2025",
          "wordmark": "McKinsey & Company"
        },
        {
          "role": "rest",
          "size": "small",
          "left": "--gl-am-left=1500px",
          "top": "--gl-am-top=250px",
          "width": "--gl-am-width=300px",
          "height": "--gl-am-height=540px",
          "rotate": "--gl-am-rotate=-16deg",
          "z": "--gl-am-z=2",
          "value": "<1 en 100",
          "label": "Aparecer una vez no es una estrategia.",
          "detail": "Los motores de IA casi nunca repiten la misma lista de marcas.",
          "year": "2026",
          "logo": [
            {
              "src": "asset-ref:file:probe",
              "alt": "SparkToro"
            }
          ]
        }
      ]
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-source.svg"
    }
  }
}
