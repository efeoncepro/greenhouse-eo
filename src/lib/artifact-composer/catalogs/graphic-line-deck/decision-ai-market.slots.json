{
  "template": "DecisionAiMarket",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "engine"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 380
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 440
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 132
        },
        "questionLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-br-question-leading=1.35"
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-br-answer-leading=1.02"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-br-answer-tracking=-0.035em"
        }
      }
    },
    "photo": {
      "selector": "[data-slot='photo']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt",
          "example": "Una directora creativa con el hoodie de Efeonce dirige con las manos una órbita de pantallas flotantes"
        }
      }
    },
    "indicator": {
      "selector": "[data-slot='indicator']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "example": "¿Y el cliente?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "resolver": "gl-answer",
          "example": "Aprobó"
        }
      }
    }
  }
}
