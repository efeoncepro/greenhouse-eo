{
  "template": "ContentBullets",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 110
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 200
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 270
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 120
        },
        "questionPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-question-px=40px"
        },
        "questionLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-question-leading=1.2"
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-answer-leading=1"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-answer-tracking=-0.04em"
        },
        "answerInset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-answer-inset=-4px"
        },
        "listTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-list-top=520px"
        },
        "listWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-list-width=1640px"
        },
        "rowGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-row-gap=56px"
        },
        "columnGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-column-gap=110px"
        },
        "rule": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-rule=2px"
        },
        "padTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-pad-top=18px"
        },
        "numberPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-number-px=84px"
        },
        "numberWght": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-number-wght=300"
        },
        "numberTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-number-tracking=-0.03em"
        },
        "numberRaise": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-number-raise=10px"
        },
        "numberGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-number-gap=34px"
        },
        "titlePx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-title-px=32px"
        },
        "descPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-desc-px=24px"
        },
        "descGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cb-desc-gap=10px"
        }
      }
    },
    "indicator": {
      "selector": "[data-slot='indicator']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 32,
          "example": "La experiencia Efeonce"
        },
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 44,
          "example": "¿Qué recibes al trabajar con nosotros?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 22,
          "resolver": "gl-answer",
          "example": "Un sistema"
        }
      }
    },
    "items": {
      "selector": "[data-slot='items']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 4,
        "maxItems": 4,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "number": {
            "type": "string",
            "required": true,
            "maxCharacters": 2
          },
          "title": {
            "type": "string",
            "required": true,
            "maxCharacters": 36
          },
          "desc": {
            "type": "string",
            "required": true,
            "maxCharacters": 110
          }
        }
      },
      "example": [
        {
          "number": "01",
          "title": "Un solo interlocutor",
          "desc": "Tu Director de Cuenta coordina todas las líneas. Sin pérdida de contexto entre equipos."
        },
        {
          "number": "02",
          "title": "Un equipo que opera como sistema",
          "desc": "Estrategia, creatividad, medios y tecnología bajo el mismo estándar y la misma metodología."
        },
        {
          "number": "03",
          "title": "Métricas en vivo en Greenhouse",
          "desc": "OTD, FTR y Revenue Enabled en tu portal, no en un informe que llega tarde."
        },
        {
          "number": "04",
          "title": "Cada ciclo suma al anterior",
          "desc": "Loop Marketing: ningún trimestre empieza de cero."
        }
      ]
    },
    "selection": {
      "selector": "[data-slot='selection']",
      "type": "object",
      "required": false,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "consumer": "validation-only",
          "example": "Growth"
        },
        "anchor": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "bottom-end"
        },
        "participantKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "department"
        },
        "scale": {
          "type": "number",
          "required": false,
          "consumer": "validation-only",
          "example": 1
        },
        "targetKind": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "object"
        },
        "variant": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "eight-handles"
        },
        "padding": {
          "type": "string",
          "required": false,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "standard"
        },
        "overlay": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "none"
        },
        "item": {
          "type": "number",
          "required": true,
          "consumer": "validation-only",
          "example": 3
        }
      }
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-baked-dark.svg"
    }
  }
}
