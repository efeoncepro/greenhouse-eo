{
  "template": "ContentIndustries",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "engine"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 130
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 196
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 280
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 128
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-leading=0.95"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-tracking=-0.045em"
        },
        "answerInset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-inset=-8px"
        },
        "questionWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-question-width=600px"
        },
        "bodyTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyTop",
          "example": 560
        },
        "bodyPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyPx",
          "example": 26
        },
        "bodyWidth": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyWidth",
          "example": 540
        },
        "lumWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lum-width=160px"
        },
        "lumBottom": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lum-bottom=62px"
        },
        "svBg": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-bg-color=#091951"
        },
        "svSoft": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-soft-color=#cfe4fa"
        },
        "svHalo": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-halo-color=#72ded8"
        },
        "svShadow": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-shadow-color=#000610"
        },
        "svCardFrom": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-card-from-color=#10304b"
        },
        "svCardTo": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-card-to-color=#081c30"
        },
        "svHeroCardFrom": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-hero-card-from-color=#134066"
        },
        "svHeroCardTo": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-hero-card-to-color=#0a2640"
        }
      }
    },
    "stage": {
      "selector": "[data-slot='stage']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "platform": {
      "selector": "[data-slot='platform']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "columns": {
      "selector": "[data-slot='columns']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 26,
          "example": "¿Conocemos tu industria?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "resolver": "gl-answer",
          "example": "dentro"
        },
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 50,
          "example": "Industrias"
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 20,
          "example": "Por"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 154,
        "maxLines": 4,
        "overflow": "reject"
      },
      "example": "Seis industrias donde tu comprador ya le pregunta a la IA antes de llamarte. Nosotros sabemos <strong>qué pregunta</strong>."
    },
    "industries": {
      "selector": "[data-slot='industries']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 6,
        "maxItems": 6,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "number": {
            "type": "string",
            "required": true,
            "maxCharacters": 2,
            "example": "01"
          },
          "name": {
            "type": "string",
            "required": true,
            "maxCharacters": 27,
            "example": "Banca y finanzas"
          },
          "question": {
            "type": "string",
            "required": true,
            "maxCharacters": 62,
            "example": "¿Qué banco tiene la mejor cuenta para pymes?"
          },
          "icon": {
            "type": "string",
            "required": true,
            "resolver": "gl-icon-ref",
            "example": "asset-ref:icon:probe"
          },
          "role": {
            "type": "string",
            "required": true,
            "resolver": "gl-item-role",
            "example": "lead"
          }
        }
      }
    },
    "productMark": {
      "selector": "[data-slot='productMark']",
      "type": "object",
      "required": false,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-file-ref",
          "example": "asset-ref:file:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "resolver": "gl-alt",
          "maxCharacters": 40,
          "example": "Efeonce | SV360"
        },
        "left": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-pmk-left=140px"
        },
        "top": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-pmk-top=44px"
        },
        "height": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-pmk-height=40px"
        }
      }
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-source.svg"
    }
  }
}
