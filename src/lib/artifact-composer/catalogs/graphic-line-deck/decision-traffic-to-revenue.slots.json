          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lum-bottom=51px"
        }
      }
    },
    "stage": {
      "selector": "[data-slot='stage']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "cut": {
      "selector": "[data-slot='cut']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "trajectory": {
      "selector": "[data-slot='trajectory']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 51,
          "example": "De tráfico a negocio"
        },
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 43,
          "example": "¿Dónde termina el SEO?"
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 18,
          "example": "En"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 18,
          "resolver": "gl-answer",
          "example": "ingresos"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 161,
        "maxLines": 6,
        "overflow": "reject"
      },
      "example": "Conectamos el SEO con tus indicadores de negocio —leads, pipeline e <strong>ingresos</strong>—, como siempre debió medirse."
    },
    "steps": {
      "selector": "[data-slot='steps']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 4,
        "maxItems": 4,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "role": {
            "type": "string",
            "required": true,
            "resolver": "gl-item-role"
          },
          "left": {
            "type": "string",
            "required": true,
            "resolver": "gl-css"
          },
          "top": {
            "type": "string",
            "required": true,
            "resolver": "gl-css"
          },
          "height": {
            "type": "string",
            "required": true,
            "resolver": "gl-css"
          },
          "z": {
            "type": "string",
            "required": true,
            "resolver": "gl-css"
          },
          "fillOpacity": {
            "type": "string",
            "required": true,
            "resolver": "gl-css"
          },
          "number": {
            "type": "string",
            "required": true,
            "maxCharacters": 2
          },
          "title": {
            "type": "string",
            "required": true,
            "maxCharacters": 28
          },
          "description": {
            "type": "string",
            "required": true,
            "maxCharacters": 102
          },
          "channel": {
            "type": "string",
            "required": true,
            "maxCharacters": 24
          }
        }
      },
      "example": [
        {
          "role": "rest",
          "left": "--gl-ttr-left=790px",
          "top": "--gl-ttr-top=620px",
          "height": "--gl-ttr-height=250px",
          "z": "--gl-ttr-z=2",
          "fillOpacity": "--gl-ttr-fill-opacity=10%",
          "number": "01",
          "title": "Tráfico calificado",
          "description": "Visitas con intención comercial, segmentadas por cluster de tema.",
          "channel": "Google · IA"
        },
        {
          "role": "rest",
          "left": "--gl-ttr-left=1056px",
          "top": "--gl-ttr-top=510px",
          "height": "--gl-ttr-height=360px",
          "z": "--gl-ttr-z=3",
          "fillOpacity": "--gl-ttr-fill-opacity=15%",
          "number": "02",
          "title": "Leads",
          "description": "Quién llegó, desde qué búsqueda y qué pidió.",
          "channel": "Formularios · CRM"
        },
        {
          "role": "rest",
          "left": "--gl-ttr-left=1322px",
          "top": "--gl-ttr-top=400px",
          "height": "--gl-ttr-height=470px",
          "z": "--gl-ttr-z=4",
          "fillOpacity": "--gl-ttr-fill-opacity=20%",
          "number": "03",
          "title": "Pipeline",
          "description": "Oportunidades que nacen del orgánico, en tu CRM.",
          "channel": "HubSpot · Salesforce"
        },
        {
          "role": "lead",
          "left": "--gl-ttr-left=1588px",
          "top": "--gl-ttr-top=290px",
          "height": "--gl-ttr-height=580px",
          "z": "--gl-ttr-z=5",
          "fillOpacity": "--gl-ttr-fill-opacity=25%",
          "number": "04",
          "title": "Ingresos",
          "description": "Lo que el SEO trae al negocio, medido.",
          "channel": "Greenhouse"
        }
      ]
    },
    "cutLabel": {
      "selector": "[data-slot='cutLabel']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 68,
        "maxLines": 3,
        "overflow": "reject"
      },
      "example": "La mayoría de las agencias se detiene aquí"
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-source.svg"
    }
  }
}
