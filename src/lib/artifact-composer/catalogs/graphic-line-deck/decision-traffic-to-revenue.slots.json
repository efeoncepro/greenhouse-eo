        },
        "baseTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ttr-base-top=870px"
        },
        "baseWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ttr-base-width=1088px"
        },
        "baseRule": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ttr-base-rule=2px"
        },
        "baseColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ttr-base-color=#ffffff"
        },
        "baseOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ttr-base-opacity=18%"
        },
        "cutLabelLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ttr-cut-left=848px"
        },
        "cutLabelTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ttr-cut-top=262px"
        },
        "cutLabelWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ttr-cut-width=190px"
        },
        "cutLabelPx": {
          "type": "string",
          "required": true,
