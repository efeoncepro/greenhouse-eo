          "example": "--gl-ttr-answer-leading=0.9"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ttr-answer-tracking=-0.05em"
        },
        "answerInset": {
          "type": "string",
          "required": true,
