          "example": "--gl-ns-answer-gap=36px"
        },
        "answerSize": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ns-answer-px=128px"
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ns-answer-leading=0.9"
        },
        "answerShadowY": {
          "type": "string",
          "required": true,
