        }
      }
    },
    "stage": {
      "selector": "[data-slot='stage']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "orbit": {
      "selector": "[data-slot='orbit']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "example": "Próximos pasos"
        },
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 26,
          "example": "¿Y ahora qué sigue?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 10,
          "resolver": "gl-answer",
          "example": "Empecemos"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 110,
        "maxLines": 3,
        "overflow": "reject"
      },
      "example": "Un diagnóstico <strong>sin costo</strong> para saber dónde estás."
    },
    "contact": {
      "selector": "[data-slot='contact']",
      "type": "object",
      "required": true,
      "shape": {
        "email": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "example": "sales@efeoncepro.com"
        },
        "phone": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "example": "+56 9 3732 3064"
        }
      }
    },
    "agenda": {
      "selector": "[data-slot='agenda']",
      "type": "object",
      "required": true,
      "shape": {
        "kicker": {
          "type": "string",
          "required": true,
          "maxCharacters": 36,
          "example": "01 · Diagnóstico · Sin costo"
        },
        "title": {
          "type": "string",
          "required": true,
          "maxCharacters": 26,
          "example": "Agenda tu diagnóstico"
        },
        "descriptor": {
          "type": "string",
          "required": true,
          "maxCharacters": 100,
          "example": "45 min por videollamada · Brand Visibility Grader, CRM Gap Analysis o Creative Velocity Audit"
        },
        "summary": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "example": "Martes 30 · 11:30 · hora de Chile"
        }
      }
    },
    "days": {
      "selector": "[data-slot='days']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 5,
        "maxItems": 5,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "weekday": {
            "type": "string",
            "required": true,
            "maxCharacters": 3
          },
          "day": {
            "type": "string",
            "required": true,
            "maxCharacters": 2
          }
        }
      },
      "example": [
        {
          "weekday": "Lun",
          "day": "29"
        },
        {
          "weekday": "Mar",
          "day": "30"
        },
        {
          "weekday": "Mié",
          "day": "1"
        },
        {
          "weekday": "Jue",
          "day": "2"
        },
        {
          "weekday": "Vie",
          "day": "3"
        }
      ]
    },
    "times": {
      "selector": "[data-slot='times']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 4,
        "maxItems": 4,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "time": {
            "type": "string",
            "required": true,
            "maxCharacters": 5
          }
        }
      },
      "example": [
        {
          "time": "09:30"
        },
        {
          "time": "11:30"
        },
        {
          "time": "15:00"
        },
        {
          "time": "17:00"
        }
      ]
    },
    "cta": {
      "selector": "[data-slot='cta']",
      "type": "object",
      "required": true,
      "shape": {
        "text": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "example": "Agenda un diagnóstico"
        },
        "cursorScale": {
          "type": "number",
          "required": true,
          "consumer": "validation-only",
          "example": 1.25
        }
      }
    },
    "nextSteps": {
      "selector": "[data-slot='nextSteps']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 2,
        "maxItems": 2,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "number": {
            "type": "string",
            "required": true,
            "maxCharacters": 2
          },
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 16
          },
          "title": {
            "type": "string",
            "required": true,
            "maxCharacters": 14
          },
          "desc": {
            "type": "string",
            "required": true,
            "maxCharacters": 70
          }
        }
      },
      "example": [
        {
          "number": "02",
          "label": "Piloto pagado",
          "title": "Sample Sprint",
          "desc": "Acotado y gobernado, para probar el encaje antes de comprometerte."
        },
        {
          "number": "03",
          "label": "On-Going",
          "title": "Operación",
          "desc": "Tus métricas en vivo en Greenhouse."
        }
      ]
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-source.svg"
    }
  }
}
