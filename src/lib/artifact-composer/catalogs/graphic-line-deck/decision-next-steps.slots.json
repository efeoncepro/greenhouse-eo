          "example": "--gl-ns-step1-left=1410px"
        },
        "step1Top": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ns-step1-top=104px"
        },
        "step1Width": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ns-step1-width=380px"
        },
        "step1Rotate": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ns-step1-rotate=-14deg"
        },
        "step1Opacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ns-step1-opacity=0.9"
        },
        "step2Left": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ns-step2-left=1520px"
        },
        "step2Top": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ns-step2-top=830px"
        },
        "step2Width": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ns-step2-width=330px"
        },
        "step2Rotate": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ns-step2-rotate=-16deg"
        },
