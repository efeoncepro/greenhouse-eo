{
  "template": "CloseProposal",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "logoLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-logo-left=140px"
        },
        "logoTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-logo-top=230px"
        },
        "logoWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-logo-width=500px"
        },
        "sloganTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-slogan-top=420px"
        },
        "sloganPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-slogan-px=72px"
        },
        "sloganLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-slogan-leading=1.15"
        },
        "contactTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-top=600px"
        },
        "contactPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-px=20px"
        },
        "contactWeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-wght=500"
        },
        "contactLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-leading=1.3"
        },
        "contactRowGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-row-gap=18px"
        },
        "contactBubbleHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-bubble-height=32px"
        },
        "contactSocialGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-social-gap=28px"
        },
        "contactSocialIcon": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-social-icon=32px"
        },
        "contactSocialIconGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-social-icon-gap=14px"
        },
        "contactItemIcon": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-item-icon=23px"
        },
        "contactItemGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-item-gap=8px"
        },
        "contactIconOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-icon-opacity=0.78"
        },
        "contactSocialBelow": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-social-below=0px"
        },
        "sloganRunLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-leading",
          "example": "--gl-slogan-run-leading=1.15"
        }
      }
    },
    "backdrop": {
      "selector": "[data-slot='backdrop']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-backdrop-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-backdrop-alt",
          "example": "Nexa, de espaldas, camina hacia una órbita de luz teal en el horizonte"
        }
      }
    },
    "logo": {
      "selector": "[data-slot='logo']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/efeonce-logo-negative.svg"
    },
    "slogan": {
      "selector": "[data-slot='slogan']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 3,
        "maxItems": 3,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 16
          },
          "style": {
            "type": "string",
            "required": true,
            "resolver": "gl-slogan-run"
          }
        }
      },
      "example": [
        {
          "text": "Empower",
          "style": "800 italic #e2e2e2"
        },
        {
          "text": "your",
          "style": "800 normal #e2e2e2"
        },
        {
          "text": "Growth",
          "style": "900 italic #36c8bf"
        }
      ]
    },
    "contact": {
      "selector": "[data-slot='contact']",
      "type": "object",
      "required": true,
      "shape": {
        "email": {
          "type": "string",
          "required": true,
          "maxCharacters": 48,
          "example": "sales@efeoncepro.com"
        },
        "phoneFirst": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "example": "+56 9 3732 3064"
        },
        "phoneSecond": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "example": "+1 (239) 235-2073"
        },
        "address": {
          "type": "string",
          "required": true,
          "maxCharacters": 80,
          "example": "Dr. Manuel Barros Borgoño 71, of. 1105, Providencia, Chile"
        }
      }
    },
    "partnerMark": {
      "selector": "[data-slot='partnerMark']",
      "type": "object",
      "required": false,
      "shape": {
        "left": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-pm-left=140px"
        },
        "badge": {
          "type": "string",
          "required": true,
          "resolver": "gl-file-ref",
          "example": "asset-ref:file:probe"
        },
        "badgeTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-pm-badge-top=864px"
        },
        "badgeHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-pm-badge-height=72px"
        }
      }
    }
  }
}
