{
  "template": "ContentMarkets",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "engine"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 130
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 196
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 280
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 128
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-leading=0.95"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-tracking=-0.045em"
        },
        "answerInset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-inset=-8px"
        },
        "questionWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-question-width=600px"
        },
        "bodyTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyTop",
          "example": 560
        },
        "bodyPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyPx",
          "example": 26
        },
        "bodyWidth": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyWidth",
          "example": 520
        },
        "lumWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lum-width=160px"
        },
        "lumBottom": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lum-bottom=62px"
        },
        "svSpaceBg": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-space-bg-color=#020716"
        },
        "svHalo": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-halo-color=#72ded8"
        },
        "svShadow": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-shadow-color=#000610"
        },
        "svLabelBg": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-label-bg-color=#041028"
        },
        "svCity": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-city-color=#9fd7ff"
        }
      }
    },
    "photo": {
      "selector": "[data-slot='photo']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "resolver": "gl-alt",
          "maxCharacters": 320,
          "example": "Las Américas de noche vistas desde la órbita; cinco puntos de luz azul unidos por arcos en Miami, Ciudad de México, Bogotá, Lima y Santiago"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 26,
          "example": "¿Dónde operamos?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "resolver": "gl-answer",
          "example": "países"
        },
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 50,
          "example": "Mercados"
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 20,
          "example": "Cinco"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 148,
        "maxLines": 4,
        "overflow": "reject"
      },
      "example": "Chile, Estados Unidos, Colombia, México y Perú, con <strong>un solo equipo</strong> y un solo interlocutor."
    },
    "markets": {
      "selector": "[data-slot='markets']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 5,
        "maxItems": 5,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "country": {
            "type": "string",
            "required": true,
            "maxCharacters": 10,
            "example": "EE. UU."
          },
          "city": {
            "type": "string",
            "required": true,
            "maxCharacters": 16,
            "example": "Miami"
          },
          "side": {
            "type": "string",
            "required": true,
            "resolver": "gl-label-side",
            "example": "start"
          },
          "x": {
            "type": "string",
            "required": true,
            "resolver": "gl-css",
            "example": "--gl-smk-x=1412px"
          },
          "top": {
            "type": "string",
            "required": true,
            "resolver": "gl-css",
            "example": "--gl-smk-top=143px"
          }
        }
      }
    },
    "productMark": {
      "selector": "[data-slot='productMark']",
      "type": "object",
      "required": false,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-file-ref",
          "example": "asset-ref:file:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "resolver": "gl-alt",
          "maxCharacters": 40,
          "example": "Efeonce | SV360"
        },
        "left": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-pmk-left=140px"
        },
        "top": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-pmk-top=44px"
        },
        "height": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-pmk-height=40px"
        }
      }
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-source.svg"
    }
  }
}
