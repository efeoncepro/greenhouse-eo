        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 120,
        "maxLines": 5,
        "overflow": "reject"
      },
      "example": "Capacidad gobernada, <strong>nunca</strong> por horas ni piezas. Greenhouse suma la capa de producto."
    },
    "legal": {
      "selector": "[data-slot='legal']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 90,
        "maxLines": 3,
        "overflow": "reject"
      },
      "example": "Valores netos, IVA no incluido. Los montos se definen en cada propuesta."
    },
    "plans": {
      "selector": "[data-slot='plans']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 3,
        "maxItems": 3,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "label": {
            "type": "string",
            "required": false,
            "maxCharacters": 16
          },
          "name": {
