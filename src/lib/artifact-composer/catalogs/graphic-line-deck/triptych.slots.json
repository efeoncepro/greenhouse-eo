{
  "template": "Triptych",
  "version": "0.1",
  "viewport": { "width": 1920, "height": 1080 },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": { "type": "string", "required": true, "resolver": "gl-line", "example": "growth" },
        "questionTop": { "type": "number", "required": true, "resolver": "gl-px-questionTop", "example": 48 },
        "answerTop": { "type": "number", "required": true, "resolver": "gl-px-answerTop", "example": 944 },
        "answerPx": { "type": "number", "required": true, "resolver": "gl-px-answerPx", "example": 108 },
        "questionInset": { "type": "string", "required": true, "resolver": "gl-css", "example": "--gl-question-inset=48px" },
        "questionPx": { "type": "string", "required": true, "resolver": "gl-css", "example": "--gl-question-px=34px" },
        "panelWidth": { "type": "string", "required": true, "resolver": "gl-css", "example": "--gl-panel-width=636px" },
        "gutter": { "type": "string", "required": true, "resolver": "gl-css", "example": "--gl-gutter=6px" },
        "wordInset": { "type": "string", "required": true, "resolver": "gl-css", "example": "--gl-word-inset=42px" },
        "bedBlur": { "type": "string", "required": true, "resolver": "gl-css", "example": "--gl-bed-blur=16px" },
        "bedMaskSolid": { "type": "string", "required": true, "resolver": "gl-css", "example": "--gl-bed-mask-solid=110px" },
        "bedMaskEnd": { "type": "string", "required": true, "resolver": "gl-css", "example": "--gl-bed-mask-end=220px" },
        "bedShade": { "type": "string", "required": true, "resolver": "gl-css", "example": "--gl-bed-shade=82%" },
        "bedShadeHeight": { "type": "string", "required": true, "resolver": "gl-css", "example": "--gl-bed-shade-height=240px" }
      }
    },
    "bed": {
      "selector": "[data-slot='bed']",
      "type": "object",
      "required": true,
      "shape": {
        "src": { "type": "string", "required": true, "resolver": "gl-plate-ref", "example": "asset-ref:plate:probe" }
      }
    },
    "question": {
      "selector": "[data-slot='question']",
      "type": "string",
      "required": true,
      "constraints": { "maxCharacters": 28, "maxLines": 1, "overflow": "reject" }
    },
    "panels": {
      "selector": "[data-slot='panels']",
      "type": "array",
      "required": true,
      "constraints": { "minItems": 3, "maxItems": 3, "overflow": "reject" },
      "item": {
        "type": "object",
        "shape": {
          "src": { "type": "string", "required": true, "resolver": "gl-plate-ref", "example": "asset-ref:plate:probe" },
          "alt": { "type": "string", "required": true, "maxCharacters": 320, "resolver": "gl-alt" },
          "word": { "type": "string", "required": true, "maxCharacters": 12, "resolver": "gl-answer", "example": "crea" }
        }
      }
    }
  }
}
