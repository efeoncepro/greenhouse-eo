{
  "template": "ContentPartners",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 110
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 200
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 270
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 120
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-answer-leading=1"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-answer-tracking=-0.04em"
        },
        "answerInset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-answer-inset=-4px"
        },
        "questionWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-question-width=1300px"
        },
        "bodyTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyTop",
          "example": 330
        },
        "bodyPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyPx",
          "example": 26
        },
        "bodyWidth": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyWidth",
          "example": 560
        },
        "bodyRight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-body-right=260px"
        },
        "sealTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-seal-top=488px"
        },
        "sealLogo": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-seal-logo=44px"
        },
        "sealGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-seal-gap=26px"
        },
        "sealPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-seal-px=24px"
        },
        "dividerWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-divider-width=2px"
        },
        "dividerHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-divider-height=40px"
        },
        "ruleTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-rule-top=568px"
        },
        "ruleStroke": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-rule=2px"
        },
        "ruleWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-rule-width=1640px"
        },
        "rowHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-row-height=110px"
        },
        "logoMaxWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-logo-max-width=260px"
        },
        "logoMaxHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-logo-max-height=96px"
        },
        "row1Top": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-row1-top=616px"
        },
        "row1Width": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-row1-width=1640px"
        },
        "row2Top": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-row2-top=806px"
        },
        "row2Width": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cpt-row2-width=1300px"
        }
      }
    },
    "indicator": {
      "selector": "[data-slot='indicator']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "example": "¿Con quién construimos?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 22,
          "resolver": "gl-answer",
          "example": "Con los grandes"
        },
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 28,
          "example": "Partners"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 110,
        "maxLines": 3,
        "overflow": "reject"
      },
      "example": "Programas oficiales de los fabricantes con los que operamos tu crecimiento."
    },
    "seal": {
      "selector": "[data-slot='seal']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 24,
        "maxLines": 1,
        "overflow": "reject"
      },
      "example": "Partner oficial de"
    },
    "row1": {
      "selector": "[data-slot='row1']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 5,
        "maxItems": 5,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "src": {
            "type": "string",
            "required": true,
            "resolver": "gl-file-ref"
          },
          "alt": {
            "type": "string",
            "required": true,
            "maxCharacters": 80,
            "resolver": "gl-alt"
          }
        }
      },
      "example": [
        {
          "src": "asset-ref:file:probe",
          "alt": "HubSpot"
        },
        {
          "src": "asset-ref:file:probe",
          "alt": "Salesforce"
        },
        {
          "src": "asset-ref:file:probe",
          "alt": "Adobe"
        },
        {
          "src": "asset-ref:file:probe",
          "alt": "Microsoft"
        },
        {
          "src": "asset-ref:file:probe",
          "alt": "Amazon Web Services"
        }
      ]
    },
    "row2": {
      "selector": "[data-slot='row2']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 4,
        "maxItems": 4,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "src": {
            "type": "string",
            "required": true,
            "resolver": "gl-file-ref"
          },
          "alt": {
            "type": "string",
            "required": true,
            "maxCharacters": 80,
            "resolver": "gl-alt"
          }
        }
      },
      "example": [
        {
          "src": "asset-ref:file:probe",
          "alt": "Google Cloud"
        },
        {
          "src": "asset-ref:file:probe",
          "alt": "Claude"
        },
        {
          "src": "asset-ref:file:probe",
          "alt": "OpenAI"
        },
        {
          "src": "asset-ref:file:probe",
          "alt": "BytePlus"
        }
      ]
    },
    "selection": {
      "selector": "[data-slot='selection']",
      "type": "object",
      "required": false,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "consumer": "validation-only",
          "example": "Agentes IA"
        },
        "anchor": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "bottom-end"
        },
        "participantKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "department"
        },
        "scale": {
          "type": "number",
          "required": false,
          "consumer": "validation-only",
          "example": 1.2
        },
        "targetKind": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "object"
        },
        "variant": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "eight-handles"
        },
        "padding": {
          "type": "string",
          "required": false,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "standard"
        },
        "overlay": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "none"
        },
        "item": {
          "type": "number",
          "required": true,
          "consumer": "validation-only",
          "example": 7
        }
      }
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-baked-dark.svg"
    }
  }
}
