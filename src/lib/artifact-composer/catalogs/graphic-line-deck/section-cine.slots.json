{
  "template": "SectionCine",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 118
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 515
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 630
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 130
        },
        "eyebrowPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-eyebrow-px=18px"
        },
        "eyebrowWght": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-eyebrow-wght=500"
        },
        "eyebrowTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-eyebrow-tracking=0.22em"
        },
        "eyebrowColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sec-eyebrow-color=#e2e2e2"
        },
        "questionPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-question-px=36px"
        },
        "questionLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-question-leading=1.2"
        },
        "questionColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sec-question-color=#f4f6f8"
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-answer-leading=0.95"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-answer-tracking=-0.04em"
        },
        "answerInset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-answer-inset=-4px"
        },
        "questionWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-question-width=400px"
        }
      }
    },
    "photo": {
      "selector": "[data-slot='photo']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt",
          "example": "Descripción de la imagen"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "example": "Nuestro equipo"
        },
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "example": "¿Quién hace crecer tu marca?"
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 18,
          "example": "Este"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "resolver": "gl-answer",
          "example": "equipo"
        }
      }
    },
    "cta": {
      "selector": "[data-slot='cta']",
      "type": "object",
      "required": false,
      "shape": {
        "variant": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "eight-handles"
        },
        "cursorScale": {
          "type": "number",
          "required": true,
          "consumer": "validation-only",
          "example": 1.1
        }
      },
      "example": null,
      "note": "Sólo la composición `services`: el cursor propio del lector con ocho manijas sobre la respuesta (hook del CTA)."
    }
  }
}
