{
  "template": "ContentReportFormats",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "engine"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 230
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 285
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 351
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 124
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-leading=0.95"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-tracking=-0.035em"
        },
        "answerInset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-inset=0px"
        },
        "questionWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-question-width=640px"
        },
        "bodyTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyTop",
          "example": 627
        },
        "bodyPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyPx",
          "example": 26
        },
        "bodyWidth": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyWidth",
          "example": 600
        },
        "lumWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lum-width=160px"
        },
        "lumBottom": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lum-bottom=62px"
        },
        "svBg": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-bg-color=#091951"
        },
        "svSoft": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-soft-color=#cfe4fa"
        },
        "svMuted": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-muted-color=#c9d6e2"
        },
        "svHalo": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-halo-color=#72ded8"
        },
        "svTealDark": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-teal-dark-color=#0e8c82"
        },
        "svShadow": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-shadow-color=#000610"
        },
        "svCardTo": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-card-to-color=#081c30"
        },
        "svMiniFrom": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-mini-from-color=#12344f"
        },
        "svMiniHeroFrom": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-mini-hero-from-color=#0f4a6e"
        },
        "svHeroCardTo": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-hero-card-to-color=#0a2640"
        },
        "svDocTo": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-doc-to-color=#f3f6fa"
        },
        "svDocInk": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-doc-ink-color=#023c70"
        },
        "svDocMuted": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-doc-muted-color=#5b6b82"
        },
        "svDocPanel": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-doc-panel-color=#eef3f9"
        },
        "svDocBar": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-doc-bar-color=#d3dce8"
        },
        "svDocDash": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-doc-dash-color=#8a9bb3"
        },
        "svDocNote": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sv-doc-note-color=#e8f2fd"
        }
      }
    },
    "stage": {
      "selector": "[data-slot='stage']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "beams": {
      "selector": "[data-slot='beams']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 28,
          "example": "¿Cómo te llega?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "resolver": "gl-answer",
          "example": "necesites"
        },
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 53,
          "example": "Un informe, cinco formatos"
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 20,
          "example": "Como la"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 171,
        "maxLines": 4,
        "overflow": "reject"
      },
      "example": "Cada mes la IA cruza tus datos y escribe la lectura; nuestro equipo la revisa. Tú solo la abres y la usas, <strong>sin armar</strong> reportes ni láminas."
    },
    "report": {
      "selector": "[data-slot='report']",
      "type": "object",
      "required": true,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 58,
          "example": "Informe vivo · septiembre"
        },
        "trendTitle": {
          "type": "string",
          "required": true,
          "maxCharacters": 54,
          "example": "Visibilidad en IA · 6 meses"
        },
        "rankingTitle": {
          "type": "string",
          "required": true,
          "maxCharacters": 38,
          "example": "Quién aparece en las respuestas"
        },
        "reading": {
          "type": "string",
          "required": true,
          "maxCharacters": 155,
          "example": "Subes por tus guías nuevas. En «precios» el rival A todavía te gana: ahí va el próximo contenido."
        }
      }
    },
    "kpis": {
      "selector": "[data-slot='kpis']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 3,
        "maxItems": 3,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 28,
            "example": "Visibilidad en IA"
          },
          "value": {
            "type": "string",
            "required": true,
            "maxCharacters": 6,
            "example": "64%"
          },
          "delta": {
            "type": "string",
            "required": true,
            "maxCharacters": 8,
            "example": "▲ 9 pts"
          }
        }
      }
    },
    "ranking": {
      "selector": "[data-slot='ranking']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 4,
        "maxItems": 4,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "name": {
            "type": "string",
            "required": true,
            "maxCharacters": 11,
            "example": "Tu marca"
          },
          "share": {
            "type": "string",
            "required": true,
            "maxCharacters": 4,
            "example": "34%"
          },
          "bar": {
            "type": "string",
            "required": true,
            "resolver": "gl-css",
            "example": "--gl-srf-bar=100%"
          },
          "role": {
            "type": "string",
            "required": true,
            "resolver": "gl-item-role",
            "example": "lead"
          }
        }
      }
    },
    "formats": {
      "selector": "[data-slot='formats']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 5,
        "maxItems": 5,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "icon": {
            "type": "string",
            "required": true,
            "resolver": "gl-icon-ref",
            "example": "asset-ref:icon:probe"
          },
          "title": {
            "type": "string",
            "required": true,
            "maxCharacters": 13,
            "example": "Correo"
          },
          "detail": {
            "type": "string",
            "required": true,
            "maxCharacters": 37,
            "example": "Te llega solo"
          },
          "role": {
            "type": "string",
            "required": true,
            "resolver": "gl-item-role",
            "example": "rest"
          }
        }
      }
    },
    "productMark": {
      "selector": "[data-slot='productMark']",
      "type": "object",
      "required": false,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-file-ref",
          "example": "asset-ref:file:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "resolver": "gl-alt",
          "maxCharacters": 40,
          "example": "Efeonce | Insights"
        },
        "left": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-pmk-left=140px"
        },
        "top": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-pmk-top=44px"
        },
        "height": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-pmk-height=40px"
        }
      }
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-source.svg"
    }
  }
}
