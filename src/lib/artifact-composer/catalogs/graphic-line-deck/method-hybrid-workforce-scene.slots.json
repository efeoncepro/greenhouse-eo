{
  "template": "MethodHybridWorkforceScene",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "engine"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 110
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 200
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 280
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 160
        },
        "bodyTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyTop",
          "example": 640
        },
        "bodyPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyPx",
          "example": 28
        },
        "bodyWidth": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyWidth",
          "example": 600
        }
      }
    },
    "photo": {
      "selector": "[data-slot='photo']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt",
          "example": "Una directora creativa con el hoodie de Efeonce dirige con las manos una órbita de pantallas flotantes"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 32,
          "example": "Fuerza de trabajo híbrida"
        },
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 30,
          "example": "¿Quién hace el trabajo?"
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 10,
          "example": "Personas"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 10,
          "resolver": "gl-answer",
          "example": "y agentes"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 120,
        "maxLines": 4,
        "overflow": "reject"
      },
      "example": "Sobre la misma pieza, al mismo tiempo. El agente suma capacidad medible; la persona decide y responde."
    },
    "selection": {
      "selector": "[data-slot='selection']",
      "type": "object",
      "required": true,
      "shape": {
        "targets": {
          "type": "array",
          "required": true,
          "consumer": "validation-only",
          "example": [
            {
              "label": "Estrategia",
              "anchor": "bottom-start",
              "participantKind": "department",
              "box": {
                "left": 1606,
                "top": 388,
                "right": 1866,
                "bottom": 530
              }
            },
            {
              "label": "Agente IA",
              "anchor": "top-start",
              "participantKind": "department",
              "color": "#0375db",
              "box": {
                "left": 1614,
                "top": 172,
                "right": 1872,
                "bottom": 368
              }
            }
          ]
        },
        "scale": {
          "type": "number",
          "required": true,
          "consumer": "validation-only",
          "example": 1.25
        },
        "variant": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "eight-handles"
        },
        "padding": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "standard"
        },
        "overlay": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "none"
        },
        "participantKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "department"
        }
      }
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-baked-dark.svg"
    }
  }
}
