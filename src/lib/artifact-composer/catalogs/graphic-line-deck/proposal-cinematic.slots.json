{
  "template": "ProposalCinematic",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "brand"
        },
        "stepsLayout": {
          "type": "string",
          "required": true,
          "resolver": "gl-steps-layout",
          "example": "inline"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 120
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 186
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 311
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 174
        },
        "bodyTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyTop",
          "example": 535
        },
        "bodyPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyPx",
          "example": 26
        },
        "bodyWidth": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyWidth",
          "example": 570
        },
        "proofTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-proofTop",
          "example": 740
        },
        "stepsTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-stepsTop",
          "example": 870
        },
        "stepsGap": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-stepsGap",
          "example": 245
        },
        "stepWidth": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-stepWidth",
          "example": 235
        },
        "kickerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-kickerPx",
          "example": 13
        },
        "stepNamePx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-stepNamePx",
          "example": 22
        },
        "iconPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-iconPx",
          "example": 50
        }
      }
    },
    "photo": {
      "selector": "[data-slot='photo']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt",
          "example": "Una directora creativa con el hoodie de Efeonce dirige con las manos una órbita de pantallas flotantes"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 60,
          "example": "Nuestra propuesta · Servicios creativos"
        },
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "example": "¿Tu marca en cada pantalla?"
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "example": ""
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "resolver": "gl-answer",
          "example": "En todas"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 170,
        "maxLines": 5,
        "overflow": "reject"
      },
      "example": "Social, campañas, video, motion y creatividad para performance, con un squad que produce todos los días."
    },
    "proof": {
      "selector": "[data-slot='proof']",
      "type": "object",
      "required": false,
      "shape": {
        "text": {
          "type": "string",
          "required": true,
          "maxCharacters": 60,
          "example": "Sky: +2.000 piezas aprobadas en 12 meses"
        },
        "source": {
          "type": "string",
          "required": true,
          "maxCharacters": 160,
          "consumer": "validation-only",
          "example": "deck Sky, caso publicado"
        }
      }
    },
    "steps": {
      "selector": "[data-slot='steps']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 4,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "icon": {
            "type": "string",
            "required": true,
            "resolver": "gl-icon-ref",
            "example": "asset-ref:icon:probe"
          },
          "kicker": {
            "type": "string",
            "required": true,
            "maxCharacters": 18
          },
          "name": {
            "type": "string",
            "required": true,
            "maxCharacters": 22
          }
        }
      },
      "example": [
        {
          "icon": "asset-ref:icon:probe",
          "kicker": "Empieza aquí",
          "name": "Creative Sprint"
        },
        {
          "icon": "asset-ref:icon:probe",
          "kicker": "Managed Squad",
          "name": "Creative Capacity"
        },
        {
          "icon": "asset-ref:icon:probe",
          "kicker": "Producción",
          "name": "Creative Studio"
        }
      ]
    },
    "selection": {
      "selector": "[data-slot='selection']",
      "type": "object",
      "required": false,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "consumer": "validation-only",
          "example": "Cliente"
        },
        "anchor": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "top-end"
        },
        "participantKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "department"
        },
        "scale": {
          "type": "number",
          "required": false,
          "consumer": "validation-only",
          "example": 1.2
        }
      }
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-baked-dark.svg"
    }
  }
}
