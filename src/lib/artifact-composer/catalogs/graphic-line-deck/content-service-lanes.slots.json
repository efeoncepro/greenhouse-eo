{
  "template": "ContentServiceLanes",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "revenue-salesforce"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 110
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 170
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 228
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 124
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-leading=0.95"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-tracking=-0.04em"
        },
        "answerInset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-inset=-6px"
        },
        "lumWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lum-width=216px"
        },
        "lumBottom": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lum-bottom=51px"
        },
        "lsGlassFrom": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-glass-from-color=#ffffff"
        },
        "lsGlassFromOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-from-opacity=14%"
        },
        "lsGlassTo": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-glass-to-color=#ffffff"
        },
        "lsGlassToOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-to-opacity=4%"
        },
        "lsGlassAngle": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-angle=160deg"
        },
        "lsGlassBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-blur=6px"
        },
        "lsGlassBorder": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-border=1px"
        },
        "lsGlassBorderColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-glass-border-color=#ffffff"
        },
        "lsGlassBorderOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-border-opacity=18%"
        },
        "lsGlassShadowY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-shadow-y=30px"
        },
        "lsGlassShadowBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-shadow-blur=70px"
        },
        "lsGlassShadowColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-glass-shadow-color=#000610"
        },
        "lsGlassShadowOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-shadow-opacity=60%"
        },
        "laneWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-lane-width=400px"
        },
        "laneHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-lane-height=214px"
        },
        "lanePadY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-lane-pad-y=22px"
        },
        "lanePadX": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-lane-pad-x=24px"
        },
        "laneRadius": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-lane-radius=20px"
        },
        "laneIcon": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-lane-icon=52px"
        },
        "laneIconGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-lane-icon-gap=14px"
        },
        "titlePx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-title-px=25px"
        },
        "titleLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-title-leading=1.05"
        },
        "titleTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-title-tracking=-0.37px"
        },
        "titleColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-csl-title-color=#ffffff"
        },
        "productPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-product-px=14px"
        },
        "productWeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-product-wght=500"
        },
        "productGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-product-gap=4px"
        },
        "productColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-csl-product-color=#e2e2e2"
        },
        "descPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-desc-px=18px"
        },
        "descWeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-desc-wght=300"
        },
        "descLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-desc-leading=1.45"
        },
        "descGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-desc-gap=16px"
        },
        "descColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-csl-desc-color=#e6edf3"
        },
        "phasesTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-phases-top=870px"
        },
        "phasesGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-phases-gap=14px"
        },
        "phasePx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-phase-px=17px"
        },
        "phaseWeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-phase-wght=600"
        },
        "phaseColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-csl-phase-color=#ffffff"
        },
        "connectorWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-connector-width=34px"
        },
        "connectorHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-connector-height=2px"
        },
        "connectorColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-csl-connector-color=#2fb8ff"
        },
        "connectorOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-connector-opacity=70%"
        }
      }
    },
    "stage": {
      "selector": "[data-slot='stage']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "platform": {
      "selector": "[data-slot='platform']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 57,
          "example": "¿Qué hacemos en Salesforce?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 21,
          "resolver": "gl-answer",
          "example": "Todo el ciclo"
        },
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 51,
          "example": "Nuestros servicios Salesforce"
        }
      }
    },
    "lanes": {
      "selector": "[data-slot='lanes']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 6,
        "maxItems": 6,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "icon": {
            "type": "string",
            "required": true,
            "resolver": "gl-file-ref",
            "example": "asset-ref:file:probe"
          },
          "title": {
            "type": "string",
            "required": true,
            "maxCharacters": 43,
            "example": "Ventas y revenue"
          },
          "products": {
            "type": "string",
            "required": true,
            "maxCharacters": 37,
            "example": "Sales Cloud"
          },
          "description": {
            "type": "string",
            "required": true,
            "maxCharacters": 108,
            "example": "Pipeline, forecast, territorios y la siguiente acción de cada oportunidad."
          },
          "left": {
            "type": "string",
            "required": true,
            "resolver": "gl-css",
            "example": "--gl-csl-left=140px"
          },
          "top": {
            "type": "string",
            "required": true,
            "resolver": "gl-css",
            "example": "--gl-csl-top=380px"
          }
        }
      },
      "example": [
        {
          "icon": "asset-ref:file:probe",
          "title": "Ventas y revenue",
          "products": "Sales Cloud",
          "description": "Pipeline, forecast, territorios y la siguiente acción de cada oportunidad.",
          "left": "--gl-csl-left=140px",
          "top": "--gl-csl-top=380px"
        },
        {
          "icon": "asset-ref:file:probe",
          "title": "Servicio al cliente",
          "products": "Agentforce Service",
          "description": "Casos, knowledge, routing y SLA con contexto completo del cliente.",
          "left": "--gl-csl-left=562px",
          "top": "--gl-csl-top=380px"
        },
        {
          "icon": "asset-ref:file:probe",
          "title": "Marketing y lifecycle",
          "products": "Marketing Cloud Engagement · Next",
          "description": "Journeys, deliverability y campañas desde identidad y consentimiento.",
          "left": "--gl-csl-left=984px",
          "top": "--gl-csl-top=380px"
        },
        {
          "icon": "asset-ref:file:probe",
          "title": "Datos y consentimiento",
          "products": "Data 360",
          "description": "Identidad unificada, preferencias por canal y activación gobernada.",
          "left": "--gl-csl-left=140px",
          "top": "--gl-csl-top=616px"
        },
        {
          "icon": "asset-ref:file:probe",
          "title": "Agentes y automatización",
          "products": "Agentforce · Flow",
          "description": "Agentes con ficha, supervisión humana y consumo medido.",
          "left": "--gl-csl-left=562px",
          "top": "--gl-csl-top=616px"
        },
        {
          "icon": "asset-ref:file:probe",
          "title": "Integración y experiencia",
          "products": "APIs · Experience Cloud",
          "description": "Migraciones con reconciliación, portales e integraciones con dueño.",
          "left": "--gl-csl-left=984px",
          "top": "--gl-csl-top=616px"
        }
      ]
    },
    "phases": {
      "selector": "[data-slot='phases']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 4,
        "maxItems": 4,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "number": {
            "type": "string",
            "required": true,
            "maxCharacters": 2,
            "example": "01"
          },
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 28,
            "example": "Diagnóstico y arquitectura"
          }
        }
      },
      "example": [
        {
          "number": "01",
          "label": "Diagnóstico y arquitectura"
        },
        {
          "number": "02",
          "label": "Implementación e integración"
        },
        {
          "number": "03",
          "label": "Activación y adopción"
        },
        {
          "number": "04",
          "label": "Operación gestionada"
        }
      ]
    },
    "mascot": {
      "selector": "[data-slot='mascot']",
      "type": "object",
      "required": false,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-file-ref",
          "example": "asset-ref:file:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt",
          "example": "La mascota del partner, de pie sobre la plataforma de luz"
        },
        "left": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-mascot-left=0px"
        },
        "top": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-mascot-top=0px"
        },
        "width": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-mascot-width=0px"
        },
        "shadowY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-mascot-shadow-y=0px"
        },
        "shadowBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-mascot-shadow-blur=0px"
        },
        "shadowColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-csl-mascot-shadow-color=#000610"
        },
        "shadowOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-csl-mascot-shadow-opacity=0%"
        }
      }
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-source.svg"
    }
  }
}
