{
  "template": "CloseBrochure",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "logoLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-logo-left=140px"
        },
        "logoTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-logo-top=140px"
        },
        "logoWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-logo-width=500px"
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 378
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 440
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 124
        },
        "answerInset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-inset=-4px"
        },
        "questionPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-question-px=40px"
        },
        "questionLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-question-leading=1.2"
        },
        "questionColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-question-color=#ffffff"
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-leading=0.95"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-tracking=-0.035em"
        },
        "answerColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-answer-color=#ffffff"
        },
        "sloganTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-slogan-top=710px"
        },
        "sloganPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-slogan-px=28px"
        },
        "sloganLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-slogan-leading=1.15"
        },
        "contactTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-top=780px"
        },
        "contactPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-px=20px"
        },
        "contactWeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-wght=500"
        },
        "contactLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-leading=1.3"
        },
        "contactRowGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-row-gap=18px"
        },
        "contactBubbleHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-bubble-height=32px"
        },
        "contactSocialGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-social-gap=28px"
        },
        "contactSocialIcon": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-social-icon=32px"
        },
        "contactSocialIconGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-social-icon-gap=14px"
        },
        "contactItemIcon": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-item-icon=23px"
        },
        "contactItemGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-item-gap=8px"
        },
        "contactIconOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-contact-icon-opacity=0.78"
        }
      }
    },
    "backdrop": {
      "selector": "[data-slot='backdrop']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-backdrop-ref",
          "example": "asset-ref:layer:probe"
        },
        "alt": {
          "type": "string",
          "required": false,
          "maxCharacters": 320,
          "resolver": "gl-backdrop-alt",
          "example": ""
        }
      }
    },
    "logo": {
      "selector": "[data-slot='logo']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/efeonce-logo-negative.svg"
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 32,
          "example": "¿Conversamos?"
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 14,
          "example": "Cuando"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 14,
          "resolver": "gl-answer",
          "example": "quieras"
        }
      }
    },
    "slogan": {
      "selector": "[data-slot='slogan']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 3,
        "maxItems": 3,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 16
          },
          "style": {
            "type": "string",
            "required": true,
            "resolver": "gl-slogan-run"
          }
        }
      },
      "example": [
        {
          "text": "Empower",
          "style": "800 italic #e2e2e2"
        },
        {
          "text": "your",
          "style": "800 normal #e2e2e2"
        },
        {
          "text": "Growth",
          "style": "900 italic #36c8bf"
        }
      ]
    },
    "contact": {
      "selector": "[data-slot='contact']",
      "type": "object",
      "required": true,
      "shape": {
        "email": {
          "type": "string",
          "required": true,
          "maxCharacters": 48,
          "example": "sales@efeoncepro.com"
        },
        "phoneFirst": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "example": "+56 9 3732 3064"
        },
        "phoneSecond": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "example": "+1 (239) 235-2073"
        },
        "address": {
          "type": "string",
          "required": true,
          "maxCharacters": 80,
          "example": "Dr. Manuel Barros Borgoño 71, of. 1105, Providencia, Chile"
        }
      }
    },
    "cta": {
      "selector": "[data-slot='cta']",
      "type": "object",
      "required": false,
      "shape": {
        "target": {
          "type": "string",
          "required": true,
          "maxCharacters": 8,
          "consumer": "validation-only",
          "example": "answer"
        }
      }
    }
  }
}
