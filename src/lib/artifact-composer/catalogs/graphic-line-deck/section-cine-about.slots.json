{
  "template": "SectionCineAbout",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 110
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 196
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 270
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 164
        },
        "eyebrowPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-eyebrow-px=16px"
        },
        "eyebrowWght": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-eyebrow-wght=500"
        },
        "eyebrowTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-eyebrow-tracking=0.14em"
        },
        "eyebrowColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sec-eyebrow-color=#e2e2e2"
        },
        "questionPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-question-px=40px"
        },
        "questionLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-question-leading=1.2"
        },
        "questionColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sec-question-color=#f4f6f8"
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-answer-leading=0.9"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-answer-tracking=-0.05em"
        },
        "answerInset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-answer-inset=-8px"
        },
        "bodyTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyTop",
          "example": 600
        },
        "bodyPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyPx",
          "example": 27
        },
        "bodyWidth": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyWidth",
          "example": 560
        },
        "bodyLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-body-leading=1.45"
        },
        "figuresTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-figures-top=760px"
        },
        "figurePx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-figure-px=84px"
        },
        "figureTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-figure-tracking=-0.04em"
        },
        "figureGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-figure-gap=40px"
        },
        "labelPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-label-px=20px"
        },
        "labelGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-label-gap=6px"
        },
        "dividerStroke": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-divider=2px"
        },
        "dividerOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-divider-opacity=18%"
        },
        "sourceTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-source-top=902px"
        },
        "sourcePx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-source-px=15px"
        }
      }
    },
    "photo": {
      "selector": "[data-slot='photo']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt",
          "example": "Descripción de la imagen"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 32,
          "example": "Quiénes somos"
        },
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "example": "¿Quiénes somos?"
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 18,
          "example": "Un solo"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 22,
          "resolver": "gl-answer",
          "example": "equipo"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 120,
        "maxLines": 3,
        "overflow": "reject"
      },
      "example": "Creatividad, datos, medios y tecnología en una misma mesa, con un solo interlocutor."
    },
    "figures": {
      "selector": "[data-slot='figures']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 3,
        "maxItems": 3,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "value": {
            "type": "string",
            "required": true,
            "maxCharacters": 6
          },
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 24
          }
        }
      },
      "example": [
        {
          "value": "+10",
          "label": "años como agencia"
        },
        {
          "value": "5",
          "label": "países"
        },
        {
          "value": "1",
          "label": "interlocutor"
        }
      ]
    },
    "source": {
      "selector": "[data-slot='source']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 110,
        "maxLines": 1,
        "overflow": "reject"
      },
      "example": "Fuente: Efeonce, 2026"
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-baked-dark.svg"
    }
  }
}
