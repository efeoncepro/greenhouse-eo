{
  "template": "DecisionPlan",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "engine"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 110
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 196
        },
        "bodyTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyTop",
          "example": 690
        },
        "bodyPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyPx",
          "example": 26
        },
        "bodyWidth": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyWidth",
          "example": 380
        },
        "questionWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-question-width=470px"
        },
        "answerGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-answer-gap=36px"
        },
        "answerSize": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-answer-px=120px"
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-answer-leading=0.9"
        },
        "answerShadowY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-answer-shadow-y=10px"
        },
        "answerShadowBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-answer-shadow-blur=60px"
        },
        "answerShadowOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-answer-shadow-opacity=35%"
        },
        "horizonLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-horizon-left=1050px"
        },
        "horizonTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-horizon-top=40px"
        },
        "horizonPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-horizon-px=560px"
        },
        "horizonOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-horizon-opacity=0.07"
        },
        "haloColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-dp-halo-color=#72ded8"
        },
        "cardWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-card-width=300px"
        },
        "cardRadius": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-card-radius=20px"
        },
        "cardPadTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-card-pad-top=20px"
        },
        "cardPadX": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-card-pad-x=22px"
        },
        "cardPadBottom": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-card-pad-bottom=22px"
        },
        "rangeGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-range-gap=8px"
        },
        "descGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-desc-gap=10px"
        },
        "rangePx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-range-px=15px"
        },
        "titlePx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-title-px=40px"
        },
        "descPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-desc-px=17px"
        },
        "descColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-dp-desc-color=#d6e2ec"
        },
        "currentFillFrom": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-dp-current-from-color=#0f4a5c"
        },
        "currentFillTo": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-dp-current-to-color=#0a2a40"
        },
        "otherFillFrom": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-dp-other-from-color=#0e2a44"
        },
        "otherFillTo": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-dp-other-to-color=#081c30"
        },
        "fillAngle": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-fill-angle=160deg"
        },
        "currentBorder": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-current-border=2px"
        },
        "currentBorderOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-current-border-opacity=90%"
        },
        "currentGlowBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-current-glow-blur=80px"
        },
        "currentGlowOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-current-glow-opacity=45%"
        },
        "otherBorder": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-other-border=1px"
        },
        "otherBorderOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-other-border-opacity=16%"
        },
        "otherGlowBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-other-glow-blur=30px"
        },
        "otherGlowOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-other-glow-opacity=12%"
        },
        "shadowColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-dp-shadow-color=#000610"
        },
        "shadowY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-shadow-y=34px"
        },
        "shadowBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-shadow-blur=80px"
        },
        "shadowOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-shadow-opacity=65%"
        },
        "currentStop": {
          "type": "string",
          "required": true,
          "resolver": "gl-current-stop",
          "example": "1"
        },
        "lumWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lum-width=216px"
        },
        "lumBottom": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lum-bottom=51px"
        },
        "card1Left": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-card1-left=787.74px"
        },
        "card1Bottom": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-card1-bottom=222.76px"
        },
        "card2Left": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-card2-left=1199.06px"
        },
        "card2Bottom": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-card2-bottom=363.14px"
        },
        "card3Left": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-card3-left=1478.94px"
        },
        "card3Bottom": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dp-card3-bottom=633.16px"
        }
      }
    },
    "stage": {
      "selector": "[data-slot='stage']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "trajectory": {
      "selector": "[data-slot='trajectory']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "horizon": {
      "selector": "[data-slot='horizon']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 3,
        "maxLines": 1,
        "overflow": "reject"
      },
      "example": "90"
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "example": "Plan de trabajo"
        },
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 26,
          "example": "¿Qué pasa al empezar?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 11,
          "resolver": "gl-answer",
          "example": "Movimiento"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 120,
        "maxLines": 5,
        "overflow": "reject"
      },
      "example": "<strong>90</strong> días a la primera evidencia medible, en tres tramos de 30. Desde la primera semana ya hay piezas en marcha."
    },
    "stops": {
      "selector": "[data-slot='stops']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 3,
        "maxItems": 3,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "range": {
            "type": "string",
            "required": true,
            "maxCharacters": 16
          },
          "title": {
            "type": "string",
            "required": true,
            "maxCharacters": 13
          },
          "desc": {
            "type": "string",
            "required": true,
            "maxCharacters": 84
          }
        }
      },
      "example": [
        {
          "range": "1 · Días 1–30",
          "title": "Arranque",
          "desc": "Auditoría, línea base y primeras piezas: movimiento desde la primera semana."
        },
        {
          "range": "2 · Días 31–60",
          "title": "Ritmo pleno",
          "desc": "El ciclo mensual completo: planificar, producir, entregar y medir."
        },
        {
          "range": "3 · Días 61–90",
          "title": "Evidencia",
          "desc": "Primera evidencia medible y primer informe de resultados."
        }
      ]
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-source.svg"
    }
  }
}
