{
  "template": "ContentPricingLive",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "engine"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 110
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 196
        },
        "bodyPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyPx",
          "example": 26
        },
        "bodyWidth": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyWidth",
          "example": 380
        },
        "questionWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-flow-question-width=470px"
        },
        "answerGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-flow-answer-gap=36px"
        },
        "bodyGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-flow-body-gap=144px"
        },
        "answerSize": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-flow-answer-px=120px"
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-flow-answer-leading=0.9"
        },
        "answerShadowY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-flow-answer-shadow-y=10px"
        },
        "answerShadowBlur": {
