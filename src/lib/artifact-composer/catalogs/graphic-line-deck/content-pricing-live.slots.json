    "stage": {
      "selector": "[data-slot='stage']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "platform": {
      "selector": "[data-slot='platform']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "example": "Inversión"
        },
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 28,
          "example": "¿Cuánto cuesta?"
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 12,
          "example": "Sin letra"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "resolver": "gl-answer",
          "example": "chica"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 140,
        "maxLines": 5,
        "overflow": "reject"
      },
      "example": "Cada línea de la cotización a la vista, con su <strong>monto</strong> y lo que incluye. Los montos se definen en cada propuesta."
    },
    "quote": {
      "selector": "[data-slot='quote']",
      "type": "object",
      "required": true,
      "shape": {
        "kicker": {
          "type": "string",
          "required": true,
          "maxCharacters": 28,
          "example": "Propuesta · Cotización"
        },
        "title": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "example": "Para tu marca"
        },
        "totalLabel": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "example": "Total mensual"
        },
        "total": {
          "type": "string",
          "required": true,
          "maxCharacters": 10,
          "example": "[MONTO]"
        },
        "tax": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "example": "neto + IVA"
        }
      }
    },
    "lines": {
      "selector": "[data-slot='lines']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 4,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "number": {
            "type": "string",
            "required": true,
            "maxCharacters": 1
          },
          "name": {
            "type": "string",
            "required": true,
            "maxCharacters": 20
          },
          "desc": {
            "type": "string",
            "required": true,
            "maxCharacters": 48
          },
          "amount": {
            "type": "string",
            "required": true,
            "maxCharacters": 20
          }
        }
      },
      "example": [
        {
          "number": "1",
          "name": "Equipo",
          "desc": "Capacidad gobernada del squad",
          "amount": "[MONTO] / mes"
        },
        {
          "number": "2",
          "name": "Greenhouse Pro",
          "desc": "Dashboard, KPIs, acciones y reporting quincenal",
          "amount": "[MONTO] / mes"
        },
        {
          "number": "3",
          "name": "Sample Sprint",
          "desc": "Piloto pagado y acotado para arrancar",
          "amount": "[MONTO] · único"
        }
      ]
    },
    "chips": {
      "selector": "[data-slot='chips']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 2,
        "maxItems": 2,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "kicker": {
            "type": "string",
            "required": true,
            "maxCharacters": 18
          },
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 48
          }
        }
      },
      "example": [
        {
          "kicker": "Cómo se mide",
          "text": "Capacidad gobernada,\nnunca horas ni piezas"
        },
        {
          "kicker": "Sin sorpresas",
          "text": "Valores netos,\nIVA no incluido"
        }
      ]
    },
    "cta": {
      "selector": "[data-slot='cta']",
      "type": "object",
      "required": true,
      "shape": {
        "text": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "example": "Aprobar propuesta"
        },
        "cursorScale": {
          "type": "number",
          "required": true,
          "consumer": "validation-only",
          "example": 1.2
        }
      }
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-source.svg"
    }
  }
}
