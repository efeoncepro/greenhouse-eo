          "example": "--gl-sur-answer-leading=0.9"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sur-answer-tracking=-0.05em"
        },
        "answerInset": {
          "type": "string",
          "required": true,
