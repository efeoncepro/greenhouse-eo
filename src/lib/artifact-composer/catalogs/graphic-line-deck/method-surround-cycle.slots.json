        },
        "titleLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sur-title-leading=1"
        },
        "titleTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sur-title-tracking=-0.03em"
        },
        "titleGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sur-title-gap=6px"
