    },
    "stage": {
      "selector": "[data-slot='stage']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "loop": {
      "selector": "[data-slot='loop']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 51,
          "example": "Surround Discovery"
        },
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 21,
          "example": "¿Cómo se sostiene?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 8,
          "resolver": "gl-answer",
          "example": "En ciclo"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 161,
        "maxLines": 6,
        "overflow": "reject"
      },
      "example": "La visibilidad ante la IA no se «logra»: se sostiene. Cada ciclo aprende del anterior y te sube un <strong>nivel</strong>."
    },
    "stations": {
      "selector": "[data-slot='stations']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 4,
        "maxItems": 4,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "role": {
            "type": "string",
            "required": true,
            "resolver": "gl-item-role"
          },
          "iconLeft": {
            "type": "string",
            "required": true,
            "resolver": "gl-css"
          },
          "iconTop": {
            "type": "string",
            "required": true,
            "resolver": "gl-css"
          },
          "iconSize": {
            "type": "string",
            "required": true,
            "resolver": "gl-css"
          },
          "cardLeft": {
            "type": "string",
            "required": true,
            "resolver": "gl-css"
          },
          "cardTop": {
            "type": "string",
            "required": true,
            "resolver": "gl-css"
          },
          "cardWidth": {
            "type": "string",
            "required": true,
            "resolver": "gl-css"
          },
          "src": {
            "type": "string",
            "required": true,
            "resolver": "gl-file-ref"
          },
          "number": {
            "type": "string",
            "required": true,
            "maxCharacters": 2
          },
          "start": {
            "type": "string",
            "required": false,
            "maxCharacters": 14
          },
          "title": {
            "type": "string",
            "required": true,
            "maxCharacters": 14
          },
          "description": {
            "type": "string",
            "required": true,
            "maxCharacters": 155
          }
        }
      },
      "example": [
        {
          "role": "lead",
          "iconLeft": "--gl-sur-icon-left=1231px",
          "iconTop": "--gl-sur-icon-top=367.96px",
          "iconSize": "--gl-sur-icon-size=118px",
          "cardLeft": "--gl-sur-card-left=1110px",
          "cardTop": "--gl-sur-card-top=160px",
          "cardWidth": "--gl-sur-card-width=360px",
          "src": "asset-ref:file:probe",
          "number": "01",
          "start": "Empieza aquí",
          "title": "Medir",
          "description": "Tu visibilidad en ChatGPT, AI Overviews, Gemini, Perplexity, Copilot y Claude, por mercado y por prompt."
        },
        {
          "role": "rest",
          "iconLeft": "--gl-sur-icon-left=1620px",
          "iconTop": "--gl-sur-icon-top=522px",
          "iconSize": "--gl-sur-icon-size=100px",
          "cardLeft": "--gl-sur-card-left=1560px",
          "cardTop": "--gl-sur-card-top=338px",
          "cardWidth": "--gl-sur-card-width=300px",
          "src": "asset-ref:file:probe",
          "number": "02",
          "title": "Crear",
          "description": "Los activos que los motores entienden, citan y reproducen. No más contenido: el correcto."
        },
        {
          "role": "rest",
          "iconLeft": "--gl-sur-icon-left=1240px",
          "iconTop": "--gl-sur-icon-top=662px",
          "iconSize": "--gl-sur-icon-size=100px",
          "cardLeft": "--gl-sur-card-left=1110px",
          "cardTop": "--gl-sur-card-top=804px",
          "cardWidth": "--gl-sur-card-width=360px",
          "src": "asset-ref:file:probe",
          "number": "03",
          "title": "Distribuir",
          "description": "Tu presencia en cada superficie donde los motores descubren marcas, no sólo en tu sitio."
        },
        {
          "role": "rest",
          "iconLeft": "--gl-sur-icon-left=860px",
          "iconTop": "--gl-sur-icon-top=522px",
          "iconSize": "--gl-sur-icon-size=100px",
          "cardLeft": "--gl-sur-card-left=620px",
          "cardTop": "--gl-sur-card-top=660px",
          "cardWidth": "--gl-sur-card-width=300px",
          "src": "asset-ref:file:probe",
          "number": "04",
          "title": "Optimizar",
          "description": "Cada ciclo aprende del anterior: subes un nivel, medimos y corregimos."
        }
      ]
    },
    "core": {
      "selector": "[data-slot='core']",
      "type": "object",
      "required": true,
      "shape": {
        "title": {
          "type": "string",
          "required": true,
          "maxCharacters": 15,
          "example": "Tu marca"
        },
        "caption": {
          "type": "string",
          "required": false,
          "maxCharacters": 34,
          "example": "sube un nivel en cada vuelta"
        }
      }
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-source.svg"
    }
  }
}
