        },
        "lumBottom": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lum-bottom=51px"
        },
        "answerShadowColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sur-answer-shadow-color=#000000"
        },
        "cardGlowColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sur-card-glow-color=#72ded8"
        },
        "coreGlowColor": {
          "type": "string",
          "required": true,
