{
  "template": "SectionCinePurpose",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 110
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 196
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 270
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 176
        },
        "eyebrowPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-eyebrow-px=16px"
        },
        "eyebrowWght": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-eyebrow-wght=500"
        },
        "eyebrowTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-eyebrow-tracking=0.14em"
        },
        "eyebrowColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sec-eyebrow-color=#e2e2e2"
        },
        "questionPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-question-px=40px"
        },
        "questionLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-question-leading=1.2"
        },
        "questionColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sec-question-color=#f4f6f8"
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-answer-leading=0.9"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-answer-tracking=-0.05em"
        },
        "answerInset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sec-answer-inset=-8px"
        },
        "bodyTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyTop",
          "example": 470
        },
        "bodyPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyPx",
          "example": 34
        },
        "bodyWidth": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyWidth",
          "example": 700
        },
        "bodyLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-body-leading=1.35"
        },
        "bodyColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-sc-body-color=#ffffff"
        },
        "pillarsTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-pillars-top=690px"
        },
        "pillarsWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-pillars-width=700px"
        },
        "pillarPadY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-pillar-pad-y=14px"
        },
        "pillarGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-pillar-gap=18px"
        },
        "pillarStroke": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-pillar-rule=1px"
        },
        "pillarRuleOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-pillar-rule-opacity=16%"
        },
        "pillarLabelPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-pillar-label-px=22px"
        },
        "pillarLabelWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-pillar-label-width=250px"
        },
        "pillarTextPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sc-pillar-text-px=20px"
        }
      }
    },
    "photo": {
      "selector": "[data-slot='photo']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt",
          "example": "Descripción de la imagen"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "example": "Por qué lo hacemos"
        },
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 26,
          "example": "¿Por qué lo hacemos así?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 9,
          "resolver": "gl-answer",
          "example": "Contigo"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 110,
        "maxLines": 3,
        "overflow": "reject"
      },
      "example": "No te entregamos crecimiento. Lo construimos contigo, y te dejamos <strong>más capaz</strong> de sostenerlo."
    },
    "pillars": {
      "selector": "[data-slot='pillars']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 3,
        "maxItems": 3,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 22
          },
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 70
          }
        }
      },
      "example": [
        {
          "label": "Co-creación",
          "text": "operas con nosotros en vivo, en tu panel, no con un PDF el viernes."
        },
        {
          "label": "Educación",
          "text": "te dejamos más capaz, no dependiente: mejores briefs, mejor trabajo."
        },
        {
          "label": "Crecimiento integral",
          "text": "se compone ciclo a ciclo; los números son el resultado, no el origen."
        }
      ]
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-baked-dark.svg"
    }
  }
}
