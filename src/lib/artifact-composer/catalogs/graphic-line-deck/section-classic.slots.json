{
  "template": "SectionClassic",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 420
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 495
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 120
        },
        "ringCx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ring-cx=1420px"
        },
        "numberTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-number-top=430px"
        },
        "labelTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-label-top=640px"
        },
        "numberPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-number-px=190px"
        },
        "numberWeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-number-wght=300"
        },
        "labelPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-label-px=24px"
        },
        "columnWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-column-width=1080px"
        }
      }
    },
    "orbit": {
      "selector": "[data-slot='orbit']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "progress": {
      "selector": "[data-slot='progress']",
      "type": "object",
      "required": true,
      "shape": {
        "number": {
          "type": "string",
          "required": true,
          "maxCharacters": 2,
          "example": "02"
        },
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "example": "Sección 2 de 5"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "example": "¿Quién decide el corte?"
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "example": ""
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "resolver": "gl-answer",
          "example": "El dato"
        }
      }
    }
  }
}
