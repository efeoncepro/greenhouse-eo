{
  "template": "DecisionAgenda",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 110
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 200
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 270
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 140
        },
        "questionPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-question-px=40px"
        },
        "questionLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-question-leading=1.2"
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-answer-leading=0.95"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-answer-tracking=-0.04em"
        },
        "answerInset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-answer-inset=-6px"
        },
        "listLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-list-left=820px"
        },
        "listTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-list-top=170px"
        },
        "listWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-list-width=960px"
        },
        "rowGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-row-gap=40px"
        },
        "rule": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-rule=2px"
        },
        "padTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-pad-top=18px"
        },
        "padBottom": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-pad-bottom=22px"
        },
        "numberPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-number-px=80px"
        },
        "numberWght": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-number-wght=300"
        },
        "numberTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-number-tracking=-0.04em"
        },
        "numberWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-number-width=130px"
        },
        "topicPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-topic-px=46px"
        },
        "topicTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-topic-tracking=-0.01em"
        },
        "topicChosenWght": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ag-topic-chosen-wght=600"
        }
      }
    },
    "indicator": {
      "selector": "[data-slot='indicator']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 32,
          "example": "Agenda"
        },
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "example": "¿Qué veremos hoy?"
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 18,
          "example": "Cinco"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 22,
          "resolver": "gl-answer",
          "example": "temas"
        }
      }
    },
    "topics": {
      "selector": "[data-slot='topics']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 5,
        "maxItems": 5,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "role": {
            "type": "string",
            "required": true,
            "resolver": "gl-item-role"
          },
          "number": {
            "type": "string",
            "required": true,
            "maxCharacters": 2
          },
          "topic": {
            "type": "string",
            "required": true,
            "maxCharacters": 24
          }
        }
      },
      "example": [
        {
          "role": "rest",
          "number": "01",
          "topic": "Quiénes somos"
        },
        {
          "role": "rest",
          "number": "02",
          "topic": "Cómo trabajamos"
        },
        {
          "role": "rest",
          "number": "03",
          "topic": "Resultados"
        },
        {
          "role": "lead",
          "number": "04",
          "topic": "Nuestra propuesta"
        },
        {
          "role": "rest",
          "number": "05",
          "topic": "Próximos pasos"
        }
      ]
    },
    "selection": {
      "selector": "[data-slot='selection']",
      "type": "object",
      "required": false,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "consumer": "validation-only",
          "example": "Cliente"
        },
        "anchor": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "bottom-start"
        },
        "participantKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "department"
        },
        "scale": {
          "type": "number",
          "required": false,
          "consumer": "validation-only",
          "example": 1.1
        },
        "targetKind": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "object"
        },
        "variant": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "eight-handles"
        },
        "padding": {
          "type": "string",
          "required": false,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "standard"
        },
        "overlay": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "none"
        },
        "item": {
          "type": "number",
          "required": true,
          "consumer": "validation-only",
          "example": 4
        }
      }
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-baked-light.svg"
    }
  }
}
