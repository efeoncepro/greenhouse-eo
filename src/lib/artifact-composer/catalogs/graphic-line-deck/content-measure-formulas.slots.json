{
  "template": "ContentMeasureFormulas",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "revenue-salesforce"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 110
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 196
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 330
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 150
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-leading=0.9"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-tracking=-0.05em"
        },
        "answerInset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-inset=-8px"
        },
        "questionWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-question-width=500px"
        },
        "bodyTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyTop",
          "example": 690
        },
        "bodyPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyPx",
          "example": 26
        },
        "bodyWidth": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyWidth",
          "example": 420
        },
        "answerShadowY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-shadow-y=10px"
        },
        "answerShadowBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-shadow-blur=60px"
        },
        "answerShadowOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-shadow-opacity=35%"
        },
        "answerShadowColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-answer-shadow-color=#000000"
        },
        "lumWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lum-width=216px"
        },
        "lumBottom": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lum-bottom=51px"
        },
        "noteRight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-note-right=120px"
        },
        "noteTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-note-top=112px"
        },
        "notePx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-note-px=16px"
        },
        "noteWeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-note-wght=400"
        },
        "noteColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-note-color=#e2e2e2"
        },
        "lsGlassFrom": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-glass-from-color=#ffffff"
        },
        "lsGlassFromOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-from-opacity=14%"
        },
        "lsGlassTo": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-glass-to-color=#ffffff"
        },
        "lsGlassToOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-to-opacity=4%"
        },
        "lsGlassAngle": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-angle=160deg"
        },
        "lsGlassBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-blur=6px"
        },
        "lsGlassBorder": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-border=1px"
        },
        "lsGlassBorderColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-glass-border-color=#ffffff"
        },
        "lsGlassBorderOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-border-opacity=18%"
        },
        "lsGlassShadowY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-shadow-y=30px"
        },
        "lsGlassShadowBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-shadow-blur=70px"
        },
        "lsGlassShadowColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-glass-shadow-color=#000610"
        },
        "lsGlassShadowOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-shadow-opacity=60%"
        },
        "cardWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-card-width=330px"
        },
        "cardHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-card-height=262px"
        },
        "cardPadY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-card-pad-y=22px"
        },
        "cardPadX": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-card-pad-x=24px"
        },
        "cardRadius": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-card-radius=22px"
        },
        "iconSize": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-icon=52px"
        },
        "titlePx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-title-px=28px"
        },
        "titleTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-title-tracking=-0.56px"
        },
        "titleGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-title-gap=16px"
        },
        "titleColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-cmf-title-color=#ffffff"
        },
        "formulaPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-formula-px=16px"
        },
        "formulaWeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-formula-wght=500"
        },
        "formulaLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-formula-leading=1.4"
        },
        "formulaGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-formula-gap=10px"
        },
        "formulaPadY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-formula-pad-y=8px"
        },
        "formulaPadX": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-formula-pad-x=12px"
        },
        "formulaRadius": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-formula-radius=10px"
        },
        "formulaFill": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-cmf-formula-fill-color=#ffffff"
        },
        "formulaFillOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-formula-fill-opacity=8%"
        },
        "formulaColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-cmf-formula-color=#e6edf3"
        },
        "metaPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-meta-px=13px"
        },
        "metaWeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-meta-wght=500"
        },
        "metaTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-meta-tracking=1.3px"
        },
        "metaGapFirst": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-meta-gap-first=12px"
        },
        "metaGapNext": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cmf-meta-gap-next=6px"
        },
        "metaColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-cmf-meta-color=#e2e2e2"
        }
      }
    },
    "stage": {
      "selector": "[data-slot='stage']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "platform": {
      "selector": "[data-slot='platform']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 44,
          "example": "¿Cómo sabes que funciona?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 9,
          "resolver": "gl-answer",
          "example": "medimos"
        },
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 51,
          "example": "Qué medimos"
        },
        "answerLead": {
          "type": "string",
          "required": true,
          "maxCharacters": 9,
          "example": "Lo"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 179,
        "maxLines": 6,
        "overflow": "reject"
      },
      "example": "Cada métrica con su fórmula, su fuente y un <strong>dueño</strong>, desde el diagnóstico."
    },
    "note": {
      "selector": "[data-slot='note']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 115,
        "maxLines": 1,
        "overflow": "reject"
      },
      "example": "Sin cifras de promesa: la línea base se mide en el diagnóstico"
    },
    "metrics": {
      "selector": "[data-slot='metrics']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 5,
        "maxItems": 5,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "icon": {
            "type": "string",
            "required": true,
            "resolver": "gl-icon-ref",
            "example": "asset-ref:icon:probe"
          },
          "name": {
            "type": "string",
            "required": true,
            "maxCharacters": 19,
            "example": "Adopción"
          },
          "formula": {
            "type": "string",
            "required": true,
            "maxCharacters": 58,
            "example": "Usuarios activos ÷ licencias"
          },
          "sourceLabel": {
            "type": "string",
            "required": true,
            "maxCharacters": 6,
            "example": "Fuente"
          },
          "source": {
            "type": "string",
            "required": true,
            "maxCharacters": 30,
            "example": "Salesforce"
          },
          "ownerLabel": {
            "type": "string",
            "required": true,
            "maxCharacters": 6,
            "example": "Dueño"
          },
          "owner": {
            "type": "string",
            "required": true,
            "maxCharacters": 30,
            "example": "Líder del área"
          },
          "left": {
            "type": "string",
            "required": true,
            "resolver": "gl-css",
            "example": "--gl-cmf-left=760px"
          },
          "top": {
            "type": "string",
            "required": true,
            "resolver": "gl-css",
            "example": "--gl-cmf-top=190px"
          }
        }
      },
      "example": [
        {
          "icon": "asset-ref:icon:probe",
          "name": "Adopción",
          "formula": "Usuarios activos ÷ licencias",
          "sourceLabel": "Fuente",
          "source": "Salesforce",
          "ownerLabel": "Dueño",
          "owner": "Líder del área",
          "left": "--gl-cmf-left=760px",
          "top": "--gl-cmf-top=190px"
        },
        {
          "icon": "asset-ref:icon:probe",
          "name": "Primer valor",
          "formula": "Días del kickoff al primer valor acordado",
          "sourceLabel": "Fuente",
          "source": "Plan del proyecto",
          "ownerLabel": "Dueño",
          "owner": "Efeonce",
          "left": "--gl-cmf-left=1110px",
          "top": "--gl-cmf-top=190px"
        },
        {
          "icon": "asset-ref:icon:probe",
          "name": "Soporte en SLA",
