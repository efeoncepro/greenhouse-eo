          "ownerLabel": "Dueño",
          "owner": "Efeonce",
          "left": "--gl-cmf-left=1460px",
          "top": "--gl-cmf-top=190px"
        },
        {
          "icon": "asset-ref:icon:probe",
          "name": "Calidad de datos",
          "formula": "Registros completos y sin duplicar ÷ total",
          "sourceLabel": "Fuente",
          "source": "Data 360 · informes",
          "ownerLabel": "Dueño",
          "owner": "Admin de tu org",
          "left": "--gl-cmf-left=935px",
