        },
        {
          "icon": "asset-ref:icon:probe",
          "name": "Agentes",
          "formula": "Propuestas aprobadas sin corrección ÷ total",
          "sourceLabel": "Fuente",
          "source": "Agentforce",
          "ownerLabel": "Dueño",
          "owner": "Supervisora",
