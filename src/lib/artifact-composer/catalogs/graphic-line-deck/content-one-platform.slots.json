          "label": "Oportunidad",
          "value": "En negociación"
        },
        {
          "label": "Caso abierto",
          "value": "Dentro del SLA"
        },
        {
          "label": "Journey",
          "value": "Bienvenida · paso 3"
        },
        {
          "label": "Consentimiento",
