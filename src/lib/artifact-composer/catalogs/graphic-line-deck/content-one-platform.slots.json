    "stage": {
      "selector": "[data-slot='stage']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "platform": {
      "selector": "[data-slot='platform']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "beams": {
      "selector": "[data-slot='beams']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 44,
          "example": "¿Cuántos Salesforce tienes?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 7,
          "resolver": "gl-answer",
          "example": "Uno"
        },
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 51,
          "example": "Salesforce · RevOps y CRM"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 179,
        "maxLines": 6,
        "overflow": "reject"
      },
      "example": "Conectamos CRM, servicio, marketing, datos y agentes para que Salesforce funcione como <strong>una</strong> sola operación alrededor del cliente."
    },
    "workAreas": {
      "selector": "[data-slot='workAreas']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 5,
        "maxItems": 5,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "icon": {
            "type": "string",
            "required": true,
            "resolver": "gl-file-ref",
            "example": "asset-ref:file:probe"
          },
          "area": {
            "type": "string",
            "required": true,
            "maxCharacters": 12,
            "example": "Ventas"
          },
          "product": {
            "type": "string",
            "required": true,
            "maxCharacters": 20,
            "example": "Sales Cloud"
          },
          "left": {
            "type": "string",
            "required": true,
            "resolver": "gl-css",
            "example": "--gl-opl-left=760px"
          },
          "top": {
            "type": "string",
            "required": true,
            "resolver": "gl-css",
            "example": "--gl-opl-top=250px"
          },
          "rotate": {
            "type": "string",
            "required": true,
            "resolver": "gl-css",
            "example": "--gl-opl-rotate=-10deg"
          }
        }
      },
      "example": [
        {
          "icon": "asset-ref:file:probe",
          "area": "Ventas",
          "product": "Sales Cloud",
          "left": "--gl-opl-left=760px",
          "top": "--gl-opl-top=250px",
          "rotate": "--gl-opl-rotate=-10deg"
        },
        {
          "icon": "asset-ref:file:probe",
          "area": "Servicio",
          "product": "Service Cloud",
          "left": "--gl-opl-left=1430px",
          "top": "--gl-opl-top=220px",
          "rotate": "--gl-opl-rotate=10deg"
        },
        {
          "icon": "asset-ref:file:probe",
          "area": "Marketing",
          "product": "Engagement y Next",
          "left": "--gl-opl-left=670px",
          "top": "--gl-opl-top=640px",
          "rotate": "--gl-opl-rotate=-14deg"
        },
        {
          "icon": "asset-ref:file:probe",
          "area": "Datos",
          "product": "Data 360",
          "left": "--gl-opl-left=1500px",
          "top": "--gl-opl-top=640px",
          "rotate": "--gl-opl-rotate=14deg"
        },
        {
          "icon": "asset-ref:file:probe",
          "area": "Agentes",
          "product": "Agentforce",
          "left": "--gl-opl-left=1105px",
          "top": "--gl-opl-top=110px",
          "rotate": "--gl-opl-rotate=0deg"
        }
      ]
    },
