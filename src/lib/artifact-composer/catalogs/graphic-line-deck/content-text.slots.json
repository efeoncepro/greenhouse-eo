{
  "template": "ContentText",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 110
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 200
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 270
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 400
        },
        "questionPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ct-question-px=48px"
        },
        "questionLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ct-question-leading=1.2"
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ct-answer-leading=1"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ct-answer-tracking=-0.05em"
        },
        "answerInset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ct-answer-inset=-16px"
        },
        "bodyTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyTop",
          "example": 826
        },
        "bodyPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyPx",
          "example": 36
        },
        "bodyWidth": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyWidth",
          "example": 860
        },
        "bodyLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ct-body-leading=1.35"
        },
        "pointsTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ct-points-top=872px"
        },
        "pointsRight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ct-points-right=140px"
        },
        "pointsWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ct-points-width=620px"
        },
        "pointPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ct-point-px=22px"
        },
        "pointGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ct-point-gap=8px"
        },
        "pointPad": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ct-point-pad=10px"
        },
        "pointRule": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ct-point-rule=2px"
        }
      }
    },
    "indicator": {
      "selector": "[data-slot='indicator']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 32,
          "example": "Por qué existimos"
        },
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "example": "¿Con quién crece tu marca?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 10,
          "resolver": "gl-answer",
          "example": "Contigo"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 110,
        "maxLines": 2,
        "overflow": "reject"
      },
      "example": "No te entregamos crecimiento. Lo construimos contigo y te dejamos más capaz de sostenerlo."
    },
    "points": {
      "selector": "[data-slot='points']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 3,
        "maxItems": 3,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "name": {
            "type": "string",
            "required": true,
            "maxCharacters": 16
          },
          "text": {
            "type": "string",
            "required": true,
            "maxCharacters": 40
          }
        }
      },
      "example": [
        {
          "name": "Co-creación",
          "text": "· operas con nosotros en vivo"
        },
        {
          "name": "Educación",
          "text": "· te hacemos mejor, no dependiente"
        },
        {
          "name": "Integralidad",
          "text": "· un solo interlocutor"
        }
      ]
    },
    "selection": {
      "selector": "[data-slot='selection']",
      "type": "object",
      "required": false,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "consumer": "validation-only",
          "example": "Cliente"
        },
        "anchor": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "bottom-end"
        },
        "participantKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "role"
        },
        "scale": {
          "type": "number",
          "required": false,
          "consumer": "validation-only",
          "example": 1.6
        }
      }
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-baked-dark.svg"
    }
  }
}
