{
  "template": "ProposalService",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "engine"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 110
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 200
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 270
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 140
        },
        "bodyTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyTop",
          "example": 440
        },
        "bodyPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyPx",
          "example": 26
        },
        "bodyWidth": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyWidth",
          "example": 900
        },
        "lensLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-lens-left=1300px"
        },
        "lensTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-lens-top=110px"
        },
        "lensSize": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-lens-size=440px"
        },
        "cardsTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-cards-top=680px"
        },
        "cardWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-card-width=395px"
        },
        "cardHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-card-height=270px"
        },
        "cardGutter": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-card-gutter=20px"
        },
        "cardRadius": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-card-radius=16px"
        },
        "cardPadding": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-card-padding=26px"
        },
        "cardStroke": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-card-stroke=1.5px"
        },
        "cardShadowY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-card-shadow-y=30px"
        },
        "cardShadowBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-card-shadow-blur=70px"
        },
        "cardShadowOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-card-shadow-opacity=40%"
        },
        "nameGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-name-gap=10px"
        },
        "descGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-desc-gap=12px"
        },
        "kickerPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-kicker-px=15px"
        },
        "namePx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-name-px=38px"
        },
        "descPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-desc-px=19px"
        },
        "footTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-foot-top=1000px"
        },
        "footLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-foot-left=660px"
        },
        "footPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ps-foot-px=16px"
        }
      }
    },
    "photo": {
      "selector": "[data-slot='photo']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt",
          "example": "Una directora creativa con el hoodie de Efeonce dirige con las manos una órbita de pantallas flotantes"
        }
      }
    },
    "lens": {
      "selector": "[data-slot='lens']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "example": "Nuestra propuesta · AEO"
        },
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 32,
          "example": "¿Te encuentra la IA?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 14,
          "resolver": "gl-answer",
          "example": "Visible"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 140,
        "maxLines": 2,
        "overflow": "reject"
      },
      "example": "Vendemos visibilidad, entrando por SEO: que buscadores y motores de respuesta te encuentren, te entiendan y te recomienden."
    },
    "steps": {
      "selector": "[data-slot='steps']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 3,
        "maxItems": 4,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "kicker": {
            "type": "string",
            "required": true,
            "maxCharacters": 36
          },
          "name": {
            "type": "string",
            "required": true,
            "maxCharacters": 24
          },
          "desc": {
            "type": "string",
            "required": true,
            "maxCharacters": 90
          }
        }
      },
      "example": [
        {
          "kicker": "Empieza aquí · sin costo",
          "name": "Diagnóstico",
          "desc": "Brand Visibility Grader: tu presencia en ChatGPT, Claude, Perplexity, Gemini y Google."
        },
        {
          "kicker": "Proyecto",
          "name": "Foundation",
          "desc": "Proyecto de precio fijo: base técnica, entidad y contenido."
        },
        {
          "kicker": "On-Going",
          "name": "Operación",
          "desc": "Retainer mensual de visibilidad por capacidad declarada."
        },
        {
          "kicker": "Greenhouse",
          "name": "Plataforma",
          "desc": "Portal, métricas ICO y medición continua."
        }
      ]
    },
    "footnote": {
      "selector": "[data-slot='footnote']",
      "type": "string",
      "required": false,
      "constraints": {
        "maxCharacters": 110,
        "maxLines": 1,
        "overflow": "reject"
      },
      "example": "Sin promesas de ranking: medimos y mostramos el avance."
    },
    "selection": {
      "selector": "[data-slot='selection']",
      "type": "object",
      "required": false,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "consumer": "validation-only",
          "example": "Cliente"
        },
        "anchor": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "top-end"
        },
        "participantKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "department"
        },
        "scale": {
          "type": "number",
          "required": false,
          "consumer": "validation-only",
          "example": 1.1
        },
        "targetKind": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "object"
        },
        "variant": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "eight-handles"
        },
        "padding": {
          "type": "string",
          "required": false,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "standard"
        },
        "overlay": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "none"
        }
      }
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-baked-dark.svg"
    }
  }
}
