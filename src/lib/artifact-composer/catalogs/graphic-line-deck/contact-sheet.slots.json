{
  "template": "ContactSheet",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 380
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 492
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 210
        },
        "questionPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-question-px=40px"
        },
        "questionLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-question-leading=1.25"
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-answer-leading=1"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-answer-tracking=-0.05em"
        },
        "answerInset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-answer-inset=-8px"
        },
        "questionWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-question-width=230px"
        },
        "bgX": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-bg-x=66%"
        },
        "bgY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-bg-y=46%"
        },
        "bgRx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-bg-rx=62%"
        },
        "bgRy": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-bg-ry=70%"
        },
        "bgFrom": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-cs-bg-from-color=#0b3257"
        },
        "bgMid": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-cs-bg-mid-color=#04223f"
        },
        "bgMidAt": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-bg-mid-at=45%"
        },
        "bgTo": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-cs-bg-to-color=#000f1f"
        },
        "chosenLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-chosen-left=820px"
        },
        "chosenTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-chosen-top=150px"
        },
        "chosenWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-chosen-width=960px"
        },
        "chosenHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-chosen-height=540px"
        },
        "chosenShadow1Y": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-chosen-shadow1-y=40px"
        },
        "chosenShadow1Blur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-chosen-shadow1-blur=80px"
        },
        "chosenShadow1Opacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-chosen-shadow1-opacity=60%"
        },
        "chosenShadow2Y": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-chosen-shadow2-y=12px"
        },
        "chosenShadow2Blur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-chosen-shadow2-blur=24px"
        },
        "chosenShadow2Opacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-chosen-shadow2-opacity=45%"
        },
        "stripLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-strip-left=820px"
        },
        "stripTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-strip-top=790px"
        },
        "stripWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-strip-width=284px"
        },
        "stripHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-strip-height=160px"
        },
        "stripGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-strip-gap=54px"
        },
        "stripShadow1Y": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-strip-shadow1-y=22px"
        },
        "stripShadow1Blur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-strip-shadow1-blur=40px"
        },
        "stripShadow1Opacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-strip-shadow1-opacity=55%"
        },
        "stripShadow2Y": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-strip-shadow2-y=6px"
        },
        "stripShadow2Blur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-strip-shadow2-blur=12px"
        },
        "stripShadow2Opacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-strip-shadow2-opacity=40%"
        },
        "captionPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-caption-px=16px"
        },
        "captionTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-caption-tracking=0.02em"
        },
        "captionGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-cs-caption-gap=16px"
        },
        "captionColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-cs-caption-color=#9fb3c8"
        }
      }
    },
    "marks": {
      "selector": "[data-slot='marks']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "chosen": {
      "selector": "[data-slot='chosen']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt",
          "example": "Descripción de la imagen"
        }
      }
    },
    "strip": {
      "selector": "[data-slot='strip']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 3,
        "maxItems": 3,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "src": {
            "type": "string",
            "required": true,
            "resolver": "gl-plate-ref"
          },
          "alt": {
            "type": "string",
            "required": true,
            "maxCharacters": 80,
            "resolver": "gl-alt"
          },
          "caption": {
            "type": "string",
            "required": true,
            "maxCharacters": 32
          }
        }
      },
      "example": [
        {
          "src": "asset-ref:plate:probe",
          "alt": "Un editor decide el corte frente a la línea de tiempo",
          "caption": "02 · El corte"
        },
        {
          "src": "asset-ref:plate:probe",
          "alt": "El equipo revisa las pruebas impresas en la mesa de luz",
          "caption": "03 · Revisión en mesa de luz"
        },
        {
          "src": "asset-ref:plate:probe",
          "alt": "Una estratega muestra la prueba aprobada al equipo del cliente",
          "caption": "04 · El cliente la aprueba"
        }
      ]
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 28,
          "example": "¿Cuál sale al cliente?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 22,
          "resolver": "gl-answer",
          "example": "Ésta"
        }
      }
    },
    "selection": {
      "selector": "[data-slot='selection']",
      "type": "object",
      "required": false,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "consumer": "validation-only",
          "example": "Dirección de arte"
        },
        "anchor": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "bottom-start"
        },
        "participantKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "department"
        },
        "scale": {
          "type": "number",
          "required": false,
          "consumer": "validation-only",
          "example": 1.4
        },
        "targetKind": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "object"
        },
        "variant": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "eight-handles"
        },
        "padding": {
          "type": "string",
          "required": false,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "standard"
        },
        "overlay": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "subtle"
        },
        "item": {
          "type": "number",
          "required": true,
          "consumer": "validation-only",
          "example": 1
        }
      }
    }
  }
}
