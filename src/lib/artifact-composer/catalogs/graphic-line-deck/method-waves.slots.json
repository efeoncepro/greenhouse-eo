{
  "template": "MethodWaves",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "revenue-salesforce"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 110
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 196
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 330
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 150
        },
        "answerLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-leading=0.9"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-tracking=-0.05em"
        },
        "answerInset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-inset=-8px"
        },
        "questionWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-question-width=500px"
        },
        "bodyTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyTop",
          "example": 690
        },
        "bodyPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyPx",
          "example": 26
        },
        "bodyWidth": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyWidth",
          "example": 420
        },
        "answerShadowY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-shadow-y=10px"
        },
        "answerShadowBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-shadow-blur=60px"
        },
        "answerShadowOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-answer-shadow-opacity=35%"
        },
        "answerShadowColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-answer-shadow-color=#000000"
        },
        "lumWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lum-width=216px"
        },
        "lumBottom": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-lum-bottom=51px"
        },
        "lsGlassFrom": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-glass-from-color=#ffffff"
        },
        "lsGlassFromOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-from-opacity=14%"
        },
        "lsGlassTo": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-glass-to-color=#ffffff"
        },
        "lsGlassToOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-to-opacity=4%"
        },
        "lsGlassAngle": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-angle=160deg"
        },
        "lsGlassBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-blur=6px"
        },
        "lsGlassBorder": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-border=1px"
        },
        "lsGlassBorderColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-glass-border-color=#ffffff"
        },
        "lsGlassBorderOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-border-opacity=18%"
        },
        "lsGlassShadowY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-shadow-y=30px"
        },
        "lsGlassShadowBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-shadow-blur=70px"
        },
        "lsGlassShadowColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-glass-shadow-color=#000610"
        },
        "lsGlassShadowOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-glass-shadow-opacity=60%"
        },
        "docFill": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-doc-color=#ffffff"
        },
        "docInk": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-doc-ink-color=#0b1f33"
        },
        "docMuted": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-doc-muted-color=#5f6b7a"
        },
        "docRule": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-doc-rule-color=#e3e8ee"
        },
        "docChip": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-doc-chip-color=#f5f7fa"
        },
        "docShadowY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-doc-shadow-y=50px"
        },
        "docShadowBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-doc-shadow-blur=110px"
        },
        "docShadowColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-doc-shadow-color=#000610"
        },
        "docShadowOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-doc-shadow-opacity=75%"
        },
        "docHaloBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-doc-halo-blur=90px"
        },
        "docHaloColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-doc-halo-color=#2fb8ff"
        },
        "docHaloOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-doc-halo-opacity=22%"
        },
        "docEdge": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-doc-edge=1px"
        },
        "docEdgeColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-ls-doc-edge-color=#ffffff"
        },
        "docEdgeOpacity": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ls-doc-edge-opacity=16%"
        },
        "stepWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-width=238px"
        },
        "stepPadY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-pad-y=22px"
        },
        "stepPadX": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-pad-x=20px"
        },
        "stepRadius": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-radius=20px"
        },
        "numberPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-number-px=30px"
        },
        "numberColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-mwv-number-color=#ffffff"
        },
        "numberSelected": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-mwv-number-selected-color=#0b1f33"
        },
        "kickerPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-kicker-px=12px"
        },
        "kickerWeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-kicker-wght=600"
        },
        "kickerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-kicker-tracking=0.12em"
        },
        "kickerGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-kicker-gap=6px"
        },
        "kickerColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-mwv-kicker-color=#e2e2e2"
        },
        "kickerSelected": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-mwv-kicker-selected-color=#5f6b7a"
        },
        "titlePx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-title-px=25px"
        },
        "titleLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-title-leading=1.05"
        },
        "titleTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-title-tracking=-0.015em"
        },
        "titleGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-title-gap=8px"
        },
        "titleColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-mwv-title-color=#ffffff"
        },
        "titleSelected": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-mwv-title-selected-color=#0b1f33"
        },
        "descPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-desc-px=15px"
        },
        "descWeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-desc-wght=400"
        },
        "descLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-desc-leading=1.45"
        },
        "descGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-desc-gap=10px"
        },
        "descColor": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-mwv-desc-color=#e6edf3"
        },
        "descSelected": {
          "type": "string",
          "required": true,
          "resolver": "gl-color",
          "example": "--gl-mwv-desc-selected-color=#5f6b7a"
        }
      }
    },
    "stage": {
      "selector": "[data-slot='stage']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "trajectory": {
      "selector": "[data-slot='trajectory']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 44,
          "example": "¿Cómo se suma un agente?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 9,
          "resolver": "gl-answer",
          "example": "olas"
        },
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 51,
          "example": "Agentforce · equipos híbridos"
        },
        "answerLead": {
          "type": "string",
          "required": true,
          "maxCharacters": 7,
          "example": "Por"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 179,
        "maxLines": 6,
        "overflow": "reject"
      },
      "example": "Primero el trabajo, después la tecnología: cada ola se <strong>prueba</strong> antes de pasar a la siguiente."
    },
    "steps": {
      "selector": "[data-slot='steps']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 4,
        "maxItems": 4,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "role": {
            "type": "string",
            "required": true,
            "resolver": "gl-item-role",
            "example": "lead"
          },
          "left": {
            "type": "string",
            "required": true,
            "resolver": "gl-css",
            "example": "--gl-mwv-left=760px"
          },
          "top": {
            "type": "string",
            "required": true,
            "resolver": "gl-css",
            "example": "--gl-mwv-top=600px"
          },
          "height": {
            "type": "string",
            "required": true,
            "resolver": "gl-css",
            "example": "--gl-mwv-height=250px"
          },
          "number": {
            "type": "string",
            "required": true,
            "maxCharacters": 2,
            "example": "01"
          },
          "kicker": {
            "type": "string",
            "required": true,
            "maxCharacters": 22,
            "example": "Empieza aquí"
          },
          "title": {
            "type": "string",
            "required": true,
            "maxCharacters": 31,
            "example": "Blueprint"
          },
          "description": {
            "type": "string",
            "required": true,
            "maxCharacters": 97,
            "example": "Proceso actual y futuro, fichas de rol de cada agente y matriz de autonomía."
          }
        }
      },
      "example": [
        {
          "role": "lead",
          "left": "--gl-mwv-left=760px",
          "top": "--gl-mwv-top=600px",
          "height": "--gl-mwv-height=250px",
          "number": "01",
          "kicker": "Empieza aquí",
          "title": "Blueprint",
          "description": "Proceso actual y futuro, fichas de rol de cada agente y matriz de autonomía."
        },
        {
          "role": "rest",
          "left": "--gl-mwv-left=1020px",
          "top": "--gl-mwv-top=495px",
          "height": "--gl-mwv-height=355px",
          "number": "02",
          "kicker": "Primer valor",
          "title": "Primer equipo híbrido",
          "description": "Un workflow real con supervisora nombrada, pruebas y producción acotada."
        },
        {
          "role": "rest",
          "left": "--gl-mwv-left=1280px",
          "top": "--gl-mwv-top=390px",
          "height": "--gl-mwv-height=460px",
          "number": "03",
          "kicker": "Escala",
          "title": "Entre equipos",
          "description": "Se extiende a otros equipos con la misma ficha, rituales y evaluación."
        },
        {
          "role": "rest",
          "left": "--gl-mwv-left=1540px",
          "top": "--gl-mwv-top=285px",
          "height": "--gl-mwv-height=565px",
          "number": "04",
          "kicker": "On-Going",
          "title": "Operación híbrida",
          "description": "Catálogo de workflows, revisión humana y costo por resultado válido."
        }
      ]
    },
    "selection": {
      "selector": "[data-slot='selection']",
      "type": "object",
      "required": false,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "consumer": "validation-only",
          "example": "Cliente"
        },
        "anchor": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "top-start"
        },
        "participantKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "department"
        },
        "scale": {
          "type": "number",
          "required": false,
          "consumer": "validation-only",
          "example": 1.15
        },
        "targetKind": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "object"
        },
        "variant": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "eight-handles"
        },
        "padding": {
          "type": "string",
          "required": false,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "standard"
        },
        "overlay": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "none"
        },
        "item": {
          "type": "number",
          "required": true,
          "consumer": "validation-only",
          "example": 1
        }
      }
    },
    "topMark": {
      "selector": "[data-slot='topMark']",
      "type": "object",
      "required": false,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-file-ref",
          "example": "asset-ref:file:probe"
        },
        "left": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-mark-left=1629px"
        },
        "top": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-mark-top=163px"
        },
        "size": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-mwv-mark=60px"
        }
      }
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-source.svg"
    }
  }
}
