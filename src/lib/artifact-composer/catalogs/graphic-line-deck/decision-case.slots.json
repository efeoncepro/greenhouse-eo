{
  "template": "DecisionCase",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 104
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 210
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 280
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 124
        },
        "panelWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-panel-width=1000px"
        },
        "panelRadius": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-panel-radius=300px"
        },
        "photoLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-photo-left=660px"
        },
        "logoGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-logo-gap=22px"
        },
        "logoMaxWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-logo-max-width=200px"
        },
        "logoMaxHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-logo-max-height=70px"
        },
        "figuresTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-figures-top=470px"
        },
        "figuresWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-figures-width=760px"
        },
        "figuresRowGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-figures-row-gap=34px"
        },
        "figuresColumnGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-figures-column-gap=50px"
        },
        "figureRule": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-figure-rule=2px"
        },
        "figurePadTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-figure-pad-top=16px"
        },
        "figurePx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-figure-px=104px"
        },
        "figureWght": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-figure-wght=300"
        },
        "figureLeading": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-figure-leading=0.95"
        },
        "figureTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-figure-tracking=-0.04em"
        },
        "labelPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-label-px=22px"
        },
        "labelGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-label-gap=8px"
        },
        "sourceTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-source-top=938px"
        },
        "sourcePx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-source-px=16px"
        },
        "sourceWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dc-source-width=760px"
        }
      }
    },
    "photo": {
      "selector": "[data-slot='photo']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt",
          "example": "Descripción de la imagen"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "example": "¿Qué cambió con Sky?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 22,
          "resolver": "gl-answer",
          "example": "Más rápido"
        },
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 28,
          "example": "Caso · 12 meses"
        }
      }
    },
    "clientLogo": {
      "selector": "[data-slot='clientLogo']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-file-ref",
          "example": "asset-ref:file:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt",
          "example": "Descripción de la imagen"
        }
      }
    },
    "figures": {
      "selector": "[data-slot='figures']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 4,
        "maxItems": 4,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "value": {
            "type": "string",
            "required": true,
            "maxCharacters": 7
          },
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 24
          }
        }
      },
      "example": [
        {
          "value": "+2.000",
          "label": "piezas aprobadas"
        },
        {
          "value": "39",
          "label": "campañas"
        },
        {
          "value": "88 %",
          "label": "entregas a tiempo"
        },
        {
          "value": "−25 %",
          "label": "tiempo de producción"
        }
      ]
    },
    "source": {
      "selector": "[data-slot='source']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 150,
        "maxLines": 2,
        "overflow": "reject"
      },
      "example": "Fuente: caso publicado de Sky Airlines, métricas de entrega de 12 meses"
    },
    "selection": {
      "selector": "[data-slot='selection']",
      "type": "object",
      "required": false,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "consumer": "validation-only",
          "example": "Performance"
        },
        "anchor": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "bottom-end"
        },
        "participantKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "department"
        },
        "scale": {
          "type": "number",
          "required": false,
          "consumer": "validation-only",
          "example": 1.15
        },
        "targetKind": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "object"
        },
        "variant": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "eight-handles"
        },
        "padding": {
          "type": "string",
          "required": false,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "standard"
        },
        "overlay": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "none"
        },
        "item": {
          "type": "number",
          "required": true,
          "consumer": "validation-only",
          "example": 4
        }
      }
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-baked-light.svg"
    }
  }
}
