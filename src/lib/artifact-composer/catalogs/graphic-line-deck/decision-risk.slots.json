{
  "template": "DecisionRisk",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "margin": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-margin",
          "example": 140
        },
        "eyebrowTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-eyebrowTop",
          "example": 110
        },
        "questionTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-questionTop",
          "example": 200
        },
        "answerTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerTop",
          "example": 270
        },
        "answerPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-answerPx",
          "example": 132
        },
        "bodyTop": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyTop",
          "example": 560
        },
        "bodyPx": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyPx",
          "example": 26
        },
        "bodyWidth": {
          "type": "number",
          "required": true,
          "resolver": "gl-px-bodyWidth",
          "example": 520
        },
        "headersTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dr-headers-top=200px"
        },
        "headerPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dr-header-px=16px"
        },
        "secondColumn": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dr-second-column=1140px"
        },
        "tableLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dr-table-left=800px"
        },
        "tableTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dr-table-top=250px"
        },
        "tableWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dr-table-width=980px"
        },
        "rowHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dr-row-height=150px"
        },
        "rowGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dr-row-gap=20px"
        },
        "riskWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dr-risk-width=300px"
        },
        "columnGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dr-column-gap=40px"
        },
        "ruleStroke": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dr-rule=2px"
        },
        "rowPadTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dr-row-pad-top=22px"
        },
        "riskPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dr-risk-px=26px"
        },
        "namePx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dr-name-px=44px"
        },
        "nameTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dr-name-tracking=-0.02em"
        },
        "howPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dr-how-px=22px"
        },
        "howGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-dr-how-gap=10px"
        }
      }
    },
    "indicator": {
      "selector": "[data-slot='indicator']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 22,
          "example": "¿Y si no funciona?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 18,
          "resolver": "gl-answer",
          "example": "chico"
        },
        "eyebrow": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "example": "Riesgo controlado"
        },
        "answerLead": {
          "type": "string",
          "required": false,
          "maxCharacters": 18,
          "example": "Empiezas"
        }
      }
    },
    "body": {
      "selector": "[data-slot='body']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 100,
        "maxLines": 4,
        "overflow": "reject"
      },
      "example": "Cada riesgo tiene su cobertura escrita. Y el primer paso es un piloto, no un contrato largo."
    },
    "headers": {
      "selector": "[data-slot='headers']",
      "type": "object",
      "required": true,
      "shape": {
        "risk": {
          "type": "string",
          "required": true,
          "maxCharacters": 20,
          "example": "El riesgo"
        },
        "how": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "example": "Cómo lo cubrimos"
        }
      }
    },
    "risks": {
      "selector": "[data-slot='risks']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 4,
        "maxItems": 4,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "risk": {
            "type": "string",
            "required": true,
            "maxCharacters": 24
          },
          "name": {
            "type": "string",
            "required": true,
            "maxCharacters": 24
          },
          "how": {
            "type": "string",
            "required": true,
            "maxCharacters": 100
          }
        }
      },
      "example": [
        {
          "risk": "Que no encajemos",
          "name": "Sample Sprint",
          "how": "Un piloto pagado, acotado y gobernado, con informe de cierre y una decisión clara."
        },
        {
          "risk": "Que se atrase",
          "name": "Métricas con umbral",
          "how": "OTD ≥ 90 % y FTR ≥ 80 %, medidos cada semana y visibles en tu portal."
        },
        {
          "risk": "Depender de una persona",
          "name": "Traspaso documentado",
          "how": "Reemplazo formal del equipo, con el contexto escrito y sin perder memoria."
        },
        {
          "risk": "No ver qué pasa",
          "name": "Transparencia radical",
          "how": "La operación en vivo en Greenhouse: lo que pedimos, lo que entregamos y cuánto demora."
        }
      ]
    },
    "selection": {
      "selector": "[data-slot='selection']",
      "type": "object",
      "required": false,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "consumer": "validation-only",
          "example": "Cliente"
        },
        "anchor": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "top-start"
        },
        "participantKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "department"
        },
        "scale": {
          "type": "number",
          "required": false,
          "consumer": "validation-only",
          "example": 1.15
        },
        "targetKind": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "object"
        },
        "variant": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "eight-handles"
        },
        "padding": {
          "type": "string",
          "required": false,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "standard"
        },
        "overlay": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "none"
        },
        "item": {
          "type": "number",
          "required": true,
          "consumer": "validation-only",
          "example": 1
        }
      }
    },
    "urlBubble": {
      "selector": "[data-slot='urlBubble']",
      "type": "fixed-asset",
      "required": true,
      "defaultAsset": "assets/url-bubble-baked-light.svg"
    }
  }
}
