{
  "template": "YoutubeClose",
  "version": "0.1",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "slots": {
    "theme": {
      "selector": "[data-slot='theme']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "mcm-line",
          "consumer": "resolver-only",
          "example": "engine"
        },
        "tone": {
          "type": "string",
          "required": true,
          "resolver": "mcm-tone",
          "consumer": "resolver-only",
          "example": "navy"
        },
        "signature": {
          "type": "string",
          "required": true,
          "resolver": "mcm-signature",
          "consumer": "resolver-only",
          "example": "efeonce-logo-negative"
        }
      }
    },
    "slogan": {
      "selector": "[data-slot='slogan']",
      "type": "object",
      "required": true,
      "shape": {
        "word": {
          "type": "string",
          "required": true,
          "maxCharacters": 10,
          "example": "Engine"
        }
      }
    }
  }
}
