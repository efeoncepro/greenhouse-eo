{
  "template": "DenseComparison",
  "version": "0.1",
  "viewport": {
    "width": 1080,
    "height": 1350
  },
  "slots": {
    "theme": {
      "selector": "[data-slot='theme']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "mcm-line",
          "consumer": "resolver-only",
          "example": "engine"
        },
        "tone": {
          "type": "string",
          "required": true,
          "resolver": "mcm-tone",
          "consumer": "resolver-only",
          "example": "navy"
        },
        "masthead": {
          "type": "string",
          "required": true,
          "resolver": "mcm-masthead",
          "consumer": "resolver-only",
          "example": "manzanitas-logo-negative-engine"
        },
        "signature": {
          "type": "string",
          "required": true,
          "resolver": "mcm-signature",
          "consumer": "resolver-only",
          "example": "efeonce-logo-negative"
        },
        "swipe": {
          "type": "string",
          "required": true,
          "resolver": "mcm-swipe",
          "consumer": "resolver-only",
          "example": "swipe-rest-navy-engine"
        },
        "sphereGap": {
          "type": "string",
          "required": true,
          "resolver": "mcm-sphere-gap",
          "consumer": "resolver-only",
          "example": "0.03"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "example": "¿SEO o AEO?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "example": "Los dos"
        }
      }
    },
    "columns": {
      "selector": "[data-slot='columns']",
      "type": "object",
      "required": true,
      "shape": {
        "a": {
          "type": "string",
          "required": true,
          "maxCharacters": 10,
          "example": "SEO"
        },
        "b": {
          "type": "string",
          "required": true,
          "maxCharacters": 10,
          "example": "AEO"
        }
      }
    },
    "rows": {
      "selector": "[data-slot='rows']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 4,
        "maxItems": 4
      },
      "item": {
        "type": "object",
        "shape": {
          "label": {
            "type": "string",
            "required": true,
            "maxCharacters": 22
          },
          "a": {
            "type": "string",
            "required": true,
            "maxCharacters": 30
          },
          "b": {
            "type": "string",
            "required": true,
            "maxCharacters": 30
          }
        }
      },
      "example": [
        {
          "label": "Buscas",
          "a": "Aparecer en los resultados",
          "b": "Ser la respuesta citada"
        },
        {
          "label": "Se mide en",
          "a": "Posiciones y clics",
          "b": "Menciones y citas"
        },
        {
          "label": "Gana quien",
          "a": "Mejor posiciona",
          "b": "Mejor explica"
        },
        {
          "label": "Publicas",
          "a": "Páginas por palabra clave",
          "b": "Respuestas con datos"
        }
      ]
    },
    "closer": {
      "selector": "[data-slot='closer']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 80,
        "overflow": "reject",
        "maxLines": 2
      },
      "example": "Sin SEO, la IA no te encuentra. Sin AEO, no te cita."
    }
  }
}
