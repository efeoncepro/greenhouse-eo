{
  "template": "DenseSteps",
  "version": "0.1",
  "viewport": {
    "width": 1080,
    "height": 1350
  },
  "slots": {
    "theme": {
      "selector": "[data-slot='theme']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "mcm-line",
          "consumer": "resolver-only",
          "example": "engine"
        },
        "tone": {
          "type": "string",
          "required": true,
          "resolver": "mcm-tone",
          "consumer": "resolver-only",
          "example": "navy"
        },
        "masthead": {
          "type": "string",
          "required": true,
          "resolver": "mcm-masthead",
          "consumer": "resolver-only",
          "example": "manzanitas-logo-negative-engine"
        },
        "signature": {
          "type": "string",
          "required": true,
          "resolver": "mcm-signature",
          "consumer": "resolver-only",
          "example": "efeonce-logo-negative"
        },
        "swipe": {
          "type": "string",
          "required": true,
          "resolver": "mcm-swipe",
          "consumer": "resolver-only",
          "example": "swipe-rest-navy-engine"
        },
        "sphereGap": {
          "type": "string",
          "required": true,
          "resolver": "mcm-sphere-gap",
          "consumer": "resolver-only",
          "example": "0.03"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "example": "¿Por dónde empiezo?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "example": "4 pasos"
        }
      }
    },
    "steps": {
      "selector": "[data-slot='steps']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 4,
        "maxItems": 4
      },
      "item": {
        "type": "object",
        "shape": {
          "n": {
            "type": "string",
            "required": false,
            "resolver": "mcm-ordinal",
            "consumer": "resolver-only"
          },
          "title": {
            "type": "string",
            "required": true,
            "maxCharacters": 32
          },
          "body": {
            "type": "string",
            "required": true,
            "maxCharacters": 90
          }
        }
      },
      "example": [
        {
          "title": "Pregunta como tu cliente",
          "body": "Anota las 20 preguntas que te hacen."
        },
        {
          "title": "Revisa qué responde la IA",
          "body": "Pregúntale a ChatGPT y a Gemini."
        },
        {
          "title": "Responde mejor que nadie",
          "body": "Publica respuestas con datos y fuentes."
        },
        {
          "title": "Mide y repite",
          "body": "Vuelve a preguntar cada mes."
        }
      ]
    }
  }
}
