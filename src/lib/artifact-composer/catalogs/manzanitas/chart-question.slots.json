{
  "template": "ChartQuestion",
  "version": "0.1",
  "viewport": {
    "width": 1080,
    "height": 1350
  },
  "slots": {
    "theme": {
      "selector": "[data-slot='theme']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "mcm-line",
          "consumer": "resolver-only",
          "example": "engine"
        },
        "tone": {
          "type": "string",
          "required": true,
          "resolver": "mcm-tone",
          "consumer": "resolver-only",
          "example": "navy"
        },
        "masthead": {
          "type": "string",
          "required": true,
          "resolver": "mcm-masthead",
          "consumer": "resolver-only",
          "example": "manzanitas-logo-negative-engine"
        },
        "signature": {
          "type": "string",
          "required": true,
          "resolver": "mcm-signature",
          "consumer": "resolver-only",
          "example": "efeonce-logo-negative"
        },
        "swipe": {
          "type": "string",
          "required": true,
          "resolver": "mcm-swipe",
          "consumer": "resolver-only",
          "example": "swipe-rest-navy-engine"
        }
      }
    },
    "chart": {
      "selector": "[data-slot='chart']",
      "type": "string",
      "required": true,
      "consumer": "validation-only",
      "example": "{\"recipe\": \"measure\", \"line\": \"engine\", \"surface\": \"navy\", \"data\": {\"value\": 38, \"source\": \"[FUENTE, AÑO]\", \"illustrative\": true}, \"options\": {\"figureLabel\": \"te nombran\"}}"
    },
    "question": {
      "selector": "[data-slot='question']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 80,
        "overflow": "reject",
        "maxLines": 2
      },
      "example": "¿En cuántas respuestas de IA sobre tu categoría aparece tu marca?"
    }
  }
}
