{
  "template": "DenseConcept",
  "version": "0.1",
  "viewport": {
    "width": 1080,
    "height": 1350
  },
  "slots": {
    "theme": {
      "selector": "[data-slot='theme']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "mcm-line",
          "consumer": "resolver-only",
          "example": "engine"
        },
        "tone": {
          "type": "string",
          "required": true,
          "resolver": "mcm-tone",
          "consumer": "resolver-only",
          "example": "navy"
        },
        "masthead": {
          "type": "string",
          "required": true,
          "resolver": "mcm-masthead",
          "consumer": "resolver-only",
          "example": "manzanitas-logo-negative-engine"
        },
        "signature": {
          "type": "string",
          "required": true,
          "resolver": "mcm-signature",
          "consumer": "resolver-only",
          "example": "efeonce-logo-negative"
        },
        "swipe": {
          "type": "string",
          "required": true,
          "resolver": "mcm-swipe",
          "consumer": "resolver-only",
          "example": "swipe-rest-navy-engine"
        },
        "sphereGap": {
          "type": "string",
          "required": true,
          "resolver": "mcm-sphere-gap",
          "consumer": "resolver-only",
          "example": "0.03"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "example": "¿Qué es el AEO?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "example": "Que te citen"
        }
      }
    },
    "paragraph": {
      "selector": "[data-slot='paragraph']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 220,
        "overflow": "reject",
        "maxLines": 5
      },
      "example": "Es preparar tu marca para que los motores de respuesta <strong>la entiendan, confíen en ella y la nombren</strong>."
    },
    "points": {
      "selector": "[data-slot='points']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 3,
        "maxItems": 3
      },
      "item": {
        "type": "object",
        "shape": {
          "n": {
            "type": "string",
            "required": false,
            "resolver": "mcm-ordinal",
            "consumer": "resolver-only"
          },
          "title": {
            "type": "string",
            "required": true,
            "maxCharacters": 32
          },
          "body": {
            "type": "string",
            "required": true,
            "maxCharacters": 90
          }
        }
      },
      "example": [
        {
          "title": "Te entiende",
          "body": "Tu sitio dice qué haces, con claridad."
        },
        {
          "title": "Te cree",
          "body": "Otras fuentes confiables te respaldan."
        },
        {
          "title": "Te nombra",
          "body": "Respondes mejor que nadie la pregunta."
        }
      ]
    }
  }
}
