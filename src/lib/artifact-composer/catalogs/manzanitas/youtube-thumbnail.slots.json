{
  "template": "YoutubeThumbnail",
  "version": "0.1",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "slots": {
    "theme": {
      "selector": "[data-slot='theme']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "mcm-line",
          "consumer": "resolver-only",
          "example": "engine"
        },
        "tone": {
          "type": "string",
          "required": true,
          "resolver": "mcm-tone",
          "consumer": "resolver-only",
          "example": "navy"
        },
        "masthead": {
          "type": "string",
          "required": true,
          "resolver": "mcm-masthead",
          "consumer": "resolver-only",
          "example": "manzanitas-logo-negative-engine"
        },
        "signature": {
          "type": "string",
          "required": true,
          "resolver": "mcm-signature",
          "consumer": "resolver-only",
          "example": "efeonce-logo-negative"
        },
        "sphereGap": {
          "type": "string",
          "required": true,
          "resolver": "mcm-sphere-gap",
          "consumer": "resolver-only",
          "example": "0.03"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 36,
          "example": "¿Qué revisa una IA antes de recomendarte?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "example": "5 cosas"
        }
      }
    },
    "photo": {
      "selector": "[data-slot='photo']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "mcm-photo-ref",
          "example": "asset-ref:photo:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 240,
          "resolver": "mcm-alt",
          "example": "Foto en registro cine de la escena."
        }
      }
    }
  }
}
