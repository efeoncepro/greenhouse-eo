{
  "template": "StoryClose",
  "version": "0.1",
  "viewport": {
    "width": 1080,
    "height": 1920
  },
  "slots": {
    "theme": {
      "selector": "[data-slot='theme']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "mcm-line",
          "consumer": "resolver-only",
          "example": "engine"
        },
        "tone": {
          "type": "string",
          "required": true,
          "resolver": "mcm-tone",
          "consumer": "resolver-only",
          "example": "navy"
        },
        "masthead": {
          "type": "string",
          "required": true,
          "resolver": "mcm-masthead",
          "consumer": "resolver-only",
          "example": "manzanitas-logo-negative-engine"
        },
        "signature": {
          "type": "string",
          "required": true,
          "resolver": "mcm-signature",
          "consumer": "resolver-only",
          "example": "efeonce-logo-negative"
        },
        "sphereGap": {
          "type": "string",
          "required": true,
          "resolver": "mcm-sphere-gap",
          "consumer": "resolver-only",
          "example": "0.03"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "example": "¿Qué revisa una IA antes de recomendarte?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 14,
          "example": "5 cosas"
        }
      }
    },
    "sub": {
      "selector": "[data-slot='sub']",
      "type": "rich-string",
      "required": false,
      "constraints": {
        "maxCharacters": 70,
        "overflow": "reject",
        "maxLines": 2
      },
      "example": "En los comentarios: <strong>cuéntanos si te nombró</strong>."
    },
    "slogan": {
      "selector": "[data-slot='slogan']",
      "type": "object",
      "required": true,
      "shape": {
        "word": {
          "type": "string",
          "required": true,
          "maxCharacters": 10,
          "example": "Engine"
        }
      }
    }
  }
}
