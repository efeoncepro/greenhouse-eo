{
  "template": "DataApples",
  "version": "0.1",
  "viewport": {
    "width": 1080,
    "height": 1350
  },
  "slots": {
    "theme": {
      "selector": "[data-slot='theme']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "mcm-line",
          "consumer": "resolver-only",
          "example": "engine"
        },
        "tone": {
          "type": "string",
          "required": true,
          "resolver": "mcm-tone",
          "consumer": "resolver-only",
          "example": "navy"
        },
        "masthead": {
          "type": "string",
          "required": true,
          "resolver": "mcm-masthead",
          "consumer": "resolver-only",
          "example": "manzanitas-logo-negative-engine"
        },
        "signature": {
          "type": "string",
          "required": true,
          "resolver": "mcm-signature",
          "consumer": "resolver-only",
          "example": "efeonce-logo-negative"
        },
        "swipe": {
          "type": "string",
          "required": true,
          "resolver": "mcm-swipe",
          "consumer": "resolver-only",
          "example": "swipe-rest-navy-engine"
        },
        "sphereGap": {
          "type": "string",
          "required": true,
          "resolver": "mcm-sphere-gap",
          "consumer": "resolver-only",
          "example": "0.03"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 56,
          "example": "¿Qué revisa una IA antes de recomendarte?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 14,
          "example": "5 cosas"
        }
      }
    },
    "apples": {
      "selector": "[data-slot='apples']",
      "type": "object",
      "required": true,
      "shape": {
        "count": {
          "type": "string",
          "required": true,
          "resolver": "mcm-apples-count",
          "consumer": "resolver-only",
          "example": "3"
        },
        "label": {
          "type": "string",
          "required": true,
          "resolver": "mcm-aria-label",
          "consumer": "resolver-only",
          "example": "3 de 10 manzanas destacadas"
        }
      }
    },
    "sub": {
      "selector": "[data-slot='sub']",
      "type": "rich-string",
      "required": true,
      "constraints": {
        "maxCharacters": 90,
        "overflow": "reject",
        "maxLines": 2
      },
      "example": "En los comentarios: <strong>cuéntanos si te nombró</strong>."
    }
  }
}
