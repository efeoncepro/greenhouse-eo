{
  "template": "PodcastCover",
  "version": "0.1",
  "viewport": {
    "width": 1080,
    "height": 1080
  },
  "slots": {
    "theme": {
      "selector": "[data-slot='theme']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "mcm-line",
          "consumer": "resolver-only",
          "example": "engine"
        },
        "tone": {
          "type": "string",
          "required": true,
          "resolver": "mcm-tone",
          "consumer": "resolver-only",
          "example": "navy"
        },
        "masthead": {
          "type": "string",
          "required": true,
          "resolver": "mcm-masthead",
          "consumer": "resolver-only",
          "example": "manzanitas-logo-negative-engine"
        },
        "signature": {
          "type": "string",
          "required": true,
          "resolver": "mcm-signature",
          "consumer": "resolver-only",
          "example": "efeonce-logo-negative"
        },
        "apple": {
          "type": "string",
          "required": true,
          "resolver": "mcm-apple",
          "consumer": "resolver-only",
          "example": "manzanitas-apple-navy-engine"
        },
        "sphereGap": {
          "type": "string",
          "required": true,
          "resolver": "mcm-sphere-gap",
          "consumer": "resolver-only",
          "example": "0.03"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": false,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "example": "¿Cómo suena tu marca?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 14,
          "example": "Así"
        }
      }
    },
    "episode": {
      "selector": "[data-slot='episode']",
      "type": "rich-string",
      "required": false,
      "constraints": {
        "maxCharacters": 90,
        "overflow": "reject",
        "maxLines": 2
      },
      "example": "Pódcast · Ep. 12<br>Con <strong>Nombre del invitado</strong>"
    }
  }
}
