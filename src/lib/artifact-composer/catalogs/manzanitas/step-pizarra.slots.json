{
  "template": "StepPizarra",
  "version": "0.1",
  "viewport": {
    "width": 1080,
    "height": 1350
  },
  "slots": {
    "theme": {
      "selector": "[data-slot='theme']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "mcm-line",
          "consumer": "resolver-only",
          "example": "engine"
        },
        "tone": {
          "type": "string",
          "required": true,
          "resolver": "mcm-tone",
          "consumer": "resolver-only",
          "example": "navy"
        },
        "masthead": {
          "type": "string",
          "required": true,
          "resolver": "mcm-masthead",
          "consumer": "resolver-only",
          "example": "manzanitas-logo-negative-engine"
        },
        "signature": {
          "type": "string",
          "required": true,
          "resolver": "mcm-signature",
          "consumer": "resolver-only",
          "example": "efeonce-logo-negative"
        },
        "swipe": {
          "type": "string",
          "required": true,
          "resolver": "mcm-swipe",
          "consumer": "resolver-only",
          "example": "swipe-rest-navy-engine"
        },
        "sphereGap": {
          "type": "string",
          "required": true,
          "resolver": "mcm-sphere-gap",
          "consumer": "resolver-only",
          "example": "0.03"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "example": "¿Qué no puede cambiar?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 14,
          "example": "Preservar"
        }
      }
    },
    "orbit": {
      "selector": "[data-slot='orbit']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "mcm-orbit-ref",
          "example": "asset-ref:orbit:probe"
        }
      }
    },
    "step": {
      "selector": "[data-slot='step']",
      "type": "object",
      "required": true,
      "shape": {
        "numeral": {
          "type": "string",
          "required": true,
          "maxCharacters": 2,
          "example": "01"
        },
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 14,
          "example": "Paso 1 de 3"
        }
      }
    },
    "sub": {
      "selector": "[data-slot='sub']",
      "type": "rich-string",
      "required": false,
      "constraints": {
        "maxCharacters": 90,
        "overflow": "reject",
        "maxLines": 2
      },
      "example": "En los comentarios: <strong>cuéntanos si te nombró</strong>."
    }
  }
}
