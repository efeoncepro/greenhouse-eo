{
  "template": "ChartVoice",
  "version": "0.1",
  "viewport": {
    "width": 1080,
    "height": 1350
  },
  "slots": {
    "theme": {
      "selector": "[data-slot='theme']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "mcm-line",
          "consumer": "resolver-only",
          "example": "engine"
        },
        "tone": {
          "type": "string",
          "required": true,
          "resolver": "mcm-tone",
          "consumer": "resolver-only",
          "example": "navy"
        },
        "masthead": {
          "type": "string",
          "required": true,
          "resolver": "mcm-masthead",
          "consumer": "resolver-only",
          "example": "manzanitas-logo-negative-engine"
        },
        "signature": {
          "type": "string",
          "required": true,
          "resolver": "mcm-signature",
          "consumer": "resolver-only",
          "example": "efeonce-logo-negative"
        },
        "swipe": {
          "type": "string",
          "required": true,
          "resolver": "mcm-swipe",
          "consumer": "resolver-only",
          "example": "swipe-rest-navy-engine"
        },
        "sphereGap": {
          "type": "string",
          "required": true,
          "resolver": "mcm-sphere-gap",
          "consumer": "resolver-only",
          "example": "0.03"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 40,
          "example": "¿Cuántas búsquedas no dan clic?"
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 14,
          "example": "58 de 100"
        }
      }
    },
    "chart": {
      "selector": "[data-slot='chart']",
      "type": "string",
      "required": true,
      "consumer": "validation-only",
      "example": "{\"recipe\": \"per-hundred\", \"line\": \"engine\", \"surface\": \"navy\", \"data\": {\"value\": 58, \"source\": \"[FUENTE, AÑO]\", \"illustrative\": true}, \"options\": {\"keyLabels\": [\"sin clic\", \"con clic\"]}}"
    }
  }
}
