{
  "template": "ShotPlan",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "sheetMargin": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sheet-margin=80px"
        },
        "shotGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-shot-gap=40px"
        },
        "thumbWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-thumb-width=410px"
        },
        "thumbHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-thumb-height=231px"
        }
      }
    },
    "title": {
      "selector": "[data-slot='title']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 110,
        "maxLines": 2,
        "overflow": "reject"
      }
    },
    "shots": {
      "selector": "[data-slot='shots']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 4,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "src": {
            "type": "string",
            "required": true,
            "resolver": "gl-plate-ref",
            "example": "asset-ref:plate:probe"
          },
          "alt": {
            "type": "string",
            "required": true,
            "maxCharacters": 320,
            "resolver": "gl-alt"
          },
          "heading": {
            "type": "string",
            "required": true,
            "maxCharacters": 40
          },
          "spec": {
            "type": "string",
            "required": true,
            "maxCharacters": 120
          },
          "note": {
            "type": "string",
            "required": true,
            "maxCharacters": 80
          }
        }
      }
    },
    "rules": {
      "selector": "[data-slot='rules']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 8,
        "maxCharactersPerItem": 140,
        "overflow": "reject"
      },
      "item": {
        "type": "string"
      }
    }
  }
}
