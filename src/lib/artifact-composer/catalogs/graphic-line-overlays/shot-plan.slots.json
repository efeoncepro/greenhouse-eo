{
  "template": "ShotPlan",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "sheetMargin": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-sheet-margin=80px"
        },
        "shotGap": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-shot-gap=40px"
        },
        "thumbWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-thumb-width=410px"
        },
        "thumbHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-thumb-height=231px"
        }
      }
    },
    "title": {
      "selector": "[data-slot='title']",
      "type": "string",
      "required": true,
      "constraints": {
        "maxCharacters": 110,
        "maxLines": 2,
        "overflow": "reject"
      },
      "example": "Producción audiovisual · un video de 12,6 s «Cómo trabajamos», cuadros clave generados"
    },
    "shots": {
      "selector": "[data-slot='shots']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 4,
        "overflow": "reject"
      },
      "item": {
        "type": "object",
        "shape": {
          "src": {
            "type": "string",
            "required": true,
            "resolver": "gl-plate-ref",
            "example": "asset-ref:plate:probe"
          },
          "alt": {
            "type": "string",
            "required": true,
            "maxCharacters": 320,
            "resolver": "gl-alt"
          },
          "heading": {
            "type": "string",
            "required": true,
            "maxCharacters": 40
          },
          "spec": {
            "type": "string",
            "required": true,
            "maxCharacters": 120
          },
          "note": {
            "type": "string",
            "required": true,
            "maxCharacters": 80
          }
        }
      },
      "example": [
        {
          "src": "asset-ref:plate:probe",
          "alt": "Una productora de Efeonce filma al panadero junto al horno",
          "heading": "01 · 0–3 s · Plano general",
          "spec": "Terreno, panadería del cliente · 35 mm · cámara en mano, avanza despacio · luz del horno + ventana",
          "note": "Documental: nadie mira a cámara · gorra + hoodie (terreno)"
        },
        {
          "src": "asset-ref:plate:probe",
          "alt": "Las manos de un director de arte marcan una prueba de impresión con lápiz rojo y una lupa",
          "heading": "02 · 3–5 s · Inserto",
          "spec": "Detalle de manos · macro 100 mm · fijo, foco en la punta del lápiz · una lámpara rasante",
          "note": "El oficio en primer plano · manga del polo (oficina)"
        },
        {
          "src": "asset-ref:plate:probe",
          "alt": "Una estratega de Efeonce presenta la curva de resultados al equipo del cliente",
          "heading": "03 · 5–9 s · Plano medio",
          "spec": "Sala del cliente · 50 mm · sobre el hombro del cliente, empuje lento · la pantalla es la luz",
          "note": "Documental · chaqueta sobre polo (reunión importante)"
        },
        {
          "src": "asset-ref:plate:probe",
          "alt": "El último cuadro del reveal: el logo de Efeonce con su eslogan sobre el navy de la marca",
          "heading": "04 · 9–12,6 s · Cierre",
          "spec": "Reveal aprobado (3,6 s, con sonido) · masters de AXIS v1.1",
          "note": "La toma nunca lleva logo: firma el cierre"
        }
      ]
    },
    "rules": {
      "selector": "[data-slot='rules']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 8,
        "maxCharactersPerItem": 140,
        "overflow": "reject"
      },
      "item": {
        "type": "string"
      }
    }
  }
}
