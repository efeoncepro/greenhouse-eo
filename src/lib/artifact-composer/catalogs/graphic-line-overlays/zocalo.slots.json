{
  "template": "Zocalo",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "render": {
    "background": "transparent"
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "voiceLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-voice-left=120px"
        },
        "voiceTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-voice-top=800px"
        },
        "questionPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-question-px=38px"
        },
        "answerPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-px=128px"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-tracking=-0.035em"
        }
      }
    },
    "voice": {
      "selector": "[data-slot='voice']",
      "type": "object",
      "required": true,
      "shape": {
        "question": {
          "type": "string",
          "required": true,
          "maxCharacters": 48
        },
        "answer": {
          "type": "string",
          "required": true,
          "maxCharacters": 14,
          "resolver": "gl-answer",
          "example": "Producción"
        }
      }
    },
    "selection": {
      "selector": "[data-slot='selection']",
      "type": "object",
      "required": true,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "consumer": "validation-only"
        },
        "anchor": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only"
        },
        "participantKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "consumer": "validation-only"
        },
        "scale": {
          "type": "number",
          "required": false,
          "consumer": "validation-only"
        },
        "targetKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 8,
          "consumer": "validation-only"
        },
        "variant": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only"
        },
        "padding": {
          "type": "string",
          "required": false,
          "maxCharacters": 12,
          "consumer": "validation-only"
        },
        "overlay": {
          "type": "string",
          "required": false,
          "maxCharacters": 8,
          "consumer": "validation-only"
        }
      }
    }
  }
}
