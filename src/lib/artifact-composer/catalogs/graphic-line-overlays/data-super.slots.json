{
  "template": "DataSuper",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "render": {
    "background": "transparent"
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "ringCx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ring-cx=300px"
        },
        "ringCy": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ring-cy=760px"
        },
        "ringR": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-ring-r=150px"
        },
        "valuePx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-value-px=88px"
        },
        "captionPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-caption-px=34px"
        },
        "captionLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-caption-left=500px"
        },
        "captionWidth": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-caption-width=420px"
        }
      }
    },
    "orbit": {
      "selector": "[data-slot='orbit']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-layer-ref",
          "example": "asset-ref:layer:probe"
        }
      }
    },
    "datum": {
      "selector": "[data-slot='datum']",
      "type": "object",
      "required": true,
      "shape": {
        "value": {
          "type": "string",
          "required": true,
          "maxCharacters": 6,
          "example": "62%"
        },
        "caption": {
          "type": "string",
          "required": true,
          "maxCharacters": 64,
          "example": "de los cortes se aprueban a la primera"
        },
        "source": {
          "type": "string",
          "required": true,
          "maxCharacters": 160,
          "consumer": "validation-only",
          "example": "Maqueta de dirección «Cómo trabajamos» (2026-09-26): cifra ilustrativa, reemplazar por la medida real del cliente antes de publicar"
        }
      }
    }
  }
}
