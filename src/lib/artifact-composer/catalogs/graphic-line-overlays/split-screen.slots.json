{
  "template": "SplitScreen",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "dividerLeft": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-divider-left=957px"
        },
        "dividerPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-divider-px=6px"
        },
        "wordInset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-word-inset=110px"
        },
        "wordTop": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-word-top=860px"
        },
        "answerPx": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-px=90px"
        },
        "answerTracking": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-answer-tracking=-0.035em"
        }
      }
    },
    "start": {
      "selector": "[data-slot='start']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt"
        },
        "focus": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-focus-x=50%"
        },
        "word": {
          "type": "string",
          "required": true,
          "maxCharacters": 12
        }
      }
    },
    "end": {
      "selector": "[data-slot='end']",
      "type": "object",
      "required": true,
      "shape": {
        "src": {
          "type": "string",
          "required": true,
          "resolver": "gl-plate-ref",
          "example": "asset-ref:plate:probe"
        },
        "alt": {
          "type": "string",
          "required": true,
          "maxCharacters": 320,
          "resolver": "gl-alt"
        },
        "focus": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-focus-x=50%"
        },
        "word": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "resolver": "gl-answer",
          "example": "mide"
        }
      }
    }
  }
}
