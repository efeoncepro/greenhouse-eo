{
  "template": "CalloutSelection",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "render": {
    "background": "transparent"
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        }
      }
    },
    "target": {
      "selector": "[data-slot='target']",
      "type": "object",
      "required": true,
      "shape": {
        "left": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-target-left=720px"
        },
        "top": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-target-top=560px"
        },
        "width": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-target-width=340px"
        },
        "height": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-target-height=240px"
        }
      }
    },
    "selection": {
      "selector": "[data-slot='selection']",
      "type": "object",
      "required": true,
      "shape": {
        "label": {
          "type": "string",
          "required": true,
          "maxCharacters": 24,
          "consumer": "validation-only",
          "example": "Dirección de arte"
        },
        "anchor": {
          "type": "string",
          "required": true,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": "top-start"
        },
        "participantKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": "role"
        },
        "scale": {
          "type": "number",
          "required": false,
          "consumer": "validation-only",
          "example": 1.6
        },
        "targetKind": {
          "type": "string",
          "required": true,
          "maxCharacters": 8,
          "consumer": "validation-only",
          "example": "object"
        },
        "variant": {
          "type": "string",
          "required": false,
          "maxCharacters": 16,
          "consumer": "validation-only",
          "example": ""
        },
        "padding": {
          "type": "string",
          "required": false,
          "maxCharacters": 12,
          "consumer": "validation-only",
          "example": ""
        },
        "overlay": {
          "type": "string",
          "required": false,
          "maxCharacters": 8,
          "consumer": "validation-only",
          "example": ""
        }
      }
    }
  }
}
