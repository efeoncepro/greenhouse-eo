{
  "template": "Subtitles",
  "version": "0.1",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "render": {
    "background": "transparent"
  },
  "slots": {
    "frame": {
      "selector": "[data-slot='frame']",
      "type": "object",
      "required": true,
      "shape": {
        "line": {
          "type": "string",
          "required": true,
          "resolver": "gl-line",
          "example": "growth"
        },
        "inset": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-subtitle-inset=96px"
        },
        "top": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-subtitle-top=880px"
        },
        "px": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-subtitle-px=46px"
        },
        "weight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-subtitle-weight=600"
        },
        "lineHeight": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-subtitle-line-height=1.3"
        },
        "maxLines": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-subtitle-max-lines=2"
        },
        "shadowY": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-subtitle-shadow-y=2px"
        },
        "shadowBlur": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-subtitle-shadow-blur=6px"
        },
        "shadowAlpha": {
          "type": "string",
          "required": true,
          "resolver": "gl-css",
          "example": "--gl-subtitle-shadow-alpha=55%"
        }
      }
    },
    "lines": {
      "selector": "[data-slot='lines']",
      "type": "array",
      "required": true,
      "constraints": {
        "minItems": 1,
        "maxItems": 2,
        "maxCharactersPerItem": 44,
        "overflow": "reject"
      },
      "item": {
        "type": "string"
      }
    }
  }
}
